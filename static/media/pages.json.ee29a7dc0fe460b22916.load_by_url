a\u3063\u3066\u3044\u307e\u3059\u3002\u305d\u306e\u4e2d\u306b\u3042\u308b\u5f0f\u306f\u8a55\u4fa1\u3055\u308c\u306a\u304b\u3063\u305f\u305f\u3081\u3001\u5024\u304c\u3042\u308a\u307e\u305b\u3093\u3002</li>\n<li>\u5f0f <code>vowels</code> \u3068 <code>consonants</code> \u306b\u8a18\u9332\u3055\u308c\u3066\u3044\u308b\u5024\u306f\u3001\u3069\u306e\u67a0\u3092\u898b\u308b\u304b\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u30eb\u30fc\u30d7\u306e\u5f8c\u306e\u884c\u3067\u306f\u3059\u3079\u3066\u306e\u6587\u5b57\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u30eb\u30fc\u30d7\u306e\u4e2d\u3067\u306f\u4e00\u90e8\u3057\u304b\u542b\u307e\u308c\u3066\u304a\u3089\u305a\u3001\u5177\u4f53\u7684\u306b\u4f55\u6587\u5b57\u542b\u307e\u308c\u3066\u3044\u308b\u304b\u306f\u3001\u3069\u306e\u30a4\u30c6\u30ec\u30fc\u30b7\u30e7\u30f3\u306b\u3044\u308b\u304b\u306b\u3088\u3063\u3066\u5909\u308f\u308a\u307e\u3059\u3002</li>\n<li><code>vowels.append(letter)</code> \u3067\u306f\u3001<em>\u305d\u306e\u77ac\u9593</em> \u306e\u5909\u6570\u306e\u5024\u304c\u8868\u793a\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3064\u307e\u308a\u3001<code>letter</code> \u304c <code>vowels</code> \u306b\u8ffd\u52a0\u3055\u308c\u3088\u3046\u3068\u3057\u3066\u3044\u308b\u3068\u3053\u308d\u3067\u3059\u304c\u3001\u307e\u3060\u8ffd\u52a0\u306f\u5b8c\u4e86\u3057\u3066\u3044\u306a\u3044\u305f\u3081\u3001<code>vowels</code> \u306b\u306f\u307e\u3060 <code>letter</code> \u304c\u542b\u307e\u308c\u3066\u3044\u307e\u305b\u3093\u3002</li>\n</ol>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}, "IntroducingNestedLists": {"slug": "IntroducingNestedLists", "title": "\u30cd\u30b9\u30c8\u3057\u305f\u30ea\u30b9\u30c8\u306e\u7d39\u4ecb", "index": 38, "step_names": ["string_list_exercise", "double_subscripting", "double_subscripting_exercise", "first_nested_list_example", "triple_subscripting", "final_text"], "steps": [{"index": 0,