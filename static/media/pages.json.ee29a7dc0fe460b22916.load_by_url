nswer": null}, "requirements": null}]}, "ReturningValuesFromFunctions": {"slug": "ReturningValuesFromFunctions", "title": "\u95a2\u6570\u304b\u3089\u5024\u3092\u8fd4\u3059\uff08return\uff09", "index": 42, "step_names": ["first_return", "losing_return_value", "quadruple_exercise", "final_text"], "steps": [{"index": 0, "text": "<p>\u95a2\u6570\u306f\u3001\u5358\u306b\u753b\u9762\u306b\u51fa\u529b\u3059\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u5024\u3092 <em>\u8fd4\u3059</em>\uff08return\u3059\u308b\uff09\u3088\u3046\u306b\u3059\u308b\u3068\u3055\u3089\u306b\u4fbf\u5229\u306b\u306a\u308a\u307e\u3059\u3002\u6b21\u306e\u4f8b\u3092\u8a66\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">double</span><span class=\"p\">(</span><span class=\"n\">x</span><span class=\"p\">):</span>\n    <span class=\"k\">return</span> <span class=\"n\">x</span> <span class=\"o\">*</span> <span class=\"mi\">2</span>\n\n<span class=\"n\">number</span> <span class=\"o\">=</span> <span class=\"mi\">5</span>\n<span class=\"n\">twice</span> <span class=\"o\">=</span> <span class=\"n\">double</span><span class=\"p\">(</span><span class=\"n\">number</span><span class=\"p\">)</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">number</span><span class=\"p\">)</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">twice</span><span class=\"p\">)</span>\n</span></code></pre>", "name": "first_return", "hints": [], "solution": {"tokens": ["def", " ", "double", "(", "x", ")", ":", "\n", "    ", "return", " ", "x", " ", "*", " ", "2", "\n", "\n", "number", " ", "=", " ", "5", "\n", "twice", " ", "=", " ", "double", "(", "number", ")", "\n", "print", "(", "number", ")", "\n", "print", "(", "twice", ")"], "maskedIndices": [39, 40, 38, 15, 0, 28, 9, 2, 35, 24, 41, 36, 31, 18, 29, 30, 6, 5, 11, 13, 3, 33, 4, 34, 20, 22, 26], "mask": [true, false, true, true, true, true, true, false, false, true, false, true, false, true, false, true, false, false, true, false, true, false, true, false, true, false, true, false, true, true, true, true, false, true, true, true, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": ["5\n5", "5\n10", "10\n10", "\u30a8\u30e9\u30fc"], "answer": "5\n10"}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 1, "text": "<p>\u3053\u3053\u3067\u306f\u3001\u5909\u6570 <code>number</code>\uff08\u5024\u306f <code>5</code>\uff09\u3092\u5f15\u6570 <code>x</code> \u3068\u3057\u3066\u95a2\u6570 <code>double</code> \u306b\u6e21\u3057\u307e\u3057\u305f\u3002\u305d\u3057\u3066 <code>double</code> \u306f\n<code>x * 2</code>\u3001\u3064\u307e\u308a <code>5 * 2</code>\u3001\u3059\u306a\u308f\u3061 <code>10</code> \u3092 <em>\u8fd4\u3057</em>\uff08return\u3057\uff09\u3001\u305d\u308c\u304c\u5909\u6570 <code>twice</code> \u306e\u5024\u306b\u306a\u308a\u307e\u3057\u305f\u3002<code>double</code> \u306e\u4e2d\u306b\u3042\u308b\u7279\u5225\u306a\u30ad\u30fc\u30ef\u30fc\u30c9 <code>return</code> \u306e\u304a\u304b\u3052\u3067\u3001\n<code>double(number)</code> \u306f\u5024\u3092\u6301\u3064\u5f0f\u306b\u306a\u308a\u307e\u3059\u3002\u5177\u4f53\u7684\u306b\u306f\u3001\u8fd4\u3055\u308c\u305f\u5024\u305d\u306e\u3082\u306e\u306b\u306a\u308b\u306e\u3067\u3059\u3002\n\u53b3\u5bc6\u306b\u306f\u5c11\u3057\u9055\u3044\u307e\u3059\u304c\u3001<code>twice = double(number)</code> \u306f <code>twice = number * 2</code> \u3068\u540c\u3058\u3088\u3046\u306a\u3082\u306e\u3060\u3068\u8003\u3048\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002</p>\n<p>\u6ce8\u610f\u3057\u3066\u307b\u3057\u3044\u306e\u306f\u3001<code>double(number)</code> \u306f <em><code>number</code> \u306e\u5024\u3092\u5909\u66f4\u3057\u3066\u3044\u306a\u3044</em> \u3068\u3044\u3046\u70b9\u3067\u3059\u3002\u7d42\u308f\u3063\u305f\u5f8c\u3082\u3001<code>number</code> \u306f <code>5</code> \u306e\u307e\u307e\u3067\u3059\u306d\u3002<code>double(number)</code> \u306f\n\u65b0\u3057\u3044\u5024\u3092\u8fd4\u3057\u305f\u3060\u3051\u306a\u306e\u3067\u3059\u3002\u30d7\u30ed\u30b0\u30e9\u30e0\u304c\u305d\u306e\u8fd4\u3055\u308c\u305f\u5024\u3092\u5909\u6570\u306b\u4fdd\u5b58\u3059\u308b\u306a\u3069\u3057\u3066\u6d3b\u7528\u3059\u308b\u3053\u3068\u304c\u3068\u3066\u3082\u91cd\u8981\u3067\u3059\u3002\u3082\u3061\u308d\u3093\u3001<code>print(double(number))</code> \u306e\u3088\u3046\u306b\u3057\u3066\u3059\u3050\u306b\u8868\u793a\u3055\u305b\u3066\u3082OK\u3067\u3059\u3002\u3067\u306f\u6b21\u306b\u3001\n\u3053\u3061\u3089\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">double</span><span class=\"p\">(</span><span class=\"n\">x</span><span class=\"p\">):</span>\n    <span class=\"k\">return</span> <span class=\"n\">x</span> <span class=\"o\">*</span> <span class=\"mi\">2</span>\n\n<span class=\"n\">number</span> <span class=\"o\">=</span> <span class=\"mi\">5</span>\n<span class=\"n\">double</span><span class=\"p\">(</span><span class=\"n\">number</span><span class=\"p\">)</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">number</span><span class=\"p\">)</span>\n</span></code></pre>", "name": "losing_return_value", "hints": [], "solution": {"tokens": ["def", " ", "double", "(", "x", ")", ":", "\n", "    ", "return", " ", "x", " ", "*", " ", "2", "\n", "\n", "number", " ", "=", " ", "5", "\n", "double", "(", "number", ")", "\n", "print", "(", "number", ")"], "maskedIndices": [3, 31, 27, 2, 0, 18, 20, 25, 29, 15, 26, 24, 32, 22, 13, 6, 11, 9, 4, 30, 5], "mask": [true, false, true, true, true, true, true, false, false, true, false, true, false, true, false, true, false, false, true, false, true, false, true, false, true, true, true, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": ["5", "10", "\u30a8\u30e9\u30fc"], "answer": "5"}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 2, "text": "<p>\u3053\u3053\u3067\u3082 <code>double(number)</code> \u306f\u3061\u3083\u3093\u3068 <code>10</code> \u3092\u8fd4\u3057\u3066\u3044\u307e\u3059\u304c\u3001\u305d\u308c\u3092\u4f7f\u308f\u306a\u304b\u3063\u305f\u305f\u3081\u6d88\u3048\u3066\u3057\u307e\u3044\u307e\u3057\u305f\u3002<code>number</code> \u306f <code>5</code> \u306e\u307e\u307e\u3067\u3059\u3002</p>\n<p>1\u3064\u306e\u5f15\u6570 <code>x</code> \u3092\u53d7\u3051\u53d6\u308a\u3001\u305d\u308c\u30924\u500d\u306b\u3057\u305f\u5024\u3092\u8fd4\u3059\u95a2\u6570 <code>quadruple</code> \u3092\u66f8\u3044\u3066\u307f\u307e\u3057\u3087\u3046\u3002\n<code>quadruple</code> \u306e\u672c\u4f53\u306e\u4e2d\u3067\u306f <code>double</code> \u95a2\u6570\u3060\u3051\u3092\u4f7f\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6570\u5024\u3084\u639b\u3051\u7b97\u8a18\u53f7\u3092\u76f4\u63a5\u4f7f\u3046\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002</p>", "name": "quadruple_exercise", "hints": ["<p>4\u500d\u306b\u3059\u308b\u306b\u306f\u30012\u500d\u306b\u3059\u308b\u51e6\u7406\u30922\u56de\u884c\u3044\u307e\u3059\u3002</p>", "<p>\u3064\u307e\u308a\u3001<code>double</code> \u30922\u56de\u547c\u3073\u51fa\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u6bce\u56de\u3001<code>double</code> \u304b\u3089\u8fd4\u3055\u308c\u305f\u5024\u3092\u3057\u3063\u304b\u308a\u4f7f\u3046\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u306d\u3002</p>", "<p>\u95a2\u6570\u306e\u5b9a\u7fa9\u306b\u5fc5\u8981\u306a\u30d1\u30fc\u30c4\u304c\u3059\u3079\u3066\u63c3\u3063\u3066\u3044\u308b\u304b\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002</p>", "<p><code>def</code>\u3001<code>()</code>\u3001\u305d\u3057\u3066 <code>:</code> \u304c\u542b\u307e\u308c\u3066\u3044\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u95a2\u6570\u306e\u540d\u524d\u304c <code>quadruple</code> \u306b\u306a\u3063\u3066\u3044\u308b\u304b\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u304b\u3063\u3053 <code>()</code> \u306e\u4e2d\u306b\u3001<code>x</code> \u3068\u3044\u3046\u540d\u524d\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\uff08\u5f15\u6570\uff09\u304c1\u3064\u5165\u3063\u3066\u3044\u308b\u304b\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u95a2\u6570\u306e\u672c\u4f53\uff08\u4e2d\u8eab\uff09\u306e\u4e2d\u3067\u3001\u305d\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\u3092\u4f7f\u3063\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u95a2\u6570\u306e\u4e2d\u8eab\u304c\u3057\u3063\u304b\u308a\u30a4\u30f3\u30c7\u30f3\u30c8\uff08\u5b57\u4e0b\u3052\uff09\u3055\u308c\u3066\u3044\u308b\u304b\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u6700\u5f8c\u306b\u4f55\u304b\u3092 <code>return</code> \u3057\u3066\u3044\u308b\u304b\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002</p>", "<p><code>double</code> \u306e\u5b9a\u7fa9\u3092\u304a\u624b\u672c\u3068\u3057\u3066\u898b\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "<p><code>quadruple</code> \u306e\u95a2\u6570\u672c\u4f53\uff08\u4e2d\u8eab\uff09\u306e\u4e2d\u3067 <code>quadruple</code> \u3092\u547c\u3073\u51fa\u3057\u3066\u3057\u307e\u3063\u3066\u3044\u306a\u3044\u304b\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30a4\u30f3\u30c7\u30f3\u30c8\u3082\u30c1\u30a7\u30c3\u30af\u3057\u307e\u3057\u3087\u3046\u3002</p>"], "solution": {"tokens": ["def", " ", "quadruple", "(", "x", ")", ":", "\n", "    ", "return", " ", "double", "(", "double", "(", "x", ")", ")"], "maskedIndices": [2, 14, 16, 17, 5, 13, 9, 6, 0, 4, 11, 15, 3, 12], "mask": [true, false, true, true, true, true, true, false, false, true, false, true, true, true, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "custom", "message": "<p>\u4e0a\u3067\u8aac\u660e\u3057\u305f\u901a\u308a\u306b\u3001<code>quadruple</code> \u3068\u3044\u3046\u540d\u524d\u306e\u95a2\u6570\u3092\u5b9a\u7fa9\u3059\u308b\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u66f8\u3044\u3066\u304f\u3060\u3055\u3044\u3002</p>"}]}, {"index": 3, "text": "<p>\u3088\u304f\u3067\u304d\u307e\u3057\u305f\uff01\u8003\u3048\u3089\u308c\u308b\u89e3\u7b54\u4f8b\u30922\u3064\u7d39\u4ecb\u3057\u307e\u3059\u306d\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">quadruple</span><span class=\"p\">(</span><span class=\"n\">x</span><span class=\"p\">):</span>\n    <span class=\"n\">x</span> <span class=\"o\">=</span> <span class=\"n\">double</span><span class=\"p\">(</span><span class=\"n\">x</span><span class=\"p\">)</span>\n    <span class=\"n\">x</span> <span class=\"o\">=</span> <span class=\"n\">double</span><span class=\"p\">(</span><span class=\"n\">x</span><span class=\"p\">)</span>\n    <span class=\"k\">return</span> <span class=\"n\">x</span>\n\n<span class=\"k\">def</span> <span class=\"nf\">quadruple</span><span class=\"p\">(</span><span class=\"n\">x</span><span class=\"p\">):</span>\n    <span class=\"k\">return</span> <span class=\"n\">double</span><span class=\"p\">(</span><span class=\"n\">double</span><span class=\"p\">(</span><span class=\"n\">x</span><span class=\"p\">))</span>\n</span></code></pre>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}, "TestingFunctions": {"slug": "TestingFunctions", "title": "\u95a2\u6570\u306e\u30c6\u30b9\u30c8", "index": 43, "step_names": ["introducing_assert_equal", "make_tests_fail", "complete_quadruple_tests", "surround_exercise", "alert_exercise", "final_text"], "steps": [{"index": 0, "text": "<p>\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u66f8\u304f\u4e0a\u3067\u91cd\u8981\u306a\u3053\u3068\u306e1\u3064\u306f\u3001\u6b63\u3057\u304f\u52d5\u304f\u304b\u3069\u3046\u304b\u3092\u30c6\u30b9\u30c8\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u624b\u52d5\u3067\u884c\u3046\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\n<code>print(double(5))</code> \u304c <code>10</code> \u3092\u51fa\u529b\u3059\u308b\u304b\u78ba\u8a8d\u3059\u308b\u306a\u3069\u3067\u3059\u304c\u3001\u3053\u3046\u3044\u3046\u4f5c\u696d\u306f\u3059\u3050\u306b\u9762\u5012\u306b\u306a\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3088\u306d\u3002\n\u305d\u3053\u3067\u3001\u81ea\u5206\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u30c6\u30b9\u30c8\u3059\u308b\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u66f8\u304f\u3068\u4fbf\u5229\u3067\u3059\u3002\u3053\u308c\u306f <em>automated testing</em>\uff08\u81ea\u52d5\u30c6\u30b9\u30c8\uff09\u3068\u547c\u3070\u308c\u3001\n\u305d\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u306f <em>tests</em>\uff08\u30c6\u30b9\u30c8\uff09\u3068\u547c\u3070\u308c\u307e\u3059\u3002</p>\n<p>\u30c6\u30b9\u30c8\u3092\u66f8\u304f\u306e\u306b\u5f79\u7acb\u3064\u3001\u30b7\u30f3\u30d7\u30eb\u306a\u95a2\u6570 <code>assert_equal</code> \u3092\u7d39\u4ecb\u3057\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">actual</span><span class=\"p\">,</span> <span class=\"n\">expected</span><span class=\"p\">):</span>\n    <span class=\"k\">if</span> <span class=\"n\">actual</span> <span class=\"o\">==</span> <span class=\"n\">expected</span><span class=\"p\">:</span>\n        <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s2\">\"OK\"</span><span class=\"p\">)</span>\n    <span class=\"k\">else</span><span class=\"p\">:</span>\n        <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"Error! </span><span class=\"si\">{</span><span class=\"nb\">repr</span><span class=\"p\">(</span><span class=\"n\">actual</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\"> != </span><span class=\"si\">{</span><span class=\"nb\">repr</span><span class=\"p\">(</span><span class=\"n\">expected</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\uff08<code>repr</code> \u3068\u3044\u3046\u95a2\u6570\u306f\u4f55\u3067\u3057\u3087\u3046\uff1f <code>print(f\"{'abc'} {repr('abc')}\")</code> \u3092\u5b9f\u884c\u3057\u3066\u9055\u3044\u30921\u3064\u78ba\u304b\u3081\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u3067\u3082\u3001\u3042\u307e\u308a\u6c17\u306b\u3057\u3059\u304e\u306a\u304f\u3066\u3082\u5927\u4e08\u592b\u3067\u3059\u3088\u3002\uff09</p>\n<p>\u3053\u308c\u306f Python \u306e\u6a19\u6e96\u6a5f\u80fd\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304c\uff08\u4f3c\u305f\u3088\u3046\u306a\u95a2\u6570\u306f\u3042\u308a\u307e\u3059\uff09\u3001\u3044\u3064\u3067\u3082\u4f7f\u3048\u308b\u3088\u3046\u306b\u3053\u306e\u5b66\u7fd2\u74b0\u5883\u306b\u8ffd\u52a0\u3057\u3066\u304a\u304d\u307e\u3057\u305f\u3002\n\u4f7f\u3063\u3066\u307f\u308b\u305f\u3081\u306e\u4f8b\u3092\u7528\u610f\u3057\u305f\u306e\u3067\u3001\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">double</span><span class=\"p\">(</span><span class=\"n\">x</span><span class=\"p\">):</span>\n    <span class=\"k\">return</span> <span class=\"n\">x</span> <span class=\"o\">*</span> <span class=\"mi\">2</span>\n\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">double</span><span class=\"p\">(</span><span class=\"mi\">2</span><span class=\"p\">),</span> <span class=\"mi\">4</span><span class=\"p\">)</span>\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">double</span><span class=\"p\">(</span><span class=\"mi\">5</span><span class=\"p\">),</span> <span class=\"mi\">10</span><span class=\"p\">)</span>\n</span></code></pre>", "name": "introducing_assert_equal", "hints": [], "solution": {"tokens": ["def", " ", "double", "(", "x", ")", ":", "\n", "    ", "return", " ", "x", " ", "*", " ", "2", "