"n\">words</span><span class=\"p\">)</span> <span class=\"o\">-</span> <span class=\"mi\">2</span><span class=\"p\">,</span> <span class=\"nb\">len</span><span class=\"p\">(</span><span class=\"n\">words</span><span class=\"p\">)</span> <span class=\"o\">-</span> <span class=\"mi\">1</span><span class=\"p\">]</span>\n</span></code></pre>\n<p>\u3053\u308c\u3067\u3001\u3055\u304d\u307b\u3069\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u3069\u3093\u306a\u30ea\u30b9\u30c8\u3067\u3082\u52d5\u304f\u3088\u3046\u306b\u76f4\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002<code>...</code> \u306e\u90e8\u5206\u3092\u57cb\u3081\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"n\">words</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"s1\">'This'</span><span class=\"p\">,</span> <span class=\"s1\">'is'</span><span class=\"p\">,</span> <span class=\"s1\">'a'</span><span class=\"p\">,</span> <span class=\"s1\">'list'</span><span class=\"p\">]</span>\n\n<span class=\"k\">for</span> <span class=\"n\">index</span> <span class=\"ow\">in</span> <span class=\"o\">...</span><span class=\"p\">:</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">index</span><span class=\"p\">)</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">words</span><span class=\"p\">[</span><span class=\"n\">index</span><span class=\"p\">])</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p>\u4e0e\u3048\u3089\u308c\u305f <code>words</code> \u306e\u4f8b\u3067\u306f\u3001\u6b21\u306e\u3088\u3046\u306b\u51fa\u529b\u3055\u308c\u308b\u306f\u305a\u3067\u3059\uff1a</p>\n<pre><code>0\nThis\n1\nis\n2\na\n3\nlist\n</code></pre>", "name": "print_indices_and_words", "hints": ["<p>\u3055\u304d\u307b\u3069 <code>range(4)</code> \u3092\u4f7f\u3063\u305f\u3053\u3068\u3092\u601d\u3044\u51fa\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u4eca\u56de\u306f\u3001\u3069\u3093\u306a\u30ea\u30b9\u30c8\u3067\u3082\u52d5\u304f\u3088\u3046\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30ea\u30b9\u30c8\u306b\u8981\u7d20\u304c5\u3064\u3042\u3063\u305f\u308a\u300110\u500b\u3042\u3063\u305f\u308a\u3057\u305f\u3089\u3069\u3046\u306a\u308b\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u5b66\u3093\u30602\u3064\u306e\u95a2\u6570\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u307f\u307e\u3057\u3087\u3046\uff01</p>"], "solution": {"tokens": ["for", " ", "index", " ", "in", " ", "range", "(", "len", "(", "words", ")", ")", ":", "\n", "    ", "print", "(", "index", ")", "\n", "    ", "print", "(", "words", "[", "index", "]", ")"], "maskedIndices": [13, 23, 22, 10, 16, 4, 8, 17, 12, 24, 6, 27, 0, 19, 2, 9, 18, 25, 28, 11, 7, 26], "mask": [true, false, true, false, true, false, true, true, true, true, true, true, true, true, false, false, true, true, true, true, false, false, true, true, true, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "exercise"}, {"type": "non_function_exercise", "inputs": "<pre><code class=\"codehilite\"><span><span class=\"n\">words</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"s1\">'Python'</span><span class=\"p\">]</span>\n</span></code></pre>"}]}, {"index": 11, "text": "<p>\u3082\u3057 <code>range</code> \u3084 <code>len</code> \u306b\u307e\u3060\u3042\u307e\u308a\u6163\u308c\u3066\u3044\u306a\u3044\u306a\u3089\u3001\u5c11\u3057\u7df4\u7fd2\u3057\u3066\u8a66\u884c\u932f\u8aa4\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u306d\u3002\n\u81ea\u5206\u3067\u6311\u6226\u3067\u304d\u308b\u7c21\u5358\u306a\u7df4\u7fd2\u554f\u984c\u3092\u3044\u304f\u3064\u304b\u7d39\u4ecb\u3057\u307e\u3059\u3002</p>\n<ul>\n<li><code>1</code> \u304b\u3089 <code>100</code> \u307e\u3067\u306e\u6570\u5b57\u3092\u51fa\u529b\u3059\u308b\uff08100\u3092\u542b\u307f\u307e\u3059\uff09\u3002</li>\n<li>\u81ea\u5206\u306e\u540d\u524d\u3092100\u56de\u51fa\u529b\u3059\u308b\u3002</li>\n<li>\u30ea\u30b9\u30c8 <code>words</code> \u306e\u6700\u5f8c\u306e\u5358\u8a9e\u4ee5\u5916\u306e\u3059\u3079\u3066\u306e\u5358\u8a9e\u3092\u51fa\u529b\u3059\u308b\u3002</li>\n<li><code>words</code> \u306e\u5404\u5358\u8a9e\u3092\u9006\u9806\u306b\u51fa\u529b\u3059\u308b\uff08\u6700\u5f8c\u306e\u5358\u8a9e\u3001\u6700\u5f8c\u304b\u30892\u756a\u76ee\u306e\u5358\u8a9e\u3001... \u306e\u9806\u306b\u51fa\u529b\u3057\u307e\u3059\uff09\u3002</li>\n<li>\u89e3\u3051\u305f\u304b\u3069\u3046\u304b\u306b\u304b\u304b\u308f\u3089\u305a\u3001<a href=\"#IntroducingLists\">\u30ea\u30b9\u30c8\u306e\u5c0e\u5165\u30da\u30fc\u30b8</a>\u306e\u6700\u5f8c\u306b\u3042\u308b\u30dc\u30fc\u30ca\u30b9\u554f\u984c\u306b\n\u3082\u3046\u4e00\u5ea6\u6311\u6226\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002<code>range</code> \u3068 <code>len</code> \u3092\u4f7f\u3048\u3070\u3001\u305a\u3063\u3068\u7c21\u5358\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3088\uff01</li>\n</ul>\n<p>\u6e96\u5099\u304c\u3067\u304d\u305f\u3089\u3001\u6b21\u306e\u30da\u30fc\u30b8\u306b\u9032\u3093\u3067\u5c11\u3057\u96e3\u3057\u3044\u5185\u5bb9\u306b\u30c1\u30e3\u30ec\u30f3\u30b8\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}, "GettingElementsAtPositionExercises": {"slug": "GettingElementsAtPositionExercises", "title": "<code>range()</code> \u3068 <code>len()</code> \u3092\u4f7f\u3063\u305f\u7df4\u7fd2\u554f\u984c", "index": 25, "step_names": ["index_exercise", "zip_exercise", "zip_longest_exercise", "final_text"], "steps": [{"index": 0, "text": "<p>\u30ea\u30b9\u30c8 <code>things</code> \u3068\u5024 <code>to_find</code> \u304c\u4e0e\u3048\u3089\u308c\u305f\u3068\u304d\u3001\n\u30ea\u30b9\u30c8\u5185\u3067 <code>to_find</code> \u304c\u6700\u521d\u306b\u51fa\u3066\u304f\u308b\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u3092\u51fa\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3064\u307e\u308a\u3001<code>things[i]</code> \u304c <code>to_find</code> \u3068\u7b49\u3057\u304f\u306a\u308b\u6700\u5c0f\u306e\u6570\u5024 <code>i</code> \u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u6b21\u306e\u3088\u3046\u306a\u5834\u5408\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">things</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"s1\">'on'</span><span class=\"p\">,</span> <span class=\"s1\">'the'</span><span class=\"p\">,</span> <span class=\"s1\">'way'</span><span class=\"p\">,</span> <span class=\"s1\">'to'</span><span class=\"p\">,</span> <span class=\"s1\">'the'</span><span class=\"p\">,</span> <span class=\"s1\">'store'</span><span class=\"p\">]</span>\n<span class=\"n\">to_find</span> <span class=\"o\">=</span> <span class=\"s1\">'the'</span>\n</span></code></pre>\n<p>\u30d7\u30ed\u30b0\u30e9\u30e0\u306f <code>1</code> \u3092\u51fa\u529b\u3059\u308b\u306f\u305a\u3067\u3059\u3002</p>\n<p><code>to_find</code> \u306f\u5fc5\u305a1\u56de\u4ee5\u4e0a\u73fe\u308c\u308b\u3068\u4eee\u5b9a\u3057\u3066\u69cb\u3044\u307e\u305b\u3093\u3002</p>", "name": "index_exercise", "hints": ["<p><code>things</code> \u306e\u3059\u3079\u3066\u306e\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u3092\u9806\u756a\u306b\u898b\u3066\u3044\u3063\u3066\u3001\u3069\u308c\u304c\u7b54\u3048\u304b\u30c1\u30a7\u30c3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u3088\u3002</p>", "<p>\u3059\u3079\u3066\u306e\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u3092\u9806\u756a\u306b\u898b\u308b\u306b\u306f\u3001<code>range(len(things))</code> \u3092\u4f7f\u3063\u305f\u30eb\u30fc\u30d7\u304c\u5fc5\u8981\u3060\u306d\u3002</p>", "<p>\u3042\u308b\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u304c\u7b54\u3048\u304b\u3069\u3046\u304b\u3092\u5224\u5b9a\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u3082\u306e\u3092\u4f7f\u3046\u3088\uff1a</p>", "<ul>\n<li><code>if</code></li>\n</ul>", "<ul>\n<li>\u6dfb\u5b57\uff08subscript\uff09\u3068\u3057\u3066\u306e\u30a4\u30f3\u30c7\u30c3\u30af\u30b9</li>\n</ul>", "<ul>\n<li><code>==</code></li>\n</ul>", "<p>\u63a2\u3057\u3066\u3044\u308b\u306e\u306f\u300c\u6700\u521d\u306e\u300d\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u3060\u304b\u3089\u3001\u898b\u3064\u304b\u3063\u305f\u3089\u30eb\u30fc\u30d7\u3092\u6b62\u3081\u308b\u5fc5\u8981\u304c\u3042\u308b\u3088\u3002</p>", "<p>\u30eb\u30fc\u30d7\u3092\u9014\u4e2d\u3067\u6b62\u3081\u308b\u65b9\u6cd5\u306f\u3001\u6700\u8fd1\u7fd2\u3063\u305f\u3088\u306d\u3002</p>", "<p><code>break</code> \u3092\u4f7f\u3046\u5fc5\u8981\u304c\u3042\u308b\u3088\u3002</p>"], "solution": {"tokens": ["for", " ", "i", " ", "in", " ", "range", "(", "len", "(", "things", ")", ")", ":", "\n", "    ", "if", " ", "to_find", " ", "==", " ", "things", "[", "i", "]", ":", "\n", "        ", "print", "(", "i", ")", "\n", "        ", "break"], "maskedIndices": [6, 20, 31, 11, 25, 29, 26, 23, 32, 24, 2, 8, 7, 35, 10, 18, 30, 13, 9, 12, 22, 4, 16, 0], "mask": [true, false, true, false, true, false, true, true, true, true, true, true, true, true, false, false, true, false, true, false, true, false, true, true, true, true, true, false, false, true, true, true, true, false, false, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "exercise"}, {"type": "non_function_exercise", "inputs": "<pre><code class=\"codehilite\"><span><span class=\"n\">things</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"s1\">'on'</span><span class=\"p\">,</span> <span class=\"s1\">'the'</span><span class=\"p\">,</span> <span class=\"s1\">'way'</span><span class=\"p\">,</span> <span class=\"s1\">'to'</span><span class=\"p\">,</span> <span class=\"s1\">'the'</span><span class=\"p\">,</span> <span class=\"s1\">'store'</span><span class=\"p\">]</span>\n<span class=\"n\">to_find</span> <span class=\"o\">=</span> <span class=\"s1\">'the'</span>\n</span></code></pre>"}]}, {"index": 1, "text": "<p>\u3044\u3044\u306d\uff01</p>\n<p>\u3068\u3053\u308d\u3067\u3001\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u6307\u5b9a\u3084 <code>len()</code> \u306f\u6587\u5b57\u5217\u306b\u5bfe\u3057\u3066\u3082\u4f7f\u3048\u308b\u3093\u3060\u3002\u30b7\u30a7\u30eb\u3067\u8a66\u3057\u3066\u307f\u3066\u306d\u3002</p>\n<p>\u305d\u308c\u3067\u306f\u6b21\u306e\u7df4\u7fd2\u554f\u984c\u3067\u3059\u3002\u540c\u3058\u9577\u3055\u306e2\u3064\u306e\u6587\u5b57\u5217\u3001\u4f8b\u3048\u3070\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">string1</span> <span class=\"o\">=</span> <span class=\"s1\">'Hello'</span>\n<span class=\"n\">string2</span> <span class=\"o\">=</span> <span class=\"s1\">'World'</span>\n</span></code></pre>\n<p>\u304c\u4e0e\u3048\u3089\u308c\u305f\u3068\u304d\u3001\u5404\u6587\u5b57\u306e\u9593\u306b\u30b9\u30da\u30fc\u30b9\u3092\u7a7a\u3051\u3066\u3001\u7e26\u306b\u4e26\u3079\u3066\u51fa\u529b\u3057\u3066\u304f\u3060\u3055\u3044\uff1a</p>\n<pre><code>H W\ne o\nl r\nl l\no d\n</code></pre>", "name": "zip_exercise", "hints": ["<p>\u30b7\u30a7\u30eb\u3067\u6587\u5b57\u5217\u306b\u5bfe\u3059\u308b\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u6307\u5b9a\u3084 <code>len()</code> \u3092\u8a66\u3057\u3066\u307f\u305f\u304b\u306a\uff1f</p>", "<p>\u30eb\u30fc\u30d7\u306e\u3053\u3068\u306f\u4e00\u65e6\u5fd8\u308c\u3066\u307f\u3088\u3046\u30022\u3064\u306e\u6587\u5b57\u5217\u306e\u305d\u308c\u305e\u308c\u306e\u6700\u521d\u306e\u6587\u5b57\u304c\u5165\u3063\u305f1\u884c\u76ee\u3060\u3051\u3092\u51fa\u529b\u3059\u308b\u306b\u306f\u3001\u3069\u3046\u66f8\u3051\u3070\u3044\u3044\u304b\u306a\uff1f</p>", "<p>2\u884c\u76ee\u306b\u306f\u305d\u308c\u305e\u308c\u306e\u6587\u5b57\u5217\u306e2\u756a\u76ee\u306e\u6587\u5b57\u3092\u51fa\u529b\u3057\u3066\u3001\u305d\u306e\u5148\u3082\u540c\u69d8\u306b\u7d9a\u3051\u305f\u3044\u3088\u306d\u3002</p>", "<p><code>for</code> \u30eb\u30fc\u30d7\u304c\u5fc5\u8981\u306b\u306a\u308b\u3088\u3002</p>", "<p>\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u6307\u5b9a\uff08\u6dfb\u5b57\u8868\u8a18\uff09\u304c\u5fc5\u8981\u306b\u306a\u308b\u3088\u3002</p>", "<p><code>range</code> \u304c\u5fc5\u8981\u306b\u306a\u308b\u3088\u3002</p>", "<p><code>len</code> \u304c\u5fc5\u8981\u306b\u306a\u308b\u3088\u3002</p>", "<p><code>+</code> \u304c\u5fc5\u8981\u306b\u306a\u308b\u3088\u3002</p>", "<p>\u4e21\u65b9\u306e\u6587\u5b57\u5217\u304b\u3089\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u3092\u4f7f\u3063\u3066\u6587\u5b57\u3092\u53d6\u308a\u51fa\u3059\u5fc5\u8981\u304c\u3042\u308b\u3088\u3002</p>", "<p>\u5bfe\u5fdc\u3059\u308b\u6587\u5b57\u3092\u53d6\u308a\u51fa\u3059\u305f\u3081\u306b\u3001\u6bce\u56de\u4e21\u65b9\u306e\u6587\u5b57\u5217\u306b\u540c\u3058\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u3092\u6e21\u3059\u5fc5\u8981\u304c\u3042\u308b\u3088\u3002</p>"], "solution": {"tokens": ["for", " ", "i", " ", "in", " ", "range", "(", "len", "(", "string1", ")", ")", ":", "\n", "    ", "char1", " ", "=", " ", "string1", "[", "i", "]", "\n", "    ", "char2", " ", "=", " ", "string2", "[", "i", "]", "\n", "    ", "print", "(", "char1", " ", "+", " ", "' '", " ", "+", " ", "char2", ")"], "maskedIndices": [18, 13, 8, 6, 22, 9, 16, 30, 4, 2, 20, 33, 37, 10, 26, 23, 21, 12, 31, 44, 7, 42, 0, 32, 46, 47, 28, 40, 11, 38, 36], "mask": [true, false, true, false, true, false, true, true, true, true, true, true, true, true, false, false, true, false, true, false, true, true, true, true, false, false, true, false, true, false, true, true, true, true, false, false, true, true, true, false, true, false, true, false, true, false, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "exercise"}, {"type": "non_function_exercise", "inputs": "<pre><code class=\"codehilite\"><span><span class=\"n\">string1</span> <span class=\"o\">=</span> <span class=\"s1\">'Hello'</span>\n<span class=\"n\">string2</span> <span class=\"o\">=</span> <span class=\"s1\">'World'</span>\n</span></code></pre>"}]}, {"index": 2, "text": "<p>\u3059\u3