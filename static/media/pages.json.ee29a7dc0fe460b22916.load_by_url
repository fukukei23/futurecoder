8\u3001\u3064\u307e\u308a\u30ad\u30fc\u3068\u5024\u306e\u30da\u30a2\u304c1\u3064\u3082\u306a\u3044\u8f9e\u66f8\u3092\u610f\u5473\u3059\u308b\u3053\u3068\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u3053\u308c\u306f\u3001<code>[]</code> \u304c\u7a7a\u306e\u30ea\u30b9\u30c8\u3092\u8868\u3057\u305f\u308a\u3001<code>\"\"</code> \u304c\u7a7a\u306e\u6587\u5b57\u5217\u3092\u8868\u3057\u305f\u308a\u3059\u308b\u306e\u3068\u540c\u3058\u3067\u3059\u306d\u3002</p>", "name": "dict_assignment_valid", "hints": [], "solution": {"tokens": ["quantities", " ", "=", " ", "{", "}", "\n", "quantities", "[", "'dog'", "]", " ", "=", " ", "500", "\n", "quantities", "[", "'box'", "]", " ", "=", " ", "2", "\n", "print", "(", "quantities", ")"], "maskedIndices": [7, 9, 2, 16, 25, 17, 21, 27, 14, 28, 18, 0, 5, 8, 4, 26, 23, 10, 12, 19], "mask": [true, false, true, false, true, true, false, true, true, true, true, false, true, false, true, false, true, true, true, true, false, true, false, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": ["{'dog': 500, 'box': 2}", "{'dog': 2, 'box': 500}", "{2: 'dog', 500: 'box'}", "{500: 'dog', 2: 'box'}", "\u30a8\u30e9\u30fc"], "answer": "{'dog': 500, 'box': 2}"}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 4, "text": "<p>\u307e\u3055\u306b\u3053\u308c\u304c\u5fc5\u8981\u3060\u3063\u305f\u3053\u3068\u3067\u3059\uff01 \u304a\u5ba2\u3055\u3093\u304c\u72ac\u3092500\u5339\u6b32\u3057\u3044\u3068\u8a00\u304a\u3046\u304c\u3001500\u4e07\u5339\u6b32\u3057\u3044\u3068\u8a00\u304a\u3046\u304c\u3001\n\u305d\u306e\u60c5\u5831\u3092\u76f4\u63a5\u8f9e\u66f8\u306b\u5165\u308c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u306d\u3002\u305d\u3053\u3067\u7df4\u7fd2\u3068\u3057\u3066\u3001\u3053\u308c\u3092\u6c4e\u7528\u7684\u306b\u4f7f\u3048\u308b\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u4f5c\u3063\u3066\u307f\u307e\u3057\u3087\u3046\u3002\n<code>quantities</code> \u8f9e\u66f8\u306b\u65b0\u3057\u3044\u30ad\u30fc\u3068\u5024\u306e\u30da\u30a2\u3092\u8ffd\u52a0\u3059\u308b\u95a2\u6570 <code>buy_quantity(quantities, item, quantity)</code> \u3092\u66f8\u3044\u3066\u304f\u3060\u3055\u3044\u3002\n\u3053\u3061\u3089\u304c\u30d9\u30fc\u30b9\u3068\u306a\u308b\u30b3\u30fc\u30c9\u3067\u3059\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"k\">def</span> <span class=\"nf\">buy_quantity</span><span class=\"p\">(</span><span class=\"n\">quantities</span><span class=\"p\">,</span> <span class=\"n\">item</span><span class=\"p\">,</span> <span class=\"n\">quantity</span><span class=\"p\">):</span>\n    <span class=\"o\">...</span>\n\n<span class=\"k\">def</span> <span class=\"nf\">test</span><span class=\"p\">():</span>\n    <span class=\"n\">quantities</span> <span class=\"o\">=</span> <span class=\"p\">{}</span>\n    <span class=\"n\">buy_quantity</span><span class=\"p\">(</span><span class=\"n\">quantities</span><span class=\"p\">,</span> <span class=\"s1\">'dog'</span><span class=\"p\">,</span> <span class=\"mi\">500</span><span class=\"p\">)</span>\n    <span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">quantities</span><span class=\"p\">,</span> <span class=\"p\">{</span><span class=\"s1\">'dog'</span><span class=\"p\">:</span> <span class=\"mi\">500</span><span class=\"p\">})</span>\n    <span class=\"n\">buy_quantity</span><span class=\"p\">(</span><span class=\"n\">quantities</span><span class=\"p\">,</span> <span class=\"s1\">'box'</span><span class=\"p\">,</span> <span class=\"mi\">2</span><span class=\"p\">)</span>\n    <span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">quantities</span><span class=\"p\">,</span> <span class=\"p\">{</span><span class=\"s1\">'dog'</span><span class=\"p\">:</span> <span class=\"mi\">500</span><span class=\"p\">,</span> <span class=\"s1\">'box'</span><span class=\"p\">:</span> <span class=\"mi\">2</span><span class=\"p\">})</span>\n\n<span class=\"n\">test</span><span class=\"p\">()</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p><code>buy_quantity</code> \u306f\u6e21\u3055\u308c\u305f\u8f9e\u66f8\u3092\u300c\u5909\u66f4\uff08<em>modify</em>\uff09\u300d\u3059\u308b\u3082\u306e\u3067\u3042\u308a\u3001\u4f55\u3082 <code>return</code> \u3057\u305f\u308a <code>print</code> \u3057\u305f\u308a\u3059\u308b\u5fc5\u8981\u306f\u306a\u3044\u70b9\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n<code>item</code> \u306f\u307e\u3060 <code>quantities</code> \u306b\u5165\u3063\u3066\u3044\u306a\u3044\u3068\u8003\u3048\u3066\u69cb\u3044\u307e\u305b\u3093\u3002</p>", "name": "buy_quantity_exercise", "hints": ["<p><code>buy_quantity</code> \u306e\u4e2d\u8eab\uff08\u672c\u4f53\uff09\u306b\u5fc5\u8981\u306a\u306e\u306f\u3001\u305f\u3063\u305f1\u884c\u306e\u30b7\u30f3\u30d7\u30eb\u306a\u30b3\u30fc\u30c9\u3067\u3059\u3002</p>", "<p>\u524d\u306e\u30b9\u30c6\u30c3\u30d7\u306b\u3042\u3063\u305f\u30b3\u30fc\u30c9\u306e\u884c\u3068\u4f3c\u3066\u3044\u307e\u3059\u304c\u3001\u56fa\u5b9a\u306e\u5024\uff08\u30cf\u30fc\u30c9\u30b3\u30fc\u30c9\u3055\u308c\u305f\u5024\uff09\u306e\u4ee3\u308f\u308a\u306b\u5909\u6570\u3092\u4f7f\u3044\u307e\u3059\u3002</p>", "<p>\u30af\u30a9\u30fc\u30c6\u30fc\u30b7\u30e7\u30f3\uff08\u5f15\u7528\u7b26\uff09\u306e\u4f7f\u3044\u65b9\u306b\u6c17\u3092\u3064\u3051\u307e\u3057\u3087\u3046\uff01</p>", "<p><code>'dog'</code> \u306f\u3001<code>item</code> \u306b\u5165\u308b\u5024\u306e\u4e00\u4f8b\u3067\u3059\u3002</p>", "<p>\u3067\u306f\u3001<code>quantity</code> \u306b\u5165\u308b\u5024\u306e\u4f8b\u306f\u4f55\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u3055\u3063\u304d\u306e <code>'dog'</code> \u306e\u5834\u5408\u306f\u3001<code>500</code> \u3067\u3057\u305f\u306d\u3002</p>", "<p><code>quantities['dog'] = 500</code> \u3092\u3001\u3069\u3093\u306a\u5024\u3067\u3082\u4f7f\u3048\u308b\u6c4e\u7528\u7684\u306a\u5f62\u306b\u3057\u307e\u3059\u3002</p>", "<p><code>quantities</code> \u306e\u90e8\u5206\u306f\u305d\u306e\u307e\u307e\u4f7f\u3063\u3066\u5927\u4e08\u592b\u3067\u3059\u3002</p>", "<p><code>[]</code> \u3068 <code>=</code> \u3082\u305d\u306e\u307e\u307e\u4f7f\u3044\u307e\u3059\u3002</p>", "<p><code>item</code> \u306f\u5909\u6570\u3067\u3001<code>'item'</code> \u306f\u6587\u5b57\u5217\u30ea\u30c6\u30e9\u30eb\uff08\u6587\u5b57\u5217\u305d\u306e\u3082\u306e\uff09\u3060\u3068\u3044\u3046\u3053\u3068\u3092\u601d\u3044\u51fa\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p><code>'dog'</code> \u3092 <code>item</code> \u306b\u7f6e\u304d\u63db\u3048\u307e\u3059\u3002</p>", "<p><code>500</code> \u3092 <code>quantity</code> \u306b\u7f6e\u304d\u63db\u3048\u307e\u3059\u3002</p>", "<p><code>'item'</code> \u3084 <code>'quantity'</code> \u306e\u3088\u3046\u306b\u30af\u30a9\u30fc\u30c6\u30fc\u30b7\u30e7\u30f3\u3067\u56f2\u3080\u306e\u3067\u306f\u306a\u304f\u3001\u5909\u6570 <code>item</code> \u3068 <code>quantity</code> \u3092\u76f4\u63a5\u4f7f\u3063\u3066\u304f\u3060\u3055\u3044\u3002</p>"], "solution": {"tokens": ["def", " ", "buy_quantity", "(", "quantities", ",", " ", "item", ",", " ", "quantity", ")", ":", "\n", "    ", "quantities", "[", "item", "]", " ", "=", " ", "quantity"], "maskedIndices": [4, 5, 8, 20, 15, 3, 7, 2, 12, 11, 17, 18, 22, 16, 10, 0], "mask": [true, false, true, true, true, true, false, true, true, false, true, true, true, false, false, true, true, true, true, false, true, false, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "exercise"}, {"type": "function_exercise", "header": "<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">buy_quantity</span><span class=\"p\">(</span><span class=\"n\">quantities</span><span class=\"p\">,</span> <span class=\"n\">item</span><span class=\"p\">,</span> <span class=\"n\">quantity</span><span class=\"p\">):</span>\n</span></code></pre>"}, {"type": "custom", "message": "<p>\u95a2\u6570\u306f\u5f15\u6570 <code>quantities</code> \u3092\u5909\u66f4\u3059\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f55\u3082 <code>return</code> \u3057\u305f\u308a <code>print</code> \u3057\u305f\u308a\u3059\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u3002</p>"}]}, {"index": 5, "text": "<p>\u3088\u304f\u3067\u304d\u307e\u3057\u305f\uff01 \u5b9f\u969b\u306b\u5bfe\u8a71\u578b\u3067\u8a66\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"k\">def</span> <span class=\"nf\">buy_quantity</span><span class=\"p\">(</span><span class=\"n\">quantities</span><span class=\"p\">,</span> <span class=\"n\">item</span><span class=\"p\">,</span> <span class=\"n\">quantity</span><span class=\"p\">):</span>\n    <span class=\"n\">quantities</span><span class=\"p\">[</span><span class=\"n\">item</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">quantity</span>\n\n<span class=\"k\">def</span> <span class=\"nf\">test</span><span class=\"p\">():</span>\n    <span class=\"n\">quantities</span> <span class=\"o\">=</span> <span class=\"p\">{}</span>\n    <span class=\"k\">for</span> <span class=\"n\">_</span> <span class=\"ow\">in</span> <span class=\"nb\">range</span><span class=\"p\">(</span><span class=\"mi\">3</span><span class=\"p\">):</span>\n        <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s1\">'What would you like to buy?'</span><span class=\"p\">)</span>\n        <span class=\"n\">item</span> <span class=\"o\">=</span> <span class=\"nb\">input</span><span class=\"p\">()</span>\n\n        <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s1\">'How many?'</span><span class=\"p\">)</span>\n        <span class=\"n\">quantity</span> <span class=\"o\">=</span> <span class=\"nb\">int</span><span class=\"p\">(</span><span class=\"nb\">input</span><span class=\"p\">())</span>\n\n        <span class=\"n\">buy_quantity</span><span class=\"p\">(</span><span class=\"n\">quantities</span><span class=\"p\">,</span> <span class=\"n\">item</span><span class=\"p\">,</span> <span class=\"n\">quantity</span><span class=\"p\">)</span>\n\n        <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s2\">\"OK, here's your cart so far:\"</span><span class=\"p\">)</span>\n        <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">quantities</span><span class=\"p\">)</span>\n\n<span class=\"n\">test</span><span class=\"p\">()</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p><code>int(input())</code> \u306e\u90e8\u5206\u306b\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002<code>input()</code> \u306f\u6587\u5b57\u5217\u3092\u8fd4\u3057\u307e\u3059\u304c\u3001<code>quantity</code>\uff08\u6570\u91cf\uff09\u306f\u6574\u6570\n\uff08\u5c0f\u6570\u70b9\u306e\u306a\u3044\u6570\uff09\u3067\u3042\u308b\u5fc5\u8981\u304c\u3042\u308b\u305f\u3081\u3067\u3059\u3002\u6570\u5b57\u4ee5\u5916\u3092\u5165\u529b\u3059\u308b\u3068\u30a8\u30e9\u30fc\u306b\u306a\u308a\u307e\u3059\u304c\u3001\u4eca\u306e\u3068\u3053\u308d\u306f\u305d\u308c\u3067\u5927\u4e08\u592b\u3067\u3059\u3002</p>", "name": "buy_quantity_input_test", "hints": [], "solution": {"tokens": ["def", " ", "buy_quantity", "(", "quantities", ",", " ", "item", ",", " ", "quantity", ")", ":", "\n", "    ", "quantities", "[", "item", "]", " ", "=", " ", "quantity", "\n", "\n", "def", " ", "test", "(", ")", ":", "\n", "    ", "quantities", " ", "=", " ", "{", "}", "\n", "    ", "for", " ", "_", " ", "in", " ", "range", "(", "3", ")", ":", "\n", "        ", "print", "(", "'What would you like to buy?'", ")", "\n", "        ", "item", " ", "=", " ", "input", "(", ")", "\n", "\n", "        ", "print", "(", "'How many?'", ")", "\n", "        ", "quantity", " ", "=", " ", "int", "(", "input", "(", ")", ")", "\n", "\n", "        ", "buy_quantity", "(", "quantities", ",", " ", "item", ",", " ", "quantity", ")", "\n", "\n", "        ", "print", "(", "\"OK, here's your cart so far:\"", ")", "\n", "        ", "print", "(", "quantities", ")", "\n", "\n", "test", "(", ")"], "maskedIndices": [22, 108, 33, 55, 95, 89, 111, 35, 4, 110, 94, 71, 78, 54, 76, 65, 73, 37, 66, 15, 11, 60, 57, 49, 102, 38, 85, 82, 7, 84, 20, 51, 109, 17, 83, 12, 115, 103, 25, 2, 29, 56, 28, 97, 50, 64, 3, 62, 98, 80, 8, 72, 43, 45, 47, 41, 104, 5, 90, 70, 10, 92, 116, 18, 16, 48, 81, 114, 27, 30, 105, 0, 91], "mask": [true, false, true, true, true, true, false, true, true, false, true, true, true, false, false, true, true, true, true, false, true, false, true, false, false, true, false, true, true, true, true, false, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, true, true, true, false, false, true, true, true, true, false, false, true, false, true, false, true, true, true, false, false, false, true, true, true, true, false, false, true, false, true, false, true, true, true, true, true, true, false, false, false, true, true, true, true, false, true, true, false, true, true, false, false, false, true, true, true, true, false, false, true, true, true, true, false, false, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 6, "text": "<p>\u304a\u8cb7\u3044\u4e0a\u3052\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01\u305d\u308c\u305e\u308c\u306e\u5546\u54c1\u306b\u3044\u304f\u3089\u4f7f\u3063\u305f\u304b\u3092\u898b\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>\n<p>\u524d\u306b\u306f\u3001\u30ab\u30fc\u30c8\u306b\u5165\u3063\u3066\u3044\u308b\u5168\u5546\u54c1\u306e\u7dcf\u5408\u8a08\u30921\u3064\u306e\u6570\u5024\u3068\u3057\u3066\u8fd4\u3059\u95a2\u6570 <code>total_cost(quantities, prices)</code> \u3092\u5b9a\u7fa9\u3057\u307e\u3057\u305f\u306d\u3002\n\u4eca\u5ea6\u306f\u3001\u5546\u54c1\u3054\u3068\u306e\u5408\u8a08\u91d1\u984d\u304c\u5165\u3063\u305f\u65b0\u3057\u3044\u8f9e\u66f8\u3092\u8fd4\u3059\u95a2\u6570 <code>total_cost_per_item(quantities, prices)</code> \u3092\n\u4f5c\u3063\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"k\">def</span> <span class=\"nf\">total_cost_per_item</span><span class=\"p\">(</span><span class=\"n\">quantities</span><span class=\"p\">,</span> <span class=\"n\">prices</span><span class=\"p\">):</span>\n    <span class=\"n\">totals</span> <span class=\"o\">=</span> <span class=\"p\">{}</span>\n    <span class=\"k\">for</span> <span class=\"n\">item</span> <span class=\"ow\">in</span> <span class=\"n\">quantities</span><span class=\"p\">:</span>\n        <span class=\"n\">___</span> <span class=\"o\">=</span> <span class=\"n\">quantities</span><span class=\"p\">[</span><span class=\"n\">item</span><span class=\"p\">]</span> <span class=\"o\">*</span> <span class=\"n\">prices</span><span class=\"p\">[</span><span class=\"n\">item</span><span class=\"p\">]</span>\n    <span class=\"k\">return</span> <span class=\"n\">totals</span>\n\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span>\n    <span class=\"n\">total_cost_per_item</span><span class=\"p\">({</span><span class=\"s1\">'apple'</span><span class=\"p\">:</span> <span class=\"mi\">2</span><span class=\"p\">},</span> <span class=\"p\">{</span><span class=\"s1\">'apple'</span><span class=\"p\">:</span> <span class=\"mi\">3</span><span class=\"p\">,</span> <span class=\"s1\">'box'</span><span class=\"p\">:</span> <span class=\"mi\">5</span><span class=\"p\">}),</span>\n    <span class=\"p\">{</span><span class=\"s1\">'apple'</span><span class=\"p\">:</span> <span class=\"mi\">6</span><span class=\"p\">},</span>\n<span class=\"p\">)</span>\n\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span>\n    <span class=\"n\">total_cost_per_item</span><span class=\"p\">({</span><span class=\"s1\">'dog'</span><span class=\"p\">:</span> <span class=\"mi\">500</span><span class=\"p\">,</span> <span class=\"s1\">'box'</span><span class=\"p\">:</span> <span class=\"mi\">2</span><span class=\"p\">},</span> <span class=\"p\">{</span><span class=\"s1\">'dog'</span><span class=\"p\">:</span> <span class=\"mi\">100</span><span class=\"p\">,</span> <span class=\"s1\">'box'</span><span class=\"p\">:</span> <span class=\"mi\">5</span><span class=\"p\">}),</span>\n    <span class=\"p\">{</span><span class=\"s1\">'dog'</span><span class=\"p\">:</span> <span class=\"mi\">50000</span><span class=\"p\">,</span> <span class=\"s1\">'box'</span><span class=\"p\">:</span> <span class=\"mi\">10</span><span class=\"p\">},</span>\n<span class=\"p\">)</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>", "name": "total_cost_per_item_exercise", "hints": ["<p><code>___</code> \u306e\u90e8\u5206\u3092\u57cb\u3081\u308b\u3060\u3051\u3067\u5927\u4e08\u592b\u3067\u3059\u3002</p>", "<p>\u3067\u3082\u3001\u304a\u597d\u307f\u3067\u3042\u308c\u3070\u305d\u3053\u306b\u5909\u6570\u540d\u3060\u3051\u3092\u7f6e\u3044\u3066\u3001\u305d\u306e\u4e0b\u306b\u884c\u3092\u8ffd\u52a0\u3057\u3066\u3082\u69cb\u3044\u307e\u305b\u3093\u3002</p>", "<p><code>assert_equal</code> \u3092\u4f7f\u3063\u305f\u30c6\u30b9\u30c8\u3092\u898b\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u6700\u521d\u306e\u4f8b\u3067\u306f\u3001\u671f\u5f85\u3055\u308c\u308b\u51fa\u529b\u304c <code>{'apple': 6}</code> \u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002\u306a\u305c\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u304a\u5ba2\u3055\u3093\u306f\u30ea\u30f3\u30b4\u30922\u500b\u8cb7\u3063\u3066\u3001\u30ea\u30f3\u30b4\u306f1\u500b3\u3067\u3059\u304b\u3089\u3001\u5408\u8a08\u91d1\u984d\u306f <code>2 * 3 = 6</code> \u306b\u306a\u308b\u304b\u3089\u3067\u3059\u3002</p>", "<p>\u304a\u5ba2\u3055\u3093\u306f\u7bb1\uff08box\uff09\u3092\u8cb7\u3063\u3066\u3044\u306a\u3044\u306e\u3067\u3001<code>'box': 5</code> \u306e\u90e8\u5206\u306f\u7121\u8996\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u306f\u5358\u306b\u7bb1\u306e\u5024\u6bb5\u304c5\u3060\u3068\u3044\u3046\u3053\u3068\u3092\u8868\u3057\u3066\u3044\u308b\u3060\u3051\u3067\u3059\u3002</p>", "<p>\u8f9e\u66f8\u306b\u65b0\u3057\u3044\u30ad\u30fc\u3068\u5024\u306e\u30da\u30a2\u3092\u8ffd\u52a0\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u3069\u306e\u8f9e\u66f8\u306b\u3001\u3069\u306e\u30ad\u30fc\u3067\u3001\u3069\u306e\u5024\u3092\u8a2d\u5b9a\u3059\u308b\u306e\u304b\u3092\u78ba\u8a8d\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u305d\u308c\u3089\u306f\u3059\u3079\u3066\u3001\u3059\u3067\u306b\u4e0e\u3048\u3089\u308c\u305f\u30b3\u30fc\u30c9\u306e\u4e2d\u306b\u767b\u5834\u3057\u3066\u3044\u307e\u3059\u3088\u3002</p>", "<p>\u5024\uff08\u30d0\u30ea\u30e5\u30fc\uff09\u306f\u305d\u306e\u5546\u54c1\u306e\u5408\u8a08\u91d1\u984d\u3001\u3064\u307e\u308a\u6570\u91cf\u306b\u5358\u4fa1\u3092\u639b\u3051\u305f\u3082\u306e\u3067\u3059\u3002</p>", "<p>\u3064\u307e\u308a <code>quantities[item] * prices[item]</code> \u3067\u3059\u306d\u3002</p>", "<p>\u3053\u3053\u3067\u306e\u8f9e\u66f8\u3068\u306f\u3001\u3053\u306e\u95a2\u6570\u304c\u4f5c\u6210\u3057\u3001\u4e2d\u8eab\u3092\u8ffd\u52a0\u3057\u3001\u6700\u5f8c\u306b\u8fd4\u3059\u3082\u306e\u306e\u3053\u3068\u3067\u3059\u3002</p>", "<p>\u3064\u307e\u308a <code>totals</code> \u306e\u3053\u3068\u3067\u3059\u3002</p>", "<p>\u305d\u306e\u30c6\u30b9\u30c8\u3067\u306f\u3001<code>'apple'</code> \u304c3\u3064\u306e\u8f9e\u66f8\u3059\u3079\u3066\u3067\u30ad\u30fc\u306b\u306a\u3063\u3066\u3044\u308b\u3053\u3068\u306b\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u3064\u307e\u308a\u3001\u8f9e\u66f8 <code>quantities</code>\u3001<code>prices</code>\u3001\u305d\u3057\u3066 <code>totals</code> \u3067\u3059\u3002</p>"], "solution": {"tokens": ["def", " ", "total_cost_per_item", "(", "quantities", ",", " ", "prices", ")", ":", "\n", "    ", "totals", " ", "=", " ", "{", "}", "\n", "    ", "for", " ", "item", " ", "in", " ", "quantities", ":", "\n", "        ", "totals", "[", "item", "]", " ", "=", " ", "quantities", "[", "item", "]", " ", "*", " ", "prices", "[", "item", "]", "\n", "    ", "return", " ", "totals"], "maskedIndices": [44, 4, 37, 32, 42, 14, 24, 47, 33, 46, 26, 31, 22, 27, 17, 39, 12, 3, 52, 20, 38, 5, 35, 40, 30, 2, 16, 8, 0, 9, 7, 45, 50], "mask": [true, false, true, true, true, true, false, true, true, true, false, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, false, false, true, true, true, true, false, true, false, true, true, true, true, false, true, false, true, true, true, true, false, false, true, false, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "exercise"}, {"type": "function_exercise", "header": "<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">total_cost_per_item</span><span class=\"p\">(</span><span class=\"n\">quantities</span><span class=\"p\">,</span> <span class=\"n\">prices</span><span class=\"p\">):</span>\n</span></code></pre>"}, {"type": "function_exercise_goal", "print_or_return": "return"}, {"type": "custom", "message": "<p>\u4e0a\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u5b9f\u884c\u3057\u307e\u3057\u3087\u3046\u3002\u305f\u3060\u3057\u3001<code>___</code> \u3092\u6b63\u3057\u3044\u30b3\u30fc\u30c9\u306b\u7f6e\u304d\u63db\u3048\u3066\u304f\u3060\u3055\u3044\u3002</p>"}]}, {"index": 7, "text": "<p>\u30d0\u30c3\u30c1\u30ea\u3067\u3059\uff01\u4fbf\u5229\u306a\u60c5\u5831\u304c\u305f\u3063\u3077\u308a\u8a70\u307e\u3063\u305f\u30ec\u30b7\u30fc\u30c8\u306e\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u306d\u3002</p>\n<p>\u3053\u3053\u3067\u3001\u8f9e\u66f8\u3092\u7ffb\u8a33\u306b\u4f7f\u3046\u4f8b\u306b\u623b\u3063\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u82f1\u8a9e\u304b\u3089\u30d5\u30e9\u30f3\u30b9\u8a9e\u306b\u7ffb\u8a33\u3059\u308b\u8f9e\u66f8\u3068\u3001\n\u30d5\u30e9\u30f3\u30b9\u8a9e\u304b\u3089\u30c9\u30a4\u30c4\u8a9e\u306b\u7ffb\u8a33\u3059\u308b\u8f9e\u66f8\u304c1\u3064\u305a\u3064\u3042\u308b\u3068\u3057\u307e\u3059\u3002\n\u3053\u308c\u3089\u3092\u4f7f\u3063\u3066\u3001\u82f1\u8a9e\u304b\u3089\u30c9\u30a4\u30c4\u8a9e\u306b\u7ffb\u8a33\u3059\u308b\u8f9e\u66f8\u3092\u4f5c\u3063\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"k\">def</span> <span class=\"nf\">make_english_to_german</span><span class=\"p\">(</span><span class=\"n\">english_to_french</span><span class=\"p\">,</span> <span class=\"n\">french_to_german</span><span class=\"p\">):</span>\n    <span class=\"o\">...</span>\n\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span>\n    <span class=\"n\">make_english_to_german</span><span class=\"p\">(</span>\n        <span class=\"p\">{</span><span class=\"s1\">'apple'</span><span class=\"p\">:</span> <span class=\"s1\">'pomme'</span><span class=\"p\">,</span> <span class=\"s1\">'box'</span><span class=\"p\">:</span> <span class=\"s1\">'boite'</span><span class=\"p\">},</span>\n        <span class=\"p\">{</span><span class=\"s1\">'pomme'</span><span class=\"p\">:</span> <span class=\"s1\">'apfel'</span><span class=\"p\">,</span> <span class=\"s1\">'boite'</span><span class=\"p\">:</span> <span class=\"s1\">'kasten'</span><span class=\"p\">},</span>\n    <span class=\"p\">),</span>\n    <span class=\"p\">{</span><span class=\"s1\">'apple'</span><span class=\"p\">:</span> <span class=\"s1\">'apfel'</span><span class=\"p\">,</span> <span class=\"s1\">'box'</span><span class=\"p\">:</span> <span class=\"s1\">'kasten'</span><span class=\"p\">},</span>\n<span class=\"p\">)</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>", "name": "make_english_to_german_exercise", "hints": ["<p>\u65b0\u3057\u3044\u8f9e\u66f8\u3092\u4f5c\u6210\u3057\u3001\u5165\u529b\u3055\u308c\u305f2\u3064\u306e\u8f9e\u66f8\u3092\u3082\u3068\u306b\u30ad\u30fc\u3068\u5024\u306e\u30da\u30a2\u3092\u5165\u308c\u3066\u3044\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u3053\u308c\u3092\u884c\u3046\u30b3\u30fc\u30c9\u306f\u524d\u306b\u3082\u898b\u305f\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3088\u3002</p>", "<p>\u5177\u4f53\u7684\u306b\u306f1\u3064\u524d\u306e\u30b9\u30c6\u30c3\u30d7\u3067\u3059\u3002\u4f5c\u308a\u305f\u3044\u30b3\u30fc\u30c9\u5168\u4f53\u306e\u69cb\u9020\u306f\u3001<code>total_cost_per_item</code> \u3068\u3088\u304f\u4f3c\u3066\u3044\u307e\u3059\u3088\u3002</p>", "<p>\u307e\u305a\u306f\u65b0\u3057\u3044\u7a7a\u306e\u8f9e\u66f8\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u6700\u5f8c\u306b\u305d\u306e\u8f9e\u66f8\u3092 <code>return</code> \u3057\u307e\u3059\u3002\u305d\u306e\u9593\u306e\u51e6\u7406\u3092\u57cb\u3081\u3066\u3044\u304d\u307e\u3057\u3087\u3046\u3002</p>", "<p><code>for</code> \u30eb\u30fc\u30d7\u304c\u5fc5\u8981\u3067\u3059\u3002</p>", "<p>\u524d\u306e\u30b9\u30c6\u30c3\u30d7\u306b\u3042\u3063\u305f <code>totals[item] = quantities[item] * prices[item]</code> \u3068\u3044\u3046\u884c\u304c\u3001\u4eca\u56de\u5fc5\u8981\u306a\u30b3\u30fc\u30c9\u306b\u8fd1\u3044\u3067\u3059\u3002</p>", "<p><code>*</code> \u3067\u639b\u3051\u7b97\u3059\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u3057\u3001\u5909\u6570\u540d\u3082\u9055\u3044\u307e\u3059\u3002\u305d\u3057\u3066\u30ed\u30b8\u30c3\u30af\u306b\u3082\u30461\u3064\u9055\u3044\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u65b0\u3057\u3044\u8f9e\u66f8\u306e\u30ad\u30fc\u3068\u5024\u304c\u305d\u308c\u305e\u308c\u4f55\u306b\u306a\u308b\u3079\u304d\u304b\u3001\u8003\u3048\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u30ad\u30fc\u306f\u82f1\u8a9e\u306e\u5358\u8a9e\u306b\u306a\u308b\u306f\u305a\u306a\u306e\u3067\u3001\u6700\u521d\u306e\u8f9e\u66f8\u304b\u3089\u53d6\u5f97\u3059\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002</p>", "<p>\u5024\u306f\u30c9\u30a4\u30c4\u8a9e\u306e\u5358\u8a9e\u306b\u306a\u308b\u306f\u305a\u306a\u306e\u3067\u30012\u3064\u76ee\u306e\u8f9e\u66f8\u304b\u3089\u53d6\u5f97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u5177\u4f53\u7684\u306b\u306f\u3001\u4f5c\u6210\u3059\u308b\u8f9e\u66f8\u306e\u30ad\u30fc\u306f\u6700\u521d\u306e\u8f9e\u66f8\u306e\u30ad\u30fc\u3068\u540c\u3058\u306b\u306a\u308b\u306f\u305a\u3067\u3059\u3002</p>", "<p>\u305d\u3057\u3066\u3001\u4f5c\u6210\u3059\u308b\u8f9e\u66f8\u306e\u5024\uff08\u30d0\u30ea\u30e5\u30fc\uff09\u306f2\u3064\u76ee\u306e\u8f9e\u66f8\u306e\u5024\u306b\u306a\u308b\u306f\u305a\u3067\u3059\u3002</p>", "<p>\u3067\u306f\u3001\u6700\u521d\u306e\u8f9e\u66f8\u306e\u5024\u3068\u30012\u3064\u76ee\u306e\u8f9e\u66f8\u306e\u30ad\u30fc\u306f\u3069\u3046\u3067\u3057\u3087\u3046\u304b\uff1f\u3053\u3053\u304c\u5927\u4e8b\u306a\u30dd\u30a4\u30f3\u30c8\u3067\u3059\u3002</p>", "<p>\u30c6\u30b9\u30c8\u306e\u4f8b\u306b\u3042\u308b\u30d5\u30e9\u30f3\u30b9\u8a9e\u306e\u5358\u8a9e <code>'pomme'</code> \u3068 <code>'boite'</code> \u306b\u6ce8\u76ee\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>1\u3064\u76ee\u306e\u5165\u529b\u8f9e\u66f8\u306e\u5024\u304c\u30012\u3064\u76ee\u306e\u5165\u529b\u8f9e\u66f8\u306e\u30ad\u30fc\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u306d\u3002</p>"], "solution": {"tokens": ["def", " ", "make_english_to_german", "(", "english_to_french", ",", " ", "french_to_german", ")", ":", "\n", "    ", "english_to_german", " ", "=", " ", "{", "}", "\n", "    ", "for", " ", "english", " ", "in", " ", "english_to_french", ":", "\n", "        ", "french", " ", "=", " ", "english_to_french", "[", "english", "]", "\n", "        ", "german", " ", "=", " ", "french_to_german", "[", "french", "]", "\n", "        ", "english_to_german", "[", "english", "]", " ", "=", " ", "german", "\n", "    ", "return", " ", "english_to_german"], "maskedIndices": [60, 5, 45, 50, 52, 16, 8, 34, 44, 32, 14, 62, 17, 47, 9, 51, 55, 37, 53, 20, 27, 7, 4, 26, 36, 22, 3, 2, 40, 12, 24, 35, 42, 57, 0, 46, 30], "mask": [true, false, true, true, true, true, false, true, true, true, false, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, false, false, true, false, true, false, true, true, true, true, false, false, true, false, true, false, true, true, true, true, false, false, true, true, true, true, false, true, false, true, false, false, true, false, true], "lines": [{"id": "5", "content": "        <span class=\"n\">english_to_german</span><span class=\"p\">[</span><span class=\"n\">english</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"n\">german</span>"}, {"id": "4", "content": "        <span class=\"n\">german</span> <span class=\"o\">=</span> <span class=\"n\">french_to_german</span><span class=\"p\">[</span><span class=\"n\">french</span><span class=\"p\">]</span>"}, {"id": "2", "content": "    <span class=\"k\">for</span> <span class=\"n\">english</span> <span class=\"ow\">in</span> <span class=\"n\">english_to_french</span><span class=\"p\">:</span>"}, {"id": "1", "content": "    <span class=\"n\">english_to_german</span> <span class=\"o\">=</span> <span class=\"p\">{}</span>"}, {"id": "6", "content": "    <span class=\"k\">return</span> <span class=\"n\">english_to_german</span>"}, {"id": "3", "content": "        <span class=\"n\">french</span> <span class=\"o\">=</span> <span class=\"n\">english_to_french</span><span class=\"p\">[</span><span class=\"n\">english</span><span class=\"p\">]</span>"}, {"id": "0", "content": "<span class=\"k\">def</span> <span class=\"nf\">make_english_to_german</span><span class=\"p\">(</span><span class=\"n\">english_to_french</span><span class=\"p\">,</span> <span class=\"n\">french_to_german</span><span class=\"p\">):</span>"}]}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "exercise"}, {"type": "function_exercise", "header": "<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">make_english_to_german</span><span class=\"p\">(</span><span class=\"n\">english_to_french</span><span class=\"p\">,</span> <span class=\"n\">french_to_german</span><span class=\"p\">):</span>\n</span></code></pre>"}, {"type": "function_exercise_goal", "print_or_return": "return"}]}, {"index": 8, "text": "<p>\u3088\u304f\u3067\u304d\u307e\u3057\u305f\uff01</p>\n<p>\u3082\u3061\u308d\u3093\u3001\u8a00\u8449\u306f\u305d\u3093\u306a\u306b\u5358\u7d14\u3067\u306f\u306a\u3044\u306e\u3067\u3001\u3053\u306e\u3088\u3046\u306b\u8f9e\u66f8\u3092\u4f7f\u3046\u3068\u304a\u304b\u3057\u306a\u3053\u3068\u306b\u306a\u308b\u5834\u5408\u3082\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\n\u305d\u3053\u3067\u2026\u3082\u3063\u3068\u7121\u8336\u306a\u3053\u3068\u3092\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff01\u82f1\u8a9e\u304b\u3089\u30d5\u30e9\u30f3\u30b9\u8a9e\u3078\u306e\u8f9e\u66f8\u3092\u4f7f\u3063\u3066\u3001\u30d5\u30e9\u30f3\u30b9\u8a9e\u304b\u3089\u82f1\u8a9e\u3078\u306e\u8f9e\u66f8\u3092\u4f5c\u3063\u3066\u307f\u308b\u306e\u3067\u3059\u3002\n\u8f9e\u66f8\u3092\u53d7\u3051\u53d6\u308a\u3001\u30ad\u30fc\u3068\u5024\u304c\u5165\u308c\u66ff\u308f\u3063\u305f\u65b0\u3057\u3044\u8f9e\u66f8\uff08\u3064\u307e\u308a <code>a: b</code> \u304c <code>b: a</code> \u306b\u306a\u308b\u3088\u3046\u306a\u8f9e\u66f8\uff09\u3092\n\u8fd4\u3059\u95a2\u6570\u3092\u66f8\u3044\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"k\">def</span> <span class=\"nf\">swap_keys_values</span><span class=\"p\">(</span><span class=\"n\">d</span><span class=\"p\">):</span>\n    <span class=\"o\">...</span>\n\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span>\n    <span class=\"n\">swap_keys_values</span><span class=\"p\">({</span><span class=\"s1\">'apple'</span><span class=\"p\">:</span> <span class=\"s1\">'pomme'</span><span class=\"p\">,</span> <span class=\"s1\">'box'</span><span class=\"p\">:</span> <span class=\"s1\">'boite'</span><span class=\"p\">}),</span>\n    <span class=\"p\">{</span><span class=\"s1\">'pomme'</span><span class=\"p\">:</span> <span class=\"s1\">'apple'</span><span class=\"p\">,</span> <span class=\"s1\">'boite'</span><span class=\"p\">:</span> <span class=\"s1\">'box'</span><span class=\"p\">},</span>\n<span class=\"p\">)</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>", "name": "swap_keys_values_exercise", "hints": ["<p>\u5f15\u6570\u3068\u3057\u3066\u6e21\u3055\u308c\u305f\u8f9e\u66f8 <code>d</code> \u306f\u5909\u66f4\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u65b0\u3057\u3044\u8f9e\u66f8\u3092\u4f5c\u6210\u3057\u3066\u3001\u5165\u529b\u3055\u308c\u305f\u8f9e\u66f8\u3092\u3082\u3068\u306b\u30ad\u30fc\u3068\u5024\u306e\u30da\u30a2\u3092\u8ffd\u52a0\u3057\u3066\u3044\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u524d\u306e\u30a8\u30af\u30b5\u30b5\u30a4\u30ba\u3067\u3082\u3084\u308a\u307e\u3057\u305f\u306d\u3002\u5168\u4f53\u306e\u69cb\u9020\u306f <code>make_english_to_german</code> \u3068\u3088\u304f\u4f3c\u3066\u3044\u307e\u3059\u3002</p>", "<p>\u5b9f\u306f\u3053\u3061\u3089\u306e\u307b\u3046\u304c\u3082\u3063\u3068\u30b7\u30f3\u30d7\u30eb\u3067\u3059\u3088\u3002\u3061\u3087\u3063\u3068\u4e0d\u601d\u8b70\u306a\u611f\u3058\u304c\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3002</p>", "<p>\u307e\u305a\u306f\u65b0\u3057\u3044\u7a7a\u306e\u8f9e\u66f8\u3092\u4f5c\u6210\u3057\u3001\u6700\u5f8c\u306b\u305d\u306e\u8f9e\u66f8\u3092 <code>return</code> \u3057\u307e\u3059\u3002\u305d\u306e\u9593\u306b <code>for</code> \u30eb\u30fc\u30d7\u3092\u5165\u308c\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u65b0\u3057\u3044\u8f9e\u66f8\u306e\u30ad\u30fc\u3068\u5024\u304c\u305d\u308c\u305e\u308c\u4f55\u306b\u306a\u308b\u3079\u304d\u304b\u3001\u8003\u3048\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u30eb\u30fc\u30d7\u51e6\u7406\u3067\u56de\u305b\u308b\u5bfe\u8c61\u306f1\u3064\u3057\u304b\u3042\u308a\u307e\u305b\u3093\u306d\u3002</p>", "<p>\u5165\u529b\u3055\u308c\u305f\u8f9e\u66f8 <code>d</code> \u306e\u5404\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u3001\u5bfe\u5fdc\u3059\u308b\u5024\u3092\u53d6\u5f97\u3057\u307e\u3057\u3087\u3046\u3002</p>"], "solution": {"tokens": ["def", " ", "swap_keys_values", "(", "d", ")", ":", "\n", "    ", "new_dict", " ", "=", " ", "{", "}", "\n", "    ", "for", " ", "key", " ", "in", " ", "d", ":", "\n", "        ", "value", " ", "=", " ", "d", "[", "key", "]", "\n", "        ", "new_dict", "[", "value", "]", " ", "=", " ", "key", "\n", "    ", "return", " ", "new_dict"], "maskedIndices": [4, 39, 37, 14, 38, 31, 11, 6, 19, 3, 17, 49, 0, 27, 23, 44, 34, 33, 13, 21, 2, 32, 40, 5, 24, 42, 9, 29, 47], "mask": [true, false, true, true, true, true, true, false, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, false, false, true, false, true, false, true, true, true, true, false, false, true, true, true, true, false, true, false, true, false, false, true, false, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "exercise"}, {"type": "function_exercise", "header": "<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">swap_keys_values</span><span class=\"p\">(</span><span class=\"n\">d</span><span class=\"p\">):</span>\n</span></code></pre>"}, {"type": "function_exercise_goal", "print_or_return": "return"}]}, {"index": 9, "text": "<p>\u3059\u3070\u3089\u3057\u3044\uff01</p>\n<p>\u5197\u8ac7\u306f\u3055\u3066\u304a\u304d\u3001\u3053\u308c\u304c\u3069\u3046\u3057\u3066\u3046\u307e\u304f\u3044\u304b\u306a\u304f\u306a\u308b\u306e\u304b\u3092\u899a\u3048\u3066\u304a\u304f\u3053\u3068\u304c\u5927\u5207\u3067\u3059\u3002\u304a\u5e97\u306b\u3042\u308b\u8907\u6570\u306e\u5546\u54c1\u304c\n\u540c\u3058\u5024\u6bb5\u306b\u306a\u308b\u3053\u3068\u304c\u3042\u308b\u3088\u3046\u306b\u3001\u82f1\u8a9e\u306e\u8907\u6570\u306e\u5358\u8a9e\u304c\u30d5\u30e9\u30f3\u30b9\u8a9e\u3067\u540c\u3058\u8a33\u306b\u306a\u308b\u3053\u3068\u3082\u3042\u308a\u307e\u3059\u3002\u3082\u3057\u5143\u306e\u8f9e\u66f8\u306b\n\u91cd\u8907\u3057\u305f\u300c\u5024\uff08<em>values</em>\uff09\u300d\u304c\u3042\u3063\u305f\u3089\u3001\u30ad\u30fc\u3068\u5024\u3092\u5165\u308c\u66ff\u3048\u3088\u3046\u3068\u3057\u305f\u3068\u304d\u306b\u4f55\u304c\u8d77\u304d\u308b\u3067\u3057\u3087\u3046\u304b\uff1f \u8f9e\u66f8\u306e\u30ad\u30fc\u306f\u91cd\u8907\u3067\u304d\u306a\u3044\uff08\u4e00\u610f\u3067\u3042\u308b\u5fc5\u8981\u304c\u3042\u308b\uff09\u306e\u3067\u3001\n\u4e00\u90e8\u306e\u30c7\u30fc\u30bf\u304c\u5931\u308f\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002</p>\n<p>\u305f\u3068\u3048\u3070\u3001\u30d5\u30e9\u30f3\u30b9\u8a9e\u306e\u300cavocat\u300d\u306f\u300cavocado\uff08\u30a2\u30dc\u30ab\u30c9\uff09\u300d\u3068\u300clawyer\uff08\u5f01\u8b77\u58eb\uff09\u300d\u306e\u4e21\u65b9\u306e\u610f\u5473\u3092\u6301\u3061\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u82f1\u8a9e\u306e\n\u300cavocado\u300d\u3092\u30d5\u30e9\u30f3\u30b9\u8a9e\u306b\u7ffb\u8a33\u3059\u308b\u306e\u306f\u7c21\u5358\u3067\u3059\u304c\u3001\u300cavocat\u300d\u3092\u82f1\u8a9e\u306b\u623b\u3059\u3068\u306a\u308b\u3068\u3069\u3061\u3089\u306b\u8a33\u3059\u3079\u304d\u304b\u30cf\u30c3\u30ad\u30ea\u3057\u307e\u305b\u3093\u3002\n\u6b21\u306e\u30b3\u30fc\u30c9\u304c\u4f55\u3092\u51fa\u529b\u3059\u308b\u304b\u4e88\u60f3\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"k\">def</span> <span class=\"nf\">swap_keys_values</span><span class=\"p\">(</span><span class=\"n\">d</span><span class=\"p\">):</span>\n    <span class=\"n\">new_dict</span> <span class=\"o\">=</span> <span class=\"p\">{}</span>\n    <span class=\"k\">for</span> <span class=\"n\">key</span> <span class=\"ow\">in</span> <span class=\"n\">d</span><span class=\"p\">:</span>\n        <span class=\"n\">new_dict</span><span class=\"p\">[</span><span class=\"n\">d</span><span class=\"p\">[</span><span class=\"n\">key</span><span class=\"p\">]]</span> <span class=\"o\">=</span> <span class=\"n\">key</span>\n    <span class=\"k\">return</span> <span class=\"n\">new_dict</span>\n\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">swap_keys_values</span><span class=\"p\">({</span><span class=\"s1\">'apple'</span><span class=\"p\">:</span> <span class=\"s1\">'pomme'</span><span class=\"p\">,</span> <span class=\"s1\">'avocado'</span><span class=\"p\">:</span> <span class=\"s1\">'avocat'</span><span class=\"p\">,</span> <span class=\"s1\">'lawyer'</span><span class=\"p\">:</span> <span class=\"s1\">'avocat'</span><span class=\"p\">}))</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">swap_keys_values</span><span class=\"p\">({</span><span class=\"s1\">'apple'</span><span class=\"p\">:</span> <span class=\"s1\">'pomme'</span><span class=\"p\">,</span> <span class=\"s1\">'lawyer'</span><span class=\"p\">:</span> <span class=\"s1\">'avocat'</span><span class=\"p\">,</span> <span class=\"s1\">'avocado'</span><span class=\"p\">:</span> <span class=\"s1\">'avocat'</span><span class=\"p\">}))</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>", "name": "avocado_or_lawyer", "hints": [], "solution": {"tokens": ["def", " ", "swap_keys_values", "(", "d", ")", ":", "\n", "    ", "new_dict", " ", "=", " ", "{", "}", "\n", "    ", "for", " ", "key", " ", "in", " ", "d", ":", "\n", "        ", "new_dict", "[", "d", "[", "key", "]", "]", " ", "=", " ", "key", "\n", "    ", "return", " ", "new_dict", "\n", "\n", "print", "(", "swap_keys_values", "(", "{", "'apple'", ":", " ", "'pomme'", ",", " ", "'avocado'", ":", " ", "'avocat'", ",", " ", "'lawyer'", ":", " ", "'avocat'", "}", ")", ")", "\n", "print", "(", "swap_keys_values", "(", "{", "'apple'", ":", " ", "'pomme'", ",", " ", "'lawyer'", ":", " ", "'avocat'", ",", " ", "'avocado'", ":", " ", "'avocat'", "}", ")", ")"], "maskedIndices": [85, 29, 62, 42, 90, 0, 53, 71, 4, 19, 84, 60, 56, 23, 65, 76, 88, 92, 79, 70, 54, 74, 11, 9, 68, 24, 67, 63, 66, 81, 59, 82, 50, 13, 48, 45, 2, 37, 91, 6, 78, 28, 40, 51, 57, 21, 33, 75, 47, 72, 87, 49, 31, 46, 32, 73, 14, 17, 27, 30, 35, 93, 5, 3], "mask": [true, false, true, true, true, true, true, false, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, false, false, true, true, true, true, true, true, true, false, true, false, true, false, false, true, false, true, false, false, true, true, true, true, true, true, true, false, true, true, false, true, true, false, true, true, false, true, true, false, true, true, true, true, false, true, true, true, true, true, true, true, false, true, true, false, true, true, false, true, true, false, true, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 10, "text": "<p>\u7d50\u679c\u306f\u3001\u5143\u306e\u8f9e\u66f8\u306b\u3042\u308b\u30ad\u30fc\u306e\u9806\u756a\u306b\u3088\u3063\u3066\u5909\u308f\u308a\u307e\u3059\uff01\n\u306a\u305c\u305d\u3046\u306a\u308b\u306e\u304b\u3088\u304f\u308f\u304b\u3089\u306a\u3044\u5834\u5408\u306f\u3001<code>snoop</code> \u3084\u4ed6\u306e\u30c7\u30d0\u30c3\u30ac\u3092\u4f7f\u3063\u3066\u30b3\u30fc\u30c9\u3092\u5b9f\u884c\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002</p>\n<p>\u3057\u304b\u3057\u3001\u8f9e\u66f8\u306e\u5024\u304c\u300c\u5fc5\u305a\u300d\u4e00\u610f\uff08\u91cd\u8907\u304c\u306a\u3044\uff09\u3067\u3042\u308a\u3001\u3053\u306e\n\u300c\u53cd\u8ee2\uff08\u30ad\u30fc\u3068\u5024\u306e\u5165\u308c\u66ff\u3048\uff09\u300d\u304c\u3046\u307e\u304f\u6a5f\u80fd\u3059\u308b\u3068\u78ba\u4fe1\u3067\u304d\u308b\u5834\u9762\u3082\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001<a href=\"#UsingDictionaries\">\u3053\u306e\u7ae0\u306e\u524d\u306e\u65b9</a>\u3067\u3053\u3093\u306a\u30b3\u30fc\u30c9\u3092\u898b\u307e\u3057\u305f\u306d\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"k\">def</span> <span class=\"nf\">substitute</span><span class=\"p\">(</span><span class=\"n\">string</span><span class=\"p\">,</span> <span class=\"n\">d</span><span class=\"p\">):</span>\n    <span class=\"n\">result</span> <span class=\"o\">=</span> <span class=\"s2\">\"\"</span>\n    <span class=\"k\">for</span> <span class=\"n\">letter</span> <span class=\"ow\">in</span> <span class=\"n\">string</span><span class=\"p\">:</span>\n        <span class=\"n\">result</span> <span class=\"o\">+=</span> <span class=\"n\">d</span><span class=\"p\">[</span><span class=\"n\">letter</span><span class=\"p\">]</span>\n    <span class=\"k\">return</span> <span class=\"n\">result</span>\n\n<span class=\"n\">plaintext</span> <span class=\"o\">=</span> <span class=\"s1\">'helloworld'</span>\n<span class=\"n\">encrypted</span> <span class=\"o\">=</span> <span class=\"s1\">'qpeefifmez'</span>\n<span class=\"n\">letters</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"s1\">'h'</span><span class=\"p\">:</span> <span class=\"s1\">'q'</span><span class=\"p\">,</span> <span class=\"s1\">'e'</span><span class=\"p\">:</span> <span class=\"s1\">'p'</span><span class=\"p\">,</span> <span class=\"s1\">'l'</span><span class=\"p\">:</span> <span class=\"s1\">'e'</span><span class=\"p\">,</span> <span class=\"s1\">'o'</span><span class=\"p\">:</span> <span class=\"s1\">'f'</span><span class=\"p\">,</span> <span class=\"s1\">'w'</span><span class=\"p\">:</span> <span class=\"s1\">'i'</span><span class=\"p\">,</span> <span class=\"s1\">'r'</span><span class=\"p\">:</span> <span class=\"s1\">'m'</span><span class=\"p\">,</span> <span class=\"s1\">'d'</span><span class=\"p\">:</span> <span class=\"s1\">'z'</span><span class=\"p\">}</span>\n<span class=\"n\">reverse</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"s1\">'q'</span><span class=\"p\">:</span> <span class=\"s1\">'h'</span><span class=\"p\">,</span> <span class=\"s1\">'p'</span><span class=\"p\">:</span> <span class=\"s1\">'e'</span><span class=\"p\">,</span> <span class=\"s1\">'e'</span><span class=\"p\">:</span> <span class=\"s1\">'l'</span><span class=\"p\">,</span> <span class=\"s1\">'f'</span><span class=\"p\">:</span> <span class=\"s1\">'o'</span><span class=\"p\">,</span> <span class=\"s1\">'i'</span><span class=\"p\">:</span> <span class=\"s1\">'w'</span><span class=\"p\">,</span> <span class=\"s1\">'m'</span><span class=\"p\">:</span> <span class=\"s1\">'r'</span><span class=\"p\">,</span> <span class=\"s1\">'z'</span><span class=\"p\">:</span> <span class=\"s1\">'d'</span><span class=\"p\">}</span>\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">substitute</span><span class=\"p\">(</span><span class=\"n\">plaintext</span><span class=\"p\">,</span> <span class=\"n\">letters</span><span class=\"p\">),</span> <span class=\"n\">encrypted</span><span class=\"p\">)</span>\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">substitute</span><span class=\"p\">(</span><span class=\"n\">encrypted</span><span class=\"p\">,</span> <span class=\"n\">reverse</span><span class=\"p\">),</span> <span class=\"n\">plaintext</span><span class=\"p\">)</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p>\u4eca\u3084\u3001\u3053\u306e <code>reverse</code> \u8f9e\u66f8\u3092\u81ea\u52d5\u7684\u306b\u4f5c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">reverse</span> <span class=\"o\">=</span> <span class=\"n\">swap_keys_values</span><span class=\"p\">(</span><span class=\"n\">letters</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\u3053\u308c\u304c\u3046\u307e\u304f\u3044\u304f\u305f\u3081\u306b\u306f\u3001<code>letters</code> \u306e\u3059\u3079\u3066\u306e\u5024\u304c\u4e00\u610f\u3067\u3042\u308b\uff08\u91cd\u8907\u3057\u306a\u3044\uff09\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b\u3060\u3051\u3067\u5341\u5206\u3067\u3059\u3002\n\u305d\u3046\u3067\u306a\u3044\u3068\u3001\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u6b63\u3057\u304f\u5fa9\u53f7\uff08\u6697\u53f7\u306e\u89e3\u8aad\uff09\u3067\u304d\u306a\u304f\u306a\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u3082\u3057\u6697\u53f7\u5316\u306e\u3068\u304d\u306b <code>'h'</code> \u3068 <code>'j'</code> \u306e\u4e21\u65b9\u304c <code>'q'</code> \u306b\u7f6e\u304d\u63db\u3048\u3089\u308c\u3066\u3057\u307e\u3063\u305f\u3089\u3001\n<code>'qpeef'</code> \u304c <code>'hello'</code> \u306a\u306e\u304b <code>'jello'</code> \u306a\u306e\u304b\u898b\u5206\u3051\u308b\u65b9\u6cd5\u304c\u306a\u304f\u306a\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u304b\u3089\u306d\uff01</p>\n<p>\u304a\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01 \u3053\u308c\u3067\u73fe\u5728\u306e\u30b3\u30fc\u30b9\u306e\u6700\u5f8c\u307e\u3067\u5230\u9054\u3057\u307e\u3057\u305f\u3002\u7d9a\u304d\u3082\u8fd1\u65e5\u767b\u5834\u4e88\u5b9a\u3067\u3059\uff01</p>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}}, "pageSlugsList": ["IntroducingTheShell", "NavigatingShellHistory", "IntroducingStrings", "AddingStrings", "IntroducingVariables", "UsingVariables", "WritingPrograms", "StoringCalculationsInVariables", "IntroducingForLoops", "Indentation", "BasicForLoopExercises", "BuildingUpStrings", "BuildingUpStringsExercises", "BasicTerminology", "IntroducingIfStatements", "CombiningCompoundStatements", "UnderstandingProgramsWithSnoop", "IfAndElse", "TheEqualityOperator", "IntroducingElif", "OtherComparisonOperators", "IntroducingLists", "BuildingNewLists", "UsingBreak", "GettingElementsAtPosition", "GettingElementsAtPositionExercises", "CallingFunctionsTerminology", "FunctionsAndMethodsForLists", "MoreListFunctionsAndMethods", "StringMethodsUnderstandingMutation", "HowToFindInformationWithGoogleAndMore", "UnderstandingProgramsWithPythonTutor", "EqualsVsIs", "ModifyingWhileIterating", "SingleAndDoubleQuotesInStrings", "IntroducingFstrings", "IntroducingNestedLoops", "IntroducingBirdseye", "IntroducingNestedLists", "LoopingOverNestedLists", "DefiningFunctions", "CallingFunctionsWithinFunctions", "ReturningValuesFromFunctions", "TestingFunctions", "MoreOnReturn", "IntroducingOr", "IntroducingAnd", "MultiLineExpressions", "CombiningAndAndOr", "IntroducingNotPage", "IntroducingTicTacToe", "NewlinesAndFormatBoard", "Types", "InteractiveProgramsWithInput", "NestedListAssignment", "MakingTheBoard", "TheFullTicTacToeGame", "IntroducingDictionaries", "UsingDictionaries", "DictionaryKeysAndValues", "CreatingKeyValuePairs"]}