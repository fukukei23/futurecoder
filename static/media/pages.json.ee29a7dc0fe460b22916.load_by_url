ord</span> <span class=\"o\">+</span> <span class=\"s1\">' '</span> <span class=\"o\">+</span> <span class=\"n\">name</span><span class=\"p\">)</span>\n</span></code></pre>", "name": "editor_hello_world", "hints": [], "solution": {"tokens": ["word", " ", "=", " ", "'Hello'", "\n", "name", " ", "=", " ", "'World'", "\n", "print", "(", "word", " ", "+", " ", "' '", " ", "+", " ", "name", ")", "\n", "word", " ", "=", " ", "'Goodbye'", "\n", "print", "(", "word", " ", "+", " ", "' '", " ", "+", " ", "name", ")"], "maskedIndices": [29, 39, 10, 33, 14, 8, 12, 42, 32, 25, 16, 6, 2, 23, 20, 31, 13, 18, 27, 0, 35, 37, 22, 41, 4], "mask": [true, false, true, false, true, false, true, false, true, false, true, false, true, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, false, true, false, true, true, true, false, true, false, true, false, true, false, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 1, "text": "<p>\u304a\u3081\u3067\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01\u521d\u3081\u3066\u306e\u5b9f\u969b\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u5b9f\u884c\u3067\u304d\u307e\u3057\u305f\u306d\uff01</p>\n<p>\u5c11\u3057\u6642\u9593\u3092\u53d6\u3063\u3066\u3001\u3053\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u7406\u89e3\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002Python\u306f\u3001\u30b3\u30fc\u30c9\u3092\u4e0a\u304b\u3089\u4e0b\u3078\u30681\u884c\u305a\u3064\u9806\u756a\u306b\u5b9f\u884c\u3057\u307e\u3059\u3002\u982d\u306e\u4e2d\u3067\u3053\u306e\u6d41\u308c\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u308c\u305e\u308c\u306e\u884c\u304c\u4f55\u3092\u3057\u3066\u3044\u308b\u304b\u3092\u8003\u3048\u3066\u307f\u307e\u3057\u3087\u3046\u3002<code>word</code> \u306e\u5024\u304c\u3069\u306e\u3088\u3046\u306b\u5909\u66f4\u3055\u308c\u3001\u305d\u308c\u304c\u3069\u3093\u306a\u7d50\u679c\u3092\u3082\u305f\u3089\u3057\u305f\u304b\u78ba\u8a8d\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u307e\u305f\u3001<code>print</code> \u3092\u8907\u6570\u56de\u4f7f\u3046\u3068\u3001\u305d\u308c\u305e\u308c\uff08\u3053\u306e\u5834\u5408\u306f <code>Hello World</code> \u3068 <code>Goodbye World</code>\uff09\u304c\u6539\u884c\u3055\u308c\u3066\u5225\u306e\u884c\u306b\u51fa\u529b\u3055\u308c\u308b\u3053\u3068\u306b\u3082\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>\n<p>\u30a8\u30c7\u30a3\u30bf\u5185\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u306b\u3064\u3044\u3066\u3001\u899a\u3048\u3066\u304a\u304f\u3079\u304d\u30dd\u30a4\u30f3\u30c8\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\uff1a</p>\n<ol>\n<li>\u30d7\u30ed\u30b0\u30e9\u30e0\u306f\u30b7\u30a7\u30eb\u306e\u4e2d\u3067\u5b9f\u884c\u3055\u308c\u307e\u3059\u3002\u3064\u307e\u308a\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u5185\u3067\u5b9a\u7fa9\u3055\u308c\u305f\u5909\u6570\u306f\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u7d42\u4e86\u5f8c\u3082\u6700\u5f8c\u306e\u5024\u3092\u6301\u3063\u305f\u307e\u307e\u30b7\u30a7\u30eb\u306e\u4e2d\u306b\u6b8b\u308a\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u306e\u5b9f\u884c\u304c\u7d42\u308f\u3063\u305f\u5f8c\u3082\u30b7\u30a7\u30eb\u306e\u4e2d\u3067\u3044\u308d\u3044\u308d\u3068\u8abf\u3079\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u73fe\u5728\u30b7\u30a7\u30eb\u306e\u4e2d\u3067\u306f <code>name</code> \u306f <code>'World'</code> \u3068\u3044\u3046\u5024\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002</li>\n<li>\u30d7\u30ed\u30b0\u30e9\u30e0\u306f\u72ec\u7acb\u3057\u3066\u5b9f\u884c\u3055\u308c\u307e\u3059\u3002\u305d\u308c\u4ee5\u524d\u306b\u5b9a\u7fa9\u3055\u308c\u305f\u5909\u6570\u306b\u4f9d\u5b58\u3059\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u5b9f\u884c\u3059\u308b\u305f\u3073\u306b\u30b7\u30a7\u30eb\u306f\u30ea\u30bb\u30c3\u30c8\u3055\u308c\u3001\u524d\u56de\u306e\u5909\u6570\u306f\u3059\u3079\u3066\u6d88\u53bb\u3055\u308c\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u73fe\u5728\u30b7\u30a7\u30eb\u306b <code>word</code> \u304c\u5b58\u5728\u3057\u3066\u3044\u3066\u3082\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u306e1\u884c\u76ee\u3092\u524a\u9664\u3057\u3066\u518d\u5b9f\u884c\u3059\u308b\u3068\u3001<code>word</code> \u304c\u672a\u5b9a\u7fa9\uff08undefined\uff09\u3067\u3042\u308b\u3068\u3044\u3046\u30a8\u30e9\u30fc\u304c\u767a\u751f\u3057\u307e\u3059\u3002</li>\n<li>\u30b7\u30a7\u30eb\u306b\u30b3\u30fc\u30c9\u3092\u5165\u529b\u3057\u305f\u3068\u304d\u306b\u5024\u304c\u3042\u308b\u3068\u3001\u305d\u306e\u5024\u306f\u81ea\u52d5\u7684\u306b\u753b\u9762\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u30a8\u30c7\u30a3\u30bf\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3067\u306f\u305d\u3046\u306f\u306a\u308a\u307e\u305b\u3093\u3002\u5024\u3092\u8868\u793a\u3059\u308b\u306b\u306f <code>print</code> \u3092\u4f7f\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3082\u3057\u30d7\u30ed\u30b0\u30e9\u30e0\u304b\u3089 <code>print()</code> \u3092\u524a\u9664\u3057\u3066\u30012\u3064\u306e\u884c\u3092\u5358\u306b <code>word + ' ' + name</code> \u306b\u5909\u3048\u308b\u3068\u3001\u753b\u9762\u306b\u306f\u4f55\u3082\u8868\u793a\u3055\u308c\u306a\u304f\u306a\u308a\u307e\u3059\u3002</li>\n</ol>\n<p>\u3053\u308c\u3089\u3059\u3079\u3066\u3092\u3001\u305c\u3072\u81ea\u5206\u81ea\u8eab\u306e\u624b\u3067\u8a66\u3057\u3066\u78ba\u8a8d\u3057\u3066\u307f\u308b\u3053\u3068\u3092\u304a\u3059\u3059\u3081\u3057\u307e\u3059\u3002</p>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}, "StoringCalculationsInVariables": {"slug": "StoringCalculationsInVariables", "title": "\u8a08\u7b97\u7d50\u679c\u3092\u5909\u6570\u306b\u4fdd\u5b58\u3059\u308b", "index": 7, "step_names": ["sentence_equals_word_plus_name", "sentence_doesnt_change", "final_text"], "steps": [{"index": 0, "text": "<p>\u30d7\u30ed\u30b0\u30e9\u30df\u30f3\u30b0\u3067\u306f\u3001\u8a08\u7b97\u7d50\u679c\u3092\u5909\u6570\u306b\u4fdd\u5b58\u3057\u3066\u304a\u304f\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u3053\u3046\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u8907\u96d1\u306a\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u4f5c\u308c\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3088\u3002\u4f8b\u3048\u3070\u3001\u3053\u3093\u306a\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u8a66\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">word</span> <span class=\"o\">=</span> <span class=\"s1\">'Hello'</span>\n<span class=\"n\">name</span> <span class=\"o\">=</span> <span class=\"s1\">'World'</span>\n<span class=\"n\">sentence</span> <span class=\"o\">=</span> <span class=\"n\">word</span> <span class=\"o\">+</span> <span class=\"s1\">' '</span> <span class=\"o\">+</span> <span class=\"n\">name</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">sentence</span><span class=\"p\">)</span>\n</span></code></pre>", "name": "sentence_equals_word_plus_name", "hints": [], "solution": {"tokens": ["word", " ", "=", " ", "'Hello'", "\n", "name", " ", "=", " ", "'World'", "\n", "sentence", " ", "=", " ", "word", " ", "+", " ", "' '", " ", "+", " ", "name", "\n", "print", "(", "sentence", ")"], "maskedIndices": [14, 0, 20, 4, 18, 22, 12, 6, 10, 24, 27, 26, 16, 8, 2, 28, 29], "mask": [true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": ["sentence", "word + ' ' + name", "Hello + ' ' + World", "'Hello' + ' ' + 'World'", "Hello World", "'Hello World'", "\u30a8\u30e9\u30fc"], "answer": "Hello World"}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 1, "text": "<p>\u3053\u308c\u3067 <code>sentence</code> \u306b\u306f <code>'Hello World'</code> \u3068\u3044\u3046\u5024\u304c\u5165\u308a\u3001\u4f55\u5ea6\u3067\u3082\u4f7f\u3048\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u3053\u3053\u3067\u5927\u4e8b\u306a\u30dd\u30a4\u30f3\u30c8\u3067\u3059\u304c\u3001<code>sentence = &lt;\u4f55\u304b&gt;</code> \u306e\u3088\u3046\u306b\u76f4\u63a5\u4ee3\u5165\u3057\u76f4\u3055\u306a\u3044\u9650\u308a\u3001\u3053\u306e\u5024\u306f\u305a\u3063\u3068\u4fdd\u6301\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u306e\u6700\u5f8c\u306b\u6b21\u306e2\u884c\u3092\u8ffd\u52a0\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">word</span> <span class=\"o\">=</span> <span class=\"s1\">'Goodbye'</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">sentence</span><span class=\"p\">)</span>\n</span></code></pre>", "name": "sentence_doesnt_change", "hints": [], "solution": {"tokens": ["word", " ", "=", " ", "'Hello'", "\n", "name", " ", "=", " ", "'World'", "\n", "sentence", " ", "=", " ", "word", " ", "+", " ", "' '", " ", "+", " ", "name", "\n", "print", "(", "sentence", ")", "\n", "word", " ", "=", " ", "'Goodbye'", "\n", "print", "(", "sentence", ")"], "maskedIndices": [22, 29, 39, 6, 28, 27, 16, 4, 26, 2, 40, 8, 38, 37, 0, 31, 12, 10, 18, 14, 33, 20, 24, 35], "mask": [true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, true, true, true, false, true, false, true, false, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": ["Hello World\nHello World", "Hello World\nGoodbye World", "Goodbye World\nGoodbye World", "\u30a8\u30e9\u30fc"], "answer": "Hello World\nHello World"}, "requirements": [{"type": "verbatim"}, {"type": "custom", "message": "<p>\u524d\u306e\u30b9\u30c6\u30c3\u30d7\u306e4\u884c\u306b\u7d9a\u3051\u3066\u3001\u3053\u3053\u306b\u3042\u308b2\u884c\u3092\u8ffd\u52a0\u3057\u305f\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u5b9f\u884c\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"}]}, {"index": 2, "text": "<p>\u8a08\u7b97\u5f0f\u304c\u81ea\u52d5\u3067\u66f4\u65b0\u3055\u308c\u308b\u8868\u8a08\u7b97\u30bd\u30d5\u30c8\uff08\u30b9\u30d7\u30ec\u30c3\u30c9\u30b7\u30fc\u30c8\uff09\u3068\u306f\u9055\u3063\u3066\u3001<code>sentence</code> \u306e\u3088\u3046\u306a\u5909\u6570\u306f\u300c\u3069\u3046\u3084\u3063\u3066\u8a08\u7b97\u3055\u308c\u305f\u304b\u300d\u3092\u899a\u3048\u3066\u3044\u307e\u305b\u3093\u3002\u305d\u306e\u305f\u3081\u3001\u5143\u306b\u306a\u3063\u305f <code>word</code> \u3084 <code>name</code> \u306e\u5024\u3092\u5909\u3048\u3066\u3082\u3001<code>sentence</code> \u306e\u5024\u306f\u81ea\u52d5\u7684\u306b\u306f\u5909\u308f\u3089\u306a\u3044\u306e\u3067\u3059\u3002</p>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}, "IntroducingForLoops": {"slug": "IntroducingForLoops", "title": "For \u30eb\u30fc\u30d7\u306e\u7d39\u4ecb", "index": 8, "step_names": ["first_for_loop", "final_text"], "steps": [{"index": 0, "text": "<p>\u5b09\u3057\u3044\u304a\u77e5\u3089\u305b\u3067\u3059\uff01\u9000\u5c48\u306a\u57fa\u790e\u3092\u4e57\u308a\u8d8a\u3048\u307e\u3057\u305f\u306d\u3002\u3044\u3088\u3044\u3088\u9762\u767d\u3044\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u66f8\u3044\u3066\u3001\u697d\u3057\u3093\u3067\u3044\u304d\u307e\u3057\u3087\u3046\u3002\u30d7\u30ed\u30b0\u30e9\u30df\u30f3\u30b0\u3067\u6700\u3082\u5f37\u529b\u306a\u6982\u5ff5\u306e1\u3064\u304c<em>\u30eb\u30fc\u30d7\uff08\u7e70\u308a\u8fd4\u3057\uff09</em>\u3067\u3059\u3002\u3053\u308c\u3092\u4f7f\u3046\u3068\u3001\u540c\u3058\u30b3\u30fc\u30c9\u3092\u4f55\u5ea6\u3082\u7e70\u308a\u8fd4\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002Python\u306b\u306f\u3001<code>for</code> \u30eb\u30fc\u30d7\u3068 <code>while</code> \u30eb\u30fc\u30d7\u306e2\u7a2e\u985e\u306e\u30eb\u30fc\u30d7\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u3053\u306b for \u30eb\u30fc\u30d7\u306e\u4f8b\u304c\u3042\u308a\u307e\u3059\u306e\u3067\u3001\u3053\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u5b9f\u884c\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">name</span> <span class=\"o\">=</span> <span class=\"s1\">'World'</span>\n<span class=\"k\">for</span> <span class=\"n\">character</span> <span class=\"ow\">in</span> <span class=\"n\">name</span><span class=\"p\">:</span> <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">character</span><span class=\"p\">)</span>\n</span></code></pre>", "name": "first_for_loop", "hints": [], "solution": {"tokens": ["name", " ", "=", " ", "'World'", "\n", "for", " ", "character", " ", "in", " ", "name", ":", " ", "print", "(", "character", ")"], "maskedIndices": [13, 10, 2, 0, 4, 18, 16, 8, 12, 17, 6, 15], "mask": [true, false, true, false, true, false, true, false, true, false, true, false, true, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 1, "text": "<p>\u3053\u306e\u30b3\u30fc\u30c9\u306f\u3001\u666e\u901a\u306e\u82f1\u8a9e\u306e\u3088\u3046\u306b\u8aad\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3088\uff1a</p>\n<blockquote>\n<p>For each character in the string <code>name</code>, print that character.\uff08\u6587\u5b57\u5217 <code>name</code> \u306e\u4e2d\u306e\u5404\u6587\u5b57\uff08character\uff09\u306b\u3064\u3044\u3066\u3001\u305d\u306e\u6587\u5b57\u3092\u51fa\u529b\u3059\u308b\uff09</p>\n</blockquote>\n<p>\u305d\u308c\u305e\u308c\u306e\u6587\u5b57\u306f\u3001\u305f\u3060\u306e\u666e\u901a\u306e\u6587\u5b57\u5217\u3067\u3059\u3002<code>character</code> \u306f\u666e\u901a\u306e\u5909\u6570\u3067\u3001<code>:</code> \u306e\u5f8c\u308d\u306e\u30b3\u30fc\u30c9\u304c\u5b9f\u884c\u3055\u308c\u308b\u524d\u306b\u65b0\u3057\u3044\u5024\u304c\u4ee3\u5165\u3055\u308c\u307e\u3059\u3002\u3064\u307e\u308a\u3001\u4e0a\u306e\u30b3\u30fc\u30c9\u306f\u6b21\u3068\u540c\u3058\u610f\u5473\u306b\u306a\u308a\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">name</span> <span class=\"o\">=</span> <span class=\"s1\">'World'</span>\n\n<span class=\"n\">character</span> <span class=\"o\">=</span> <span class=\"s1\">'W'</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">character</span><span class=\"p\">)</span>\n\n<span class=\"n\">character</span> <span class=\"o\">=</span> <span class=\"s1\">'o'</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">character</span><span class=\"p\">)</span>\n\n<span class=\"n\">character</span> <span class=\"o\">=</span> <span class=\"s1\">'r'</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">character</span><span class=\"p\">)</span>\n\n<span class=\"n\">character</span> <span class=\"o\">=</span> <span class=\"s1\">'l'</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">character</span><span class=\"p\">)</span>\n\n<span class=\"n\">character</span> <span class=\"o\">=</span> <span class=\"s1\">'d'</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">character</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\u5225\u306e\u5909\u6570\u540d\u3092\u4f7f\u3046\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u304c\u3001<code>character</code> \u3068\u540d\u4ed8\u3051\u3066\u304a\u304f\u3068\u5206\u304b\u308a\u3084\u3059\u3044\u3067\u3059\u306d\u3002</p>\n<p>for \u30eb\u30fc\u30d7\u306f\u57fa\u672c\u7684\u306b\u6b21\u306e\u3088\u3046\u306a\u69cb\u9020\u3092\u3057\u3066\u3044\u307e\u3059\uff1a</p>\n<pre><code>for &lt;variable&gt; in &lt;collection&gt;: &lt;code to repeat&gt;\n</code></pre>\n<p><code>for</code>\u3001<code>in</code>\u3001\u305d\u3057\u3066 <code>:</code> \u306f\u3069\u308c\u3082\u6b20\u304b\u305b\u306a\u3044\u8981\u7d20\u3067\u3059\u3002</p>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}, "Indentation": {"slug": "Indentation", "title": "\u30a4\u30f3\u30c7\u30f3\u30c8", "index": 9, "step_names": ["missing_indentation", "two_indented_lines", "one_indented_line", "mismatched_indentations", "final_text"], "steps": [{"index": 0, "text": "<p>\u5148\u307b\u3069\u306e\u30eb\u30fc\u30d7\u306e\u4f8b\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">for</span> <span class=\"n\">character</span> <span class=\"ow\">in</span> <span class=\"n\">name</span><span class=\"p\">:</span> <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">character</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\u3053\u308c\u3067\u3082\u52d5\u304d\u307e\u3059\u304c\u3001\u5b9f\u969b\u306b\u306f\u666e\u6bb5\uff08\u305d\u3057\u3066\u305d\u3046\u66f8\u304f\u3079\u304d\u306a\u306e\u3067\u3059\u304c\uff09\u3053\u306e\u3088\u3046\u306b\u66f8\u304d\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">for</span> <span class=\"n\">character</span> <span class=\"ow\">in</span> <span class=\"n\">name</span><span class=\"p\">:</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">character</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\u5177\u4f53\u7684\u306b\u306f\u3001\u7e70\u308a\u8fd4\u3057\u305f\u3044\u30b3\u30fc\u30c9\uff08<em>body</em> \u307e\u305f\u306f\u300c\u30eb\u30fc\u30d7\u672c\u4f53\u300d\u3068\u547c\u3070\u308c\u307e\u3059\uff09\u306f\u30b3\u30ed\u30f3\uff08<code>:</code>\uff09\u306e\u5f8c\u306e\u65b0\u3057\u3044\u884c\u304b\u3089\u59cb\u3081\u3066\u3001\u5fc5\u305a<em>\u30a4\u30f3\u30c7\u30f3\u30c8</em>\uff08\u5b57\u4e0b