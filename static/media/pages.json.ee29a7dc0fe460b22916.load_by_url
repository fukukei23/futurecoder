><span class=\"n\">board</span><span class=\"p\">[</span><span class=\"mi\">0</span><span class=\"p\">][</span><span class=\"mi\">0</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"s1\">'X'</span>\n<span class=\"n\">board</span><span class=\"p\">[</span><span class=\"mi\">1</span><span class=\"p\">][</span><span class=\"mi\">0</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"s1\">'X'</span>\n<span class=\"n\">board</span><span class=\"p\">[</span><span class=\"mi\">2</span><span class=\"p\">][</span><span class=\"mi\">0</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"s1\">'X'</span>\n</span></code></pre>\n<p>\u4f55\u304c\u8d77\u304d\u3066\u3044\u308b\u306e\u304b\u3001\u81ea\u5206\u3067\u539f\u56e0\u3092\u7a81\u304d\u6b62\u3081\u3066\u307f\u307e\u3057\u3087\u3046\u3002\n\u305f\u3060\u3001\u3053\u308c\u306f\u304b\u306a\u308a\u5f15\u3063\u304b\u304b\u308a\u3084\u3059\u3044\u3068\u3053\u308d\u306a\u306e\u3067\u3001\u601d\u3044\u8a70\u3081\u3059\u304e\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u306d\u3002</p>\n<p>\u3082\u3057\u3088\u3051\u308c\u3070\u3001\u3044\u304f\u3064\u304b\u30d2\u30f3\u30c8\u3092\u51fa\u3057\u307e\u3059\uff1a</p>\n<ul>\n<li>\u30c7\u30d0\u30c3\u30ac\u3092\u4f7f\u3063\u3066\u30b3\u30fc\u30c9\u3092\u5b9f\u884c\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002</li>\n<li>\u5b9f\u9a13\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u30b3\u30fc\u30c9\u3092\u5909\u66f4\u3057\u3066\u4f55\u304c\u8d77\u304d\u308b\u304b\u898b\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002</li>\n<li>\u3044\u3044\u3048\u3001\u30b3\u30fc\u30c9\u306f\u4e0a\u3067\u66f8\u3044\u305f\u3088\u3046\u306a3\u56de\u306e\u4ee3\u5165\u3092\u884c\u3063\u305f\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u30ea\u30b9\u30c8\u3078\u306e\u4ee3\u5165\u306f1\u56de\u3060\u3051\u3067\u3057\u305f\u3002</li>\n<li>\u96a0\u308c\u305f\u30eb\u30fc\u30d7\u306a\u3069\u306f\u3042\u308a\u307e\u305b\u3093\u3002</li>\n<li><code>board</code> \u306b\u306f\u3044\u304f\u3064\u306e\u30ea\u30b9\u30c8\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u304b\uff1f 3\u3064\u3067\u3057\u3087\u3046\u304b\uff1f</li>\n<li>\u524d\u306e\u30da\u30fc\u30b8\u306b\u3001\u4f55\u304c\u8d77\u304d\u305f\u304b\u306b\u3064\u3044\u3066\u306e\u3055\u308a\u3052\u306a\u3044\u30d2\u30f3\u30c8\u304c\u3042\u308a\u307e\u3059\u3002</li>\n<li>\u524d\u306e\u7ae0\u306b\u3001\u3053\u306e\u7a2e\u306e\u554f\u984c\u3092\u76f4\u63a5\u89e3\u8aac\u3057\u3066\u3044\u308b\u30da\u30fc\u30b8\u304c\u3042\u308a\u307e\u3059\u3002</li>\n<li>\u5177\u4f53\u7684\u306b\u306f<a href=\"#EqualsVsIs\">\u3053\u306e\u30da\u30fc\u30b8</a>\u3067\u3059\u3002</li>\n<li>Python Tutor \u3067\u30b3\u30fc\u30c9\u3092\u5b9f\u884c\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002</li>\n</ul>\n<p>\u3055\u3066\u3001\u6e96\u5099\u304c\u3067\u304d\u305f\u3089\u7b54\u3048\u5408\u308f\u305b\u3067\u3059\u3002</p>\n<p>\u30ea\u30b9\u30c8 <code>row</code> \u306f1\u56de\u3057\u304b\u4f5c\u6210\u3055\u308c\u3066\u304a\u3089\u305a\u3001\u305d\u308c\u304c\u4f55\u56de\u3082\u518d\u5229\u7528\u3055\u308c\u3066\u3044\u307e\u3057\u305f\u3002\n<code>board</code> \u306b\u306f\u300c\u307e\u3063\u305f\u304f\u540c\u3058\u30ea\u30b9\u30c8\u300d\u304c3\u3064\u5165\u3063\u3066\u3044\u307e\u3059\u3002\u30b3\u30d4\u30fc\u3067\u306f\u306a\u304f\u30011\u3064\u306e\u30ea\u30b9\u30c8\u304c3\u7b87\u6240\u306b\u3042\u308b\u3060\u3051\u306a\u306e\u3067\u3059\u3002\n\u3064\u307e\u308a\u3001\u3053\u3046\u3044\u3046\u3053\u3068\u3092\u3057\u305f\u306e\u3068\u540c\u3058\u3067\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">board</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"n\">row</span><span class=\"p\">,</span> <span class=\"n\">row</span><span class=\"p\">,</span> <span class=\"n\">row</span><span class=\"p\">]</span>\n</span></code></pre>\n<p>\u3068\u3044\u3046\u3053\u3068\u306f\u3001\u3053\u306e\u30b3\u30fc\u30c9\u306f\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">board</span><span class=\"p\">[</span><span class=\"mi\">0</span><span class=\"p\">][</span><span class=\"mi\">0</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"s1\">'X'</span>\n</span></code></pre>\n<p>\u3053\u308c\u3068\u540c\u3058\u610f\u5473\u306b\u306a\u308a\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">row</span><span class=\"p\">[</span><span class=\"mi\">0</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"s1\">'X'</span>\n</span></code></pre>\n<p>\u305d\u3057\u3066\u3001\u3059\u3079\u3066\u304c\u540c\u30581\u3064\u306e\u30ea\u30b9\u30c8 <code>row</code> \u306a\u306e\u3067\u3001<code>board</code> \u306e\u300c\u3059\u3079\u3066\u306e\u30ea\u30b9\u30c8\u300d\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u3066\u3057\u307e\u3046\u306e\u3067\u3059\u3002\n\u8a00\u3044\u63db\u3048\u308b\u3068\u3001\u4e0a\u306e\u884c\u306f\u6b21\u306e2\u3064\u306e\u884c\u306e\u305d\u308c\u305e\u308c<em>\u3068\u3082</em>\u540c\u3058\u610f\u5473\u306b\u306a\u308a\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">board</span><span class=\"p\">[</span><span class=\"mi\">1</span><span class=\"p\">][</span><span class=\"mi\">0</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"s1\">'X'</span>\n<span class=\"n\">board</span><span class=\"p\">[</span><span class=\"mi\">2</span><span class=\"p\">][</span><span class=\"mi\">0</span><span class=\"p\">]</span> <span class=\"o\">=</span> <span class=\"s1\">'X'</span>\n</span></code></pre>\n<p>\u306a\u305c\u306a\u3089\u3001<code>row</code> \u306f <code>board[0]</code>\u3001<code>board[1]</code>\u3001<code>board[2]</code> \u306e\u3059\u3079\u3066\u3067\u3082\u3042\u308b\u304b\u3089\u3067\u3059\u3002</p>\n<p>\u3042\u306a\u305f\u306e\u4eca\u56de\u306e\u5f79\u76ee\u306f\u3001\u3053\u306e\u554f\u984c\u304c\u8d77\u304d\u306a\u3044\u3088\u3046\u306b <code>make_board</code> \u3092\u4fee\u6b63\u3059\u308b\u3053\u3068\u3067\u3059\u3002\n\u9577\u3055 <code>size</code> \u306e\u30ea\u30b9\u30c8\u3092\u8fd4\u3057\u3001\u305d\u306e\u5404\u8981\u7d20\u3082\u307e\u305f\u6587\u5b57\u5217 <code>' '</code> \u3092\u8981\u7d20\u306b\u6301\u3064\n\u9577\u3055 <code>size</code> \u306e\u30ea\u30b9\u30c8\u3067\u3042\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\n\u30b5\u30d6\u30ea\u30b9\u30c8\u306f\u540c\u3058\u30ea\u30b9\u30c8\u306e\u7e70\u308a\u8fd4\u3057\u3067\u306f\u306a\u304f\u3001\u3059\u3079\u3066\u72ec\u7acb\u3057\u305f\u5225\u3005\u306e\u30ea\u30b9\u30c8\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3067\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002</p>", "name": "fix_make_board", "hints": ["<p>\u4eca\u306e\u30b3\u30fc\u30c9\u306f\u3042\u3068\u4e00\u6b69\u3067\u6b63\u89e3\u3067\u3059\u3002</p>", "<p>\u3053\u308c\u3092\u89e3\u6c7a\u3059\u308b\u65b9\u6cd5\u306f\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u5c11\u3057\u4f55\u304b\u3092\u8ffd\u52a0\u3059\u308b\u3060\u3051\u3067\u89e3\u6c7a\u3067\u304d\u308b\u65b9\u6cd5\u3082\u3042\u308a\u307e\u3059\u3002</p>", "<p>\uff08\u30b9\u30da\u30fc\u30b9\u4ee5\u5916\u306f\uff09\u4f55\u3082\u8ffd\u52a0\u3057\u305f\u308a\u524a\u9664\u3057\u305f\u308a\u305b\u305a\u3001\u30b3\u30fc\u30c9\u3092\u4e26\u3079\u66ff\u3048\u308b\u3060\u3051\u3067\u3082\u89e3\u6c7a\u3067\u304d\u307e\u3059\u3002</p>", "<p>\u554f\u984c\u306f\u3001\u5358\u4e00\u306e\u30ea\u30b9\u30c8 <code>row</code> \u304c\u4f55\u56de\u3082\u4f7f\u3044\u56de\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3067\u3059\u3002</p>", "<p>\u3067\u3059\u306e\u3067\u3001\u89e3\u6c7a\u7b56\u306e1\u3064\u306f\u3001\u3059\u3079\u3066\u72ec\u7acb\u3057\u305f\u5225\u3005\u306e <code>row</code> \u306e\u30b3\u30d4\u30fc\u3092\u4f5c\u308b\u3053\u3068\u3067\u3059\u3002</p>", "<p>\u3082\u30461\u3064\u306e\u89e3\u6c7a\u7b56\u306f\u3001\u6bce\u56de\u30bc\u30ed\u304b\u3089\u65b0\u3057\u3044 <code>row</code> \u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u3067\u3059\u3002</p>", "<p>Python\u3067\u306f\u3001\u307b\u3093\u306e\u77ed\u3044\u30b3\u30fc\u30c9\u3067\u30ea\u30b9\u30c8\u3092\u30b3\u30d4\u30fc\u3059\u308b\u65b9\u6cd5\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u6bce\u56de\u65b0\u3057\u3044\u884c\uff08row\uff09\u3092\u4f5c\u308b\u306e\u306f\u3001\u30b3\u30fc\u30c9\u3092\u4e26\u3079\u66ff\u3048\u308b\u3060\u3051\u3067\u5b9f\u73fe\u3067\u304d\u307e\u3059\u3002</p>"], "solution": {"tokens": ["def", " ", "make_board", "(", "size", ")", ":", "\n", "    ", "board", " ", "=", " ", "[", "]", "\n", "    ", "for", " ", "_", " ", "in", " ", "range", "(", "size", ")", ":", "\n", "        ", "row", " ", "=", " ", "[", "]", "\n", "        ", "for", " ", "_", " ", "in", " ", "range", "(", "size", ")", ":", "\n", "            ", "row", ".", "append", "(", "' '", ")", "\n", "        ", "board", ".", "append", "(", "row", ")", "\n", "    ", "return", " ", "board"], "maskedIndices": [40, 53, 44, 45, 48, 62, 32, 47, 61, 34, 30, 55, 46, 23, 69, 25, 2, 17, 54, 14, 38, 35, 63, 26, 19, 13, 0, 21, 56, 59, 64, 27, 3, 6, 9, 11, 60, 42, 5, 52, 67, 4, 24, 51], "mask": [true, false, true, true, true, true, true, false, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, true, true, true, false, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, true, true, true, false, false, true, true, true, true, true, true, false, false, true, true, true, true, true, true, false, false, true, false, true], "lines": [{"id": "5", "content": "            <span class=\"n\">row</span><span class=\"o\">.</span><span class=\"n\">append</span><span class=\"p\">(</span><span class=\"s1\">&#39; &#39;</span><span class=\"p\">)</span>"}, {"id": "1", "content": "    <span class=\"n\">board</span> <span class=\"o\">=</span> <span class=\"p\">[]</span>"}, {"id": "6", "content": "        <span class=\"n\">board</span><span class=\"o\">.