, "mask": [true, false, true, false, true, false, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true, true, false, false, true, false, true, true, false, false, true, false, true, false, true, false, false, true, false, true, false, true, false, false, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}, {"type": "custom", "message": "<p>\u524d\u306e\u30b9\u30c6\u30c3\u30d7\u3068\u540c\u3058\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u5b9f\u884c\u3057\u307e\u3059\u304c\u3001\u300cRun\u300d\u30dc\u30bf\u30f3\u3067\u306f\u306a\u304f <code>snoop</code> \u30dc\u30bf\u30f3\u3092\u4f7f\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b3\u30fc\u30c9\u3092\u5909\u66f4\u3057\u3066\u3057\u307e\u3063\u3066\u3044\u305f\u3089\u3001\u3082\u3046\u4e00\u5ea6\u30b3\u30d4\u30fc\u3057\u3066\u304f\u3060\u3055\u3044\u306d\u3002</p>"}, {"type": "custom", "message": "<p>\u30a8\u30c7\u30a3\u30bf\u306b\u30b3\u30fc\u30c9\u3092\u66f8\u3044\u305f\u72b6\u614b\u3067\u3001<code>snoop</code> \u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"}]}, {"index": 2, "text": "<p>\u3058\u3083\u30fc\u3093\uff01\u30bf\u30fc\u30df\u30ca\u30eb\u306e\u4e0a\u307e\u3067\u30b9\u30af\u30ed\u30fc\u30eb\u3057\u3066\u3001<code>snoop</code> \u304c\u4f55\u3092\u8868\u793a\u3057\u3066\u304f\u308c\u3066\u3044\u308b\u306e\u304b\u4e00\u7dd2\u306b\u898b\u3066\u3044\u304d\u307e\u3057\u3087\u3046\u3002\n\u6700\u521d\u306f\u3068\u3066\u3082\u30b7\u30f3\u30d7\u30eb\u306b\u59cb\u307e\u308a\u307e\u3059\uff1a</p>\n<pre><code>    1 | sentence = 'Hello World'\n    3 | include = False\n    4 | new_sentence = ''\n    5 | for char in sentence:\n ...... char = 'H'\n</code></pre>\n<p>\u6700\u521d\u306e\u6570\u884c\u306f\u3001\u30b3\u30f3\u30d4\u30e5\u30fc\u30bf\u304c\u5b9f\u884c\u3057\u305f\u30d7\u30ed\u30b0\u30e9\u30e0\u306e\u884c\u3092\u305d\u306e\u307e\u307e\u898b\u305b\u3066\u304f\u308c\u3066\u3044\u307e\u3059\u3002\n\u5de6\u5074\u306b\u3042\u308b\u306e\u306f\u3001\u30a8\u30c7\u30a3\u30bf\u4e0a\u3067\u306e\u884c\u756a\u53f7\u3067\u3059\u3002</p>\n<p><code>for char in sentence:</code> \u3092\u5b9f\u884c\u3059\u308b\u3068\u5909\u6570 <code>char</code> \u306b\u5024\u304c\u4ee3\u5165\u3055\u308c\u308b\u306e\u3067\u3001<code>snoop</code> \u306f\u305d\u306e\u5024\u3092\u8868\u793a\u3057\u3066\u304f\u308c\u307e\u3059\u3002\n<code>......</code> \u3067\u59cb\u307e\u308b\u884c\u306f\u3001\u65b0\u3057\u3044\u5909\u6570\u304c\u4f5c\u3089\u308c\u305f\u308a\u3001\u3059\u3067\u306b\u3042\u308b\u5909\u6570\u306e\u5024\u304c\u5909\u308f\u3063\u305f\u308a\u3057\u305f\u3053\u3068\u3092\u8868\u3057\u3066\u3044\u307e\u3059\u3002\n\u91cd\u8907\u3057\u3066\u5206\u304b\u308a\u304d\u3063\u3066\u3044\u308b\u5834\u5408\u306f\u8868\u793a\u3055\u308c\u306a\u3044\u3088\u3046\u306b\u306a\u3063\u3066\u3044\u308b\u306e\u3067\u3001<code>snoop</code> \u306e\u51fa\u529b\u306f\u6b21\u306e\u3088\u3046\u306b\u306f\u59cb\u307e\u308a\u307e\u305b\u3093\uff1a</p>\n<pre><code>    1 | sentence = 'Hello World'\n ...... sentence = 'Hello World'\n    3 | include = False\n ...... include = False\n    4 | new_sentence = ''\n ...... new_sentence = ''\n    5 | for char in sentence:\n ...... char = 'H'\n</code></pre>\n<p>\u6b21\u306e2\u884c\u306f\u3053\u3061\u3089\u3067\u3059\uff1a</p>\n<pre><code>    6 |     if include:\n    8 |     include = True\n</code></pre>\n<p>\u3053\u3053\u3067\u5927\u4e8b\u306a\u306e\u306f\u300c\u4f55\u304c\u8868\u793a\u3055\u308c\u3066\u3044\u306a\u3044\u304b\u300d\u3067\u3059\u3002<code>include</code> \u304c <code>False</code> \u306a\u306e\u3067\u30017\u884c\u76ee\uff08<code>new_sentence += char</code>\uff09\u306f\u30b9\u30ad\u30c3\u30d7\u3055\u308c\u307e\u3057\u305f\u3002\u3057\u304b\u3057\u305d\u306e\u3042\u3068 <code>include</code> \u304c <code>True</code> \u306b\u8a2d\u5b9a\u3055\u308c\u308b\u305f\u3081\u3001\u30eb\u30fc\u30d7\u306e\u6b21\u306e\u5468\uff082\u56de\u76ee\uff09\u3067\u306f\u52d5\u304d\u304c\u5909\u308f\u308a\u307e\u3059\uff1a</p>\n<pre><code>    5 | for char in sentence:\n ...... char = 'e'\n    6 |     if include:\n    7 |         new_sentence += char\n .............. new_sentence = 'e'\n</code></pre>\n<p><code>new_sentence += char</code> \u304c\u521d\u3081\u3066\u5b9f\u884c\u3055\u308c\u3001\u5909\u6570 <code>new_sentence</code> \u306b\u65b0\u3057\u3044\u5024\u304c\u5165\u308a\u307e\u3057\u305f\u3002</p>\n<p>\u3067\u306f\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u4fee\u6b63\u3057\u3066\u9006\u306e\u3053\u3068\u3092\u3084\u3063\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u6700\u521d\u306e1\u6587\u5b57\u3060\u3051\u3092\u51fa\u529b\u3057\u3066\u3001\u6b8b\u308a\u306f\u9664\u5916\u3059\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "name": "print_first_character", "hints": ["<p>\u30b3\u30fc\u30c9\u306f\u307b\u307c\u540c\u3058\u307e\u307e\u3067\u5927\u4e08\u592b\u3067\u3059\u3002\u5c11\u3057\u3060\u3051\u5909\u66f4\u3092\u52a0\u3048\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "<p><code>if include:</code> \u306e\u4e2d\u306e\u30b3\u30fc\u30c9\u304c\u3001\u30eb\u30fc\u30d7\u306e\u6700\u521d\uff081\u56de\u76ee\u306e\u7e70\u308a\u8fd4\u3057\uff09\u3067\u5b9f\u884c\u3055\u308c\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u3064\u307e\u308a\u3001\u305d\u306e\u6642\u70b9\u3067\u306f <code>include</code> \u304c <code>True</code> \u306b\u306a\u3063\u3066\u3044\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>1\u56de\u76ee\u306e\u7e70\u308a\u8fd4\u3057\u306e\u5f8c\u306f\u3001<code>if include:</code> \u306e\u4e2d\u306e\u30b3\u30fc\u30c9\u304c\u5b9f\u884c<em>\u3055\u308c\u306a\u3044</em>\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u3064\u307e\u308a\u30011\u56de\u76ee\u306e\u7e70\u308a\u8fd4\u3057\u306e\u5f8c\u306f <code>include</code> \u304c <code>False</code> \u306b\u306a\u3063\u3066\u3044\u308b\u5fc5\u8981