f\u9055\u3063\u3066\u3001\n<code>not</code> \u306f1\u3064\u306eboolean\u306e\u524d\u306b\u7f6e\u3044\u3066\u4f7f\u3044\u307e\u3059\uff08<em>\u5358\u9805</em>\u6f14\u7b97\u5b50\u3068\u547c\u3070\u308c\u307e\u3059\uff09\u3002\n\u3053\u308c\u306f\u30de\u30a4\u30ca\u30b9\u8a18\u53f7\u306e\u3088\u3046\u306b\u3001\u9069\u7528\u3055\u308c\u305f\u5f0f\u3092\u53cd\u8ee2\uff08\u5426\u5b9a\uff09\u3055\u305b\u307e\u3059\u3002\u30b7\u30a7\u30eb\u3067\u8a66\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"ow\">not</span> <span class=\"kc\">True</span>\n</span></code></pre>", "name": "IntroducingNot", "hints": [], "solution": {"tokens": ["not", " ", "True"], "maskedIndices": [2, 0], "mask": [true, false, true], "lines": null}, "prediction": {"choices": ["True", "False", "\u30a8\u30e9\u30fc"], "answer": "False"}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 1, "text": "<p>\u3067\u306f\u3001\u6b21\u3092\u8a66\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"ow\">not</span> <span class=\"kc\">False</span>\n</span></code></pre>", "name": "NotFalse", "hints": [], "solution": {"tokens": ["not", " ", "False"], "maskedIndices": [0, 2], "mask": [true, false, true], "lines": null}, "prediction": {"choices": ["True", "False", "\u30a8\u30e9\u30fc"], "answer": "True"}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 2, "text": "<p><code>not</code> \u306e\u512a\u5148\u5ea6\u306f <code>and</code> \u3084 <code>or</code> \u3068\u6bd4\u3079\u3066\u3069\u3046\u306a\u3063\u3066\u3044\u308b\u3067\u3057\u3087\u3046\u304b\uff1f<code>birdseye</code> \u3067\u6b21\u3092\u8a66\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">b</span> <span class=\"o\">=</span> <span class=\"kc\">True</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"ow\">not</span> <span class=\"n\">b</span> <span class=\"ow\">or</span> <span class=\"n\">b</span><span class=\"p\">)</span>\n</span></code></pre>", "name": "NotTrueOrTrue", "hints": [], "solution": {"tokens": ["b", " ", "=", " ", "True", "\n", "print", "(", "not", " ", "b", " ", "or", " ", "b", ")"], "maskedIndices": [4, 10, 14, 15, 6, 8, 12, 7, 0, 2], "mask": [true, false, true, false, true, false, true, true, true, false, true, false, true, false, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}, {"type": "custom", "message": "<p>\u30a8\u30c7\u30a3\u30bf\u306b\u30b3\u30fc\u30c9\u3092\u66f8\u3044\u305f\u72b6\u614b\u3067\u3001<code>birdseye</code> \u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"}]}, {"index": 3, "text": "<p><code>birdseye</code> \u3092\u898b\u308b\u3068\u3001</p>\n<pre><code class=\"codehilite\"><span><span class=\"ow\">not</span> <span class=\"kc\">True</span> <span class=\"ow\">or</span> <span class=\"kc\">True</span>\n</span></code></pre>\n<p>\u304cPython\u306b\u3088\u3063\u3066</p>\n<pre><code class=\"codehilite\"><span><span class=\"ow\">not</span> <span class=\"p\">(</span><span class=\"kc\">True</span> <span class=\"ow\">or</span> <span class=\"kc\">True</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\u3067\u306f\u306a\u304f\u3001\u6b21\u306e\u3088\u3046\u306b\u89e3\u91c8\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u304c\u5206\u304b\u308a\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"p\">(</span><span class=\"ow\">not</span> <span class=\"kc\">True</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"kc\">True</span>\n</span></code></pre>\n<p>\u3064\u307e\u308a\u3001\u304b\u3063\u3053\u304c\u306a\u3044\u5834\u5408\u3001<code>not</code> \u306f <code>or</code> \u3088\u308a\u3082\u512a\u5148\u5ea6\u304c\u9ad8\u3044\u306e\u3067\u3059\u3002\u3053\u308c\u306f\u3061\u3087\u3046\u3069\u3001</p>\n<pre><code class=\"codehilite\"><span><span class=\"o\">-</span><span class=\"mi\">1</span> <span class=\"o\">+</span> <span class=\"mi\">2</span>\n</span></code></pre>\n<p>\u304c</p>\n<pre><code class=\"codehilite\"><span><span class=\"o\">-</span><span class=\"p\">(</span><span class=\"mi\">1</span> <span class=\"o\">+</span> <span class=\"mi\">2</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\u3067\u306f\u306a\u304f\u3001\u6b21\u306e\u610f\u5473\u306b\u306a\u308b\u306e\u3068\u540c\u3058\u3067\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"p\">(</span><span class=\"o\">-</span><span class=\"mi\">1</span><span class=\"p\">)</span> <span class=\"o\">+</span> <span class=\"mi\">2</span>\n</span></code></pre>\n<p><code>not</code> \u306f <code>and</code> \u3088\u308a\u3082\u512a\u5148\u5ea6\u304c\u9ad8\u3044\u3067\u3059\u3002</p>\n<p>\u7e70\u308a\u8fd4\u3057\u307e\u3059\u304c\u3001\u8ff7\u3063\u305f\u3068\u304d\u306f\u304b\u3063\u3053\u3092\u4f7f\u3063\u305f\u308a\u3001\u5225\u306e\u5909\u6570\u306b\u5206\u3051\u305f\u308a\u3059\u308b\u306e\u304c\u4e00\u756a\u5927\u4e8b\u306a\u30dd\u30a4\u30f3\u30c8\u3067\u3059\u3088\u3002</p>\n<p>\u7df4\u7fd2\u554f\u984c\uff1a\u753b\u50cf\u3092\u51e6\u7406\u3059\u308b\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u66f8\u3044\u3066\u3044\u308b\u3068\u3057\u307e\u3057\u3087\u3046\u3002\u7279\u5b9a\u306e\u7a2e\u985e\u306e\u30d5\u30a1\u30a4\u30eb\u3057\u304b\u51e6\u7406\u3067\u304d\u307e\u305b\u3093\u3002\n\u3082\u3057\u30e6\u30fc\u30b6\u30fc\u304c\u51e6\u7406\u3067\u304d\u306a\u3044\u30d5\u30a1\u30a4\u30eb\u3092\u6307\u5b9a\u3057\u305f\u5834\u5408\u3001\u30a8\u30e9\u30fc\u3092\u8868\u793a\u3057\u305f\u3044\u3068\u3057\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">if</span> <span class=\"n\">invalid_image</span><span class=\"p\">(</span><span class=\"n\">filename</span><span class=\"p\">):</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s2\">\"I can't process \"</span> <span class=\"o\">+</span> <span class=\"n\">filename</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>.png \u3068 .jpg \u30d5\u30a1\u30a4\u30eb\u306f\u51e6\u7406\u3067\u304d\u307e\u3059\u304c\u3001\u4ed6\u306e\u30d5\u30a1\u30a4\u30eb\u5f62\u5f0f\u306f\u51e6\u7406\u3067\u304d\u306a\u3044\u3068\u4eee\u5b9a\u3057\u307e\u3059\u3002\n\u3053\u308c\u3092\u884c\u3046\u95a2\u6570\u306e\u4f8b\u304c\u3053\u3061\u3089\u3067\u3059\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"k\">def</span> <span class=\"nf\">invalid_image</span><span class=\"p\">(</span><span class=\"n\">filename</span><span class=\"p\">):</span>\n    <span class=\"k\">if</span> <span class=\"n\">filename</span><span class=\"o\">.</span><span class=\"n\">endswith</span><span class=\"p\">(</span><span class=\"s2\">\".png\"</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"n\">filename</span><span class=\"o\">.</span><span class=\"n\">endswith</span><span class=\"p\">(</span><span class=\"s2\">\".jpg\"</span><span class=\"p\">):</span>\n        <span class=\"k\">return</span> <span class=\"kc\">False</span>\n    <span class=\"k\">else</span><span class=\"p\">:</span>\n        <span class=\"k\">return</span> <span class=\"kc\">True</span>\n\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">invalid_image</span><span class=\"p\">(</span><span class=\"s2\">\"dog.png\"</span><span class=\"p\">),</span> <span class=\"kc\">False</span><span class=\"p\">)</span>\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">invalid_image</span><span class=\"p\">(</span><span class=\"s2\">\"cat.jpg\"</span><span class=\"p\">),</span> <span class=\"kc\">False</span><span class=\"p\">)</span>\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">invalid_image</span><span class=\"p\">(</span><span class=\"s2\">\"invoice.pdf\"</span><span class=\"p\">),</span> <span class=\"kc\">True</span><span class=\"p\">)</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p>\u3053\u308c\u306f\u5fc5\u8981\u4ee5\u4e0a\u306b\u9577\u304f\u306a\u3063\u3066\u3044\u307e\u3059\u306d\u3002\u4e2d\u8eab\u304c <code>return &lt;\u5f0f&gt;</code> \u306e1\u884c\u3060\u3051\u306b\u306a\u308b\u3088\u3046\u306b\uff08\u3064\u307e\u308a <code>if</code> \u6587\u3092\u4f7f\u308f\u305a\u306b\uff09<code>invalid_image</code> \u3092\u66f8\u304d\u76f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u540c\u3058\u30c6\u30b9\u30c8\u306b\u5408\u683c\u3059\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002</p>", "name": "NotPriority", "hints": ["<p>\u3082\u3057\u4ee3\u308f\u308a\u306b\u3001\u3053\u308c\u3068\u95a2\u9023\u3059\u308b\u53cd\u5bfe\u306e\u95a2\u6570\u3092\u30b7\u30f3\u30d7\u30eb\u306b\u3059\u308b\u3088\u3046\u6c42\u3081\u3089\u308c\u305f\u3089\u3069\u3046\u3067\u3057\u3087\u3046\u304b\uff1f</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">valid_image</span><span class=\"p\">(</span><span class=\"n\">filename</span><span class=\"p\">):</span>\n    <span class=\"k\">if</span> <span class=\"n\">filename</span><span class=\"o\">.</span><span class=\"n\">endswith</span><span class=\"p\">(</span><span class=\"s2\">\".png\"</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"n\">filename</span><span class=\"o\">.</span><span class=\"n\">endswith</span><span class=\"p\">(</span><span class=\"s2\">\".jpg\"</span><span class=\"p\">):</span>\n        <span class=\"k\">return</span> <span class=\"kc\">True</span>\n    <span class=\"k\">else</span><span class=\"p\">:</span>\n        <span class=\"k\">return</span> <span class=\"kc\">False</span>\n\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">valid_image</span><span class=\"p\">(</span><span class=\"s2\">\"dog.png\"</span><span class=\"p\">),</span> <span class=\"kc\">True</span><span class=\"p\">)</span>\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">valid_image</span><span class=\"p\">(</span><span class=\"s2\">\"cat.jpg\"</span><span class=\"p\">),</span> <span class=\"kc\">True</span><span class=\"p\">)</span>\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span><span class=\"n\">valid_image</span><span class=\"p\">(</span><span class=\"s2\">\"invoice.pdf\"</span><span class=\"p\">),</span> <span class=\"kc\">False</span><span class=\"p\">)</span>\n</span></code></pre>", "<p>\u305d\u306e\u5834\u5408\u3001\u6570\u30da\u30fc\u30b8\u524d\u3067\u5b66\u3093\u3060\u6a19\u6e96\u7684\u306a\u5358\u7d14\u5316\u306e\u30b3\u30c4\u304c\u4f7f\u3048\u307e\u3059\u3002</p>", "<p>\u5177\u4f53\u7684\u306b\u306f\u3001<code>filename.endswith(\".png\") or filename.endswith(\".jpg\")</code> \u81ea\u4f53\u304c\u3059\u3067\u306b\u6c42\u3081\u305f\u3044boolean\u5024\u306b\u306a\u3063\u3066\u3044\u308b\u306e\u3067\u3001<code>return</code> \u3092\u5206\u3051\u3066\u66f8\u304f\u306e\u306f\u5197\u9577\u3067\u3059\u3002</p>", "<p>\u306a\u306e\u3067\u3001\u3053\u3046\u66f8\u304f\u3060\u3051\u3067OK\u3067\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">valid_image</span><span class=\"p\">(</span><span class=\"n\">filename</span><span class=\"p\">):</span>\n    <span class=\"k\">return</span> <span class=\"n\">filename</span><span class=\"o\">.</span><span class=\"n\">endswith</span><span class=\"p\">(</span><span class=\"s2\">\".png\"</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"n\">filename</span><span class=\"o\">.</span><span class=\"n\">endswith</span><span class=\"p\">(</span><span class=\"s2\">\".jpg\"</span><span class=\"p\">)</span>\n</span></code></pre>", "<p>\u4eca\u56de\u306e\u7df4\u7fd2\u554f\u984c\u3067\u3082\u3001\u540c\u3058\u3088\u3046\u306a\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3088\u3002</p>", "<p>\u4eca\u56de\u306e\u554f\u984c\u3067\u9055\u3046\u306e\u306f\u3001\u7d50\u679c\u304c\u9006\uff08\u53cd\u5bfe\uff09\u306b\u306a\u3063\u3066\u3044\u308b\u3068\u3044\u3046\u70b9\u3067\u3059\u3002</p>", "<p>\u3064\u307e\u308a\u3001<code>valid_image</code> \u304c <code>False</code> \u3092\u8fd4\u3059\u3068\u304d\u306b <code>invalid_image</code> \u306f <code>True</code> \u3092\u8fd4\u3057\u3001\u305d\u306e\u9006\u3082\u307e\u305f\u540c\u69d8\u3067\u3059\u3002</p>", "<p><code>not</code> \u304c\u4f55\u3092\u3059\u308b\u3082\u306e\u3060\u3063\u305f\u304b\u3001\u899a\u3048\u3066\u3044\u307e\u3059\u304b\uff1f</p>"], "solution": {"tokens": ["def", " ", "invalid_image", "(", "filename", ")", ":", "\n", "    ", "return", " ", "not", " ", "(", "filename", ".", "endswith", "(", "\".png\"", ")", " ", "or", " ", "filename", ".", "endswith", "(", "\".jpg\"", ")", ")"], "maskedIndices": [28, 3, 26, 13, 29, 17, 6, 27, 21, 11, 5, 24, 0, 16, 2, 25, 23, 9, 15, 4, 19, 14, 18], "mask": [true, false, true, true, true, true, true, false, false, true, false, true, false, true, true, true, true, true, true, true, false, true, false, true, true, true, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "exercise"}, {"type": "function_exercise", "header": "<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">invalid_image</span><span class=\"p\">(</span><span class=\"n\">filename</span><span class=\"p\">):</span>\n</span></code></pre>"}, {"type": "function_exercise_goal", "print_or_return": "return"}]}, {"index": 4, "text": "<p>\u3088\u304f\u3067\u304d\u307e\u3057\u305f\uff01\u3053\u3061\u3089\u304c2\u3064\u306e\u6b63\u89e3\u4f8b\u3067\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">invalid_image</span><span class=\"p\">(</span><span class=\"n\">filename</span><span class=\"p\">):</span>\n    <span class=\"k\">return</span> <span class=\"ow\">not</span> <span class=\"p\">(</span><span class=\"n\">filename</span><span class=\"o\">.</span><span class=\"n\">endswith</span><span class=\"p\">(</span><span class=\"s2\">\".png\"</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"n\">filename</span><span class=\"o\">.</span><span class=\"n\">endswith</span><span class=\"p\">(</span><span class=\"s2\">\".jpg\"</span><span class=\"p\">))</span>\n\n<span class=\"k\">def</span> <span class=\"nf\">invalid_image</span><span class=\"p\">(</span><span class=\"n\">filename</span><span class=\"p\">):</span>\n    <span class=\"k\">return</span> <span class=\"ow\">not</span> <span class=\"n\">filename</span><span class=\"o\">.</span><span class=\"n\">endswith</span><span class=\"p\">(</span><span class=\"s2\">\".png\"</span><span class=\"p\">)</span> <span class=\"ow\">and</span> <span class=\"ow\">not</span> <span class=\"n\">filename</span><span class=\"o\">.</span><span class=\"n\">endswith</span><span class=\"p\">(</span><span class=\"s2\">\".jpg\"</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\uff08\u6c17\u306b\u306a\u3063\u305f\u4eba\u306e\u305f\u3081\u306b\u88dc\u8db3\u3059\u308b\u3068\u3001\u3053\u308c\u3089\u306f\u300c\u30c9\u30fb\u30e2\u30eb\u30ac\u30f3\u306e\u6cd5\u5247\u300d\u3068\u547c\u3070\u308c\u308b\u3082\u306e\u306b\u3088\u3063\u3066\u540c\u3058\u610f\u5473\u306b\u306a\u308a\u307e\u3059\uff09</p>\n<p>\u307e\u305f\u3001\u3053\u308c\u3082\u30b7\u30f3\u30d7\u30eb\u306b\u3067\u304d\u308b\u4e00\u822c\u7684\u306a\u30d1\u30bf\u30fc\u30f3\u306e1\u3064\u3067\u3042\u308b\u3053\u3068\u306b\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b3\u30fc\u30c9\u304c\u6b21\u306e\u3088\u3046\u306a\u5f62\u3092\u3057\u3066\u3044\u3066\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">if</span> <span class=\"n\">x</span><span class=\"p\">:</span>\n    <span class=\"k\">return</span> <span class=\"kc\">False</span>\n<span class=\"k\">else</span><span class=\"p\">:</span>\n    <span class=\"k\">return</span> <span class=\"kc\">True</span>\n</span></code></pre>\n<p><code>x</code> \u81ea\u4f53\u304cboolean\u3067\u3042\u308b\u306a\u3089\u3001\u6b21\u306e\u3088\u3046\u306b\u30b9\u30c3\u30ad\u30ea\u3068\u66f8\u304d\u76f4\u305b\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">return</span> <span class=\"ow\">not</span> <span class=\"n\">x</span>\n</span></code></pre>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}, "IntroducingTicTacToe": {"slug": "IntroducingTicTacToe", "title": "\u30dc\u30fc\u30c9\u306e\u52dd\u8005\u3092\u5224\u5b9a\u3059\u308b", "index": 50, "step_names": ["intro_row_winner", "column_winner", "diagonal_winner", "winner", "final_text"], "steps": [{"index": 0, "text": "<p>\u3053\u308c\u307e\u3067\u30011\u3064\u306e\u5c0f\u3055\u306a\u554f\u984c\u3092\u89e3\u6c7a\u3059\u308b\u77ed\u3044\u6f14\u7fd2\u3092\u305f\u304f\u3055\u3093\u3053\u306a\u3057\u3066\u304d\u307e\u3057\u305f\u306d\u3002\u4eca\u5ea6\u306f\u3001\u3053\u308c\u307e\u3067\u306e\u77e5\u8b58\u304c\u672c\u5f53\u306b\u8a66\u3055\u308c\u308b\u3001\u591a\u304f\u306e\u5c0f\u3055\u306a\u30d1\u30fc\u30c4\u3092\u7d44\u307f\u5408\u308f\u305b\u305f\u5927\u304d\u304f\u3066\u8907\u96d1\u306a\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306b\u53d6\u308a\u7d44\u307f\u307e\u3059\u3002\n\u3068\u3063\u3066\u3082\u697d\u3057\u3044\u3067\u3059\u3088\uff01</p>\n<p>\u4eba\u95932\u4eba\u3067\u30d7\u30ec\u30a4\u3059\u308b\u3001\u30c6\u30ad\u30b9\u30c8\u30d9\u30fc\u30b9\u306e\u5bfe\u8a71\u578b\u3007\u00d7\u30b2\u30fc\u30e0\uff08tic-tac-toe\uff09\u3092\u4f5c\u3063\u3066\u3044\u304d\u307e\u3059\u3002\n\u5b8c\u6210\u3057\u305f\u30b2\u30fc\u30e0\u304c\u5b9f\u969b\u306b\u3069\u306e\u3088\u3046\u306b\u52d5\u304f\u306e\u304b\u3001\u5c11\u3057\u30d7\u30ec\u30d3\u30e5\u30fc\u3092\u304a\u898b\u305b\u3057\u307e\u3059\uff1a</p>\n<pre><code>  1 2 3\n1  | |\n  -+-+-\n2  | |\n  -+-+-\n3  | |\n\nX to play:\n1\n1\n\n  1 2 3\n1 X| |\n  -+-+-\n2  | |\n  -+-+-\n3  | |\n\nO to play:\n2\n2\n\n  1 2 3\n1 X| |\n  -+-+-\n2  |O|\n  -+-+-\n3  | |\n\nX to play:\n1\n3\n\n  1 2 3\n1 X| |X\n  -+-+-\n2  |O|\n  -+-+-\n3  | |\n</code></pre>\n<p>\u3053\u306e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u3001\u3044\u304f\u3064\u304b\u306e\u5c0f\u3055\u306a\u95a2\u6570\uff08\u3053\u308c\u304c\u6f14\u7fd2\u306b\u306a\u308a\u307e\u3059\uff09\u306b\u5206\u5272\u3057\u3066\u3044\u304d\u307e\u3059\u3002</p>\n<p>\u3053\u308c\u307e\u3067\u306b\u5b66\u3093\u3060\u591a\u304f\u306e\u6982\u5ff5\u3092\u4f7f\u3044\u307e\u3059\u3088\uff1a\u6587\u5b57\u5217\u3001\u30cd\u30b9\u30c8\u3055\u308c\u305f\u30ea\u30b9\u30c8\u3001\u30cd\u30b9\u30c8\u3055\u308c\u305f\u30eb\u30fc\u30d7\u3001<code>range</code>\u3001\u95a2\u6570\u306e\u4e2d\u3067\u306e\u95a2\u6570\u547c\u3073\u51fa\u3057\u3001\u6bd4\u8f03\u3001\u305d\u3057\u3066 booleans \u3067\u3059\u3002</p>\n<p>\u9032\u3081\u3066\u3044\u304f\u4e2d\u3067\u3001\u6539\u884c\u6587\u5b57\u3001\u578b\uff08types\uff09\u3001<code>input()</code> \u306a\u3069\u306e\u65b0\u3057\u3044\u6982\u5ff5\u3082\u5b66\u3093\u3067\u3044\u304d\u307e\u3059\u3002</p>\n<p>\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u5927\u307e\u304b\u306a\u6982\u8981\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\uff1a</p>\n<ul>\n<li>\u30dc\u30fc\u30c9\u5168\u4f53\u3092\u8abf\u3079\u3066\u3001\u63c3\u3063\u3066\u3044\u308b\u884c\u30fb\u5217\u30fb\u5bfe\u89d2\u7dda\u304c\u3042\u308b\u304b\u3092\u30c1\u30a7\u30c3\u30af\u3059\u308b3\u3064\u306e\u95a2\u6570 <code>row_winner</code>\u3001<code>column_winner</code>\u3001<code>diagonal_winner</code></li>\n<li>\u4e0a\u306e\u95a2\u6570\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u30dc\u30fc\u30c9\u5168\u4f53\u3067\u52dd\u8005\u304c\u3044\u308b\u304b\u3092\u30c1\u30a7\u30c3\u30af\u3059\u308b\u95a2\u6570 <code>winner</code></li>\n<li>\u30b2\u30fc\u30e0\u306e\u73fe\u5728\u306e\u72b6\u614b\u3092\u8868\u793a\u3059\u308b\u95a2\u6570 <code>format_board</code></li>\n<li>\u30e6\u30fc\u30b6\u30fc\u306e\u5165\u529b\u3092\u53d7\u3051\u53d6\u3063\u3066\u624b\u3092\u6253\u3064\u95a2\u6570 <code>play_move</code></li>\n<li>\u6700\u5f8c\u306b\u3001\u3053\u308c\u3089\u3059\u3079\u3066\u3092\u307e\u3068\u3081\u3066\u5bfe\u8a71\u7684\u306b\u30b2\u30fc\u30e0\u3092\u5b9f\u884c\u3059\u308b <code>play_game</code> \u95a2\u6570</li>\n<li>\u5f8c\u307b\u3069\u3001\u3055\u3089\u306b\u6539\u826f\u3082\u52a0\u3048\u3066\u3044\u304d\u307e\u3059\u3002</li>\n</ul>\n<p>\u3055\u3042\u3001\u59cb\u3081\u307e\u3057\u3087\u3046\uff01</p>\n<p>\u524d\u306e\u7ae0\u3068\u540c\u69d8\u306b\u3001\u3007\u00d7\u30b2\u30fc\u30e0\u306e\u30dc\u30fc\u30c9\u306f\u6587\u5b57\u5217\u306e\u30cd\u30b9\u30c8\u3055\u308c\u305f\u30ea\u30b9\u30c8\u3068\u3057\u3066\u8868\u73fe\u3057\u307e\u3059\u3002\n\u901a\u5e38\u306e\u30b2\u30fc\u30e0\u3067\u306f3\u00d73\u306e\u30ea\u30b9\u30c8\u3001\u3064\u307e\u308a\u305d\u308c\u305e\u308c3\u3064\u306e\u6587\u5b57\u5217\u3092\u542b\u30803\u3064\u306e\u30ea\u30b9\u30c8\u306b\u306a\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f <code>'X'</code> \u307e\u305f\u306f <code>'O'</code> \u3067\u8868\u3055\u308c\u307e\u3059\u3002\n\u7a7a\u306e\u30de\u30b9\u306f\u30b9\u30da\u30fc\u30b9\u3001\u3064\u307e\u308a <code>' '</code> \u3067\u8868\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3053\u3093\u306a\u611f\u3058\u3067\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">board</span> <span class=\"o\">=</span> <span class=\"p\">[</span>\n    <span class=\"p\">[</span><span class=\"s1\">'X'</span><span class=\"p\">,</span> <span class=\"s1\">'O'</span><span class=\"p\">,</span> <span class=\"s1\">'X'</span><span class=\"p\">],</span>\n    <span class=\"p\">[</span><span class=\"s1\">'O'</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">],</span>\n    <span class=\"p\">[</span><span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">'X'</span><span class=\"p\">,</span> <span class=\"s1\">'O'</span><span class=\"p\">]</span>\n<span class=\"p\">]</span>\n</span></code></pre>\n<p>\u305f\u3060\u3057\u3001\u3082\u3063\u3068\u9762\u767d\u304f\u3059\u308b\u305f\u3081\u306b\u3001\u3042\u306a\u305f\u306e\u30b3\u30fc\u30c9\u306f\u4efb\u610f\u306e\u30b5\u30a4\u30ba\u306e\u6b63\u65b9\u5f62\u30dc\u30fc\u30c9\uff084\u00d74\u30015\u00d75\u306a\u3069\uff09\u3084\u3001\n\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u4efb\u610f\u306e\u6587\u5b57\u5217\u3067\u8868\u3055\u308c\u308b\u5834\u5408\uff08\u4f8b\uff1a\u4e0b\u8a18\uff09\u3067\u3082\u52d5\u4f5c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">board</span> <span class=\"o\">=</span> <span class=\"p\">[</span>\n    <span class=\"p\">[</span><span class=\"s1\">'A'</span><span class=\"p\">,</span> <span class=\"s1\">'B'</span><span class=\"p\">,</span> <span class=\"s1\">'A'</span><span class=\"p\">,</span> <span class=\"s1\">'A'</span><span class=\"p\">],</span>\n    <span class=\"p\">[</span><span class=\"s1\">'B'</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">'A'</span><span class=\"p\">],</span>\n    <span class=\"p\">[</span><span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">'A'</span><span class=\"p\">,</span> <span class=\"s1\">'B'</span><span class=\"p\">,</span> <span class=\"s1\">'B'</span><span class=\"p\">],</span>\n    <span class=\"p\">[</span><span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">'A'</span><span class=\"p\">,</span> <span class=\"s1\">'B'</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">]</span>\n<span class=\"p\">]</span>\n</span></code></pre>\n<p><code>board</code> \u306b\u52dd\u3061\u306e\u884c\uff08\u3064\u307e\u308a\u3001<code>' '</code> \u4ee5\u5916\u306e\u540c\u3058\u6587\u5b57\u304c\u6a2a\u4e00\u5217\u306b\u4e26\u3093\u3067\u3044\u308b\u30e9\u30a4\u30f3\uff09\u304c\u542b\u307e\u308c\u3066\u3044\u308b\u5834\u5408\u306b <code>True</code> \u3092\u8fd4\u3059\u95a2\u6570 <code>row_winner</code> \u3092\u66f8\u3044\u3066\u304f\u3060\u3055\u3044\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"k\">def</span> <span class=\"nf\">row_winner</span><span class=\"p\">(</span><span class=\"n\">board</span><span class=\"p\">):</span>\n    <span class=\"o\">...</span>\n\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span>\n    <span class=\"n\">row_winner</span><span class=\"p\">(</span>\n        <span class=\"p\">[</span>\n            <span class=\"p\">[</span><span class=\"s1\">'A'</span><span class=\"p\">,</span> <span class=\"s1\">'A'</span><span class=\"p\">,</span> <span class=\"s1\">'B'</span><span class=\"p\">,</span> <span class=\"s1\">'A'</span><span class=\"p\">],</span>\n            <span class=\"p\">[</span><span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">],</span>\n            <span class=\"p\">[</span><span class=\"s1\">'A'</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">'A'</span><span class=\"p\">],</span>\n            <span class=\"p\">[</span><span class=\"s1\">'B'</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">'B'</span><span class=\"p\">,</span> <span class=\"s1\">'A'</span><span class=\"p\">]</span>\n        <span class=\"p\">]</span>\n    <span class=\"p\">),</span>\n    <span class=\"kc\">False</span>\n<span class=\"p\">)</span>\n<span class=\"n\">assert_equal</span><span class=\"p\">(</span>\n    <span class=\"n\">row_winner</span><span class=\"p\">(</span>\n        <span class=\"p\">[</span>\n            <span class=\"p\">[</span><span class=\"s1\">'X'</span><span class=\"p\">,</span> <span class=\"s1\">' '</span><span class=\"p\">,</span> <span class=\"s1\">'X'</span><span class=\"p\">],</span>\n            <span class=\"p\">[</span><span class=\"s1\">'O'</span><span class=\"p\">,</span> <span class=\"s1\">'X'</span><span class=\"p\">,</span> <span class=\"s1\">'X'</span><span class=\"p\">],</span>\n            <span class=\"p\">[</span><span class=\"s1\">'O'</span><span class=\"p\">,</span> <span class=\"s1\">'O'</span><span class=\"p\">,</span> <span class=\"s1\">'O'</span><span class=\"p\">]</span>\n        <span class=\"p\">]</span>\n    <span class=\"p\">),</span>\n    <span class=\"kc\">True</span>\n<span class=\"p\">)</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p>2\u3064\u76ee\u306e\u4f8b\u3067\u306f\u3001\u4e00\u756a\u4e0b\u306e\u884c\u3067 <code>O</code> \u304c\u52dd\u3063\u3066\u3044\u307e\u3059\u3002</p>", "name": "intro_row_winner", "hints": ["<p>\u30dc\u30fc\u30c9\u306e\u3059\u3079\u3066\u306e\u884c\u3092\u30c1\u30a7\u30c3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u306e\u3067\u3001\u305d\u306e\u305f\u3081\u306e\u30eb\u30fc\u30d7\u304c\u5fc5\u8981\u306b\u306a\u308a\u307e\u3059\u3002</p>", "<p>1\u3064\u306e\u884c\u306e\u3059\u3079\u3066\u306e\u8981\u7d20\u304c\u4e92\u3044\u306b\u7b49\u3057\u3044\u304b\u3069\u3046\u304b\u3092\u8abf\u3079\u308b\u306b\u306f\u3001\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u3053\u308c\u306f\u305d\u308c\u81ea\u4f53\u304c\u72ec\u7acb\u3057\u305f\u554f\u984c\u3067\u3059\u3002\u307e\u305a\u306f\u30dc\u30fc\u30c9\u5168\u4f53\u306e\u3053\u3068\u306f\u5fd8\u308c\u3066\u30011\u3064\u306e\u884c\u3060\u3051\u3092\u30c1\u30a7\u30c3\u30af\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u5fc5\u