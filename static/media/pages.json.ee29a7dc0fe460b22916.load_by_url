pre>\n<p>2\u3064\u306e dictionary \u306f\u5e38\u306b\u540c\u3058 key \u3092\u6301\u3061\u3001\u5024\uff08value\uff09\u3060\u3051\u304c\u7570\u306a\u308a\u307e\u3059\u3002</p>", "name": "english_to_german", "hints": ["<p>\u524d\u306e\u30a8\u30af\u30b5\u30b5\u30a4\u30ba\u3068\u3068\u3066\u3082\u3088\u304f\u4f3c\u3066\u3044\u3066\u3001\u307e\u3060\u7279\u5225\u306a\u3053\u3068\u306f\u4f55\u3082\u3042\u308a\u307e\u305b\u3093\u3088\u3002</p>", "<p>\u524d\u306e\u56de\u7b54\u3092\u518d\u5229\u7528\u3067\u304d\u307e\u3059\u3002\u5f15\u6570\u3092\u3082\u30461\u3064\u8ffd\u52a0\u3057\u3066\u3001\u4e2d\u8eab\u306e\u30b3\u30fc\u30c9\u3092\u307b\u3093\u306e\u5c11\u3057\u8db3\u3059\u3060\u3051\u3067\u3059\u3002</p>", "<p>\u4eca\u5ea6\u306f1\u3064\u306e dictionary \u306e key \u3068\u30012\u3064\u306e dictionary \u306e value \u3092 print \u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>"], "solution": {"tokens": ["def", " ", "print_words", "(", "french", ",", " ", "german", ")", ":", "\n", "    ", "for", " ", "word", " ", "in", " ", "french", ":", "\n", "        ", "print", "(", "\"English: \"", " ", "+", " ", "word", ")", "\n", "        ", "print", "(", "\"French: \"", " ", "+", " ", "french", "[", "word", "]", ")", "\n", "        ", "print", "(", "\"German: \"", " ", "+", " ", "german", "[", "word", "]", ")", "\n", "        ", "print", "(", "\"---\"", ")"], "maskedIndices": [0, 38, 54, 47, 9, 8, 33, 4, 42, 7, 60, 19, 12, 45, 39, 5, 36, 18, 14, 51, 61, 59, 55, 46, 34, 26, 52, 32, 28, 24, 22, 16, 49, 53, 40, 23, 41, 3, 29, 2, 58], "mask": [true, false, true, true, true, true, false, true, true, true, false, false, true, false, true, false, true, false, true, true, false, false, true, true, true, false, true, false, true, true, false, false, true, true, true, false, true, false, true, true, true, true, true, false, false, true, true, true, false, true, false, true, true, true, true, true, false, false, true, true, true, true], "lines": null}, "prediction": {"choices":