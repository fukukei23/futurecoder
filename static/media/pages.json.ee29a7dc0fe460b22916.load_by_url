u306b\u306a\u308a\u307e\u3059\u3002</p>", "name": "subscript_assignment_exercise", "hints": ["<p>\u89e3\u7b54\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u306f\u3001<code>x = ['a', 'b', 'c']</code>\u3001\u30ea\u30b9\u30c8\u304b\u3089\u305d\u306e\u307e\u307e\u30b3\u30d4\u30fc\u3057\u305f1\u884c\uff08\u4f59\u8a08\u306a\u8ffd\u52a0\u306a\u3057\uff09\u3001\u305d\u3057\u3066 <code>print(x)</code> \u306e\u3061\u3087\u3046\u30693\u884c\u306b\u306a\u308b\u306f\u305a\u3067\u3059\u3002</p>", "<p><code>x</code> \u306e\u6700\u521d\u306e\u8981\u7d20\u306e\u5024\u3092\u53d6\u5f97\u3057\u3066...</p>", "<p>\u305d\u306e\u5024\u3092 <code>x</code> \u306e\u6700\u5f8c\u306e\u4f4d\u7f6e\u306b\u4ee3\u5165\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u30ea\u30b9\u30c8\u306e\u7279\u5b9a\u306e\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u306b\u5024\u3092\u4ee3\u5165\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p><code>x</code> \u306e\u6700\u521d\u3068\u6700\u5f8c\u306e\u8981\u7d20\u306e\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f</p>"], "solution": {"tokens": ["x", " ", "=", " ", "[", "'a'", ",", " ", "'b'", ",", " ", "'c'", "]", "\n", "x", "[", "len", "(", "x", ")", " ", "-", " ", "1", "]", " ", "=", " ", "x", "[", "0", "]", "\n", "print", "(", "x", ")"], "maskedIndices": [16, 26, 29, 24, 36, 4, 28, 2, 5, 19, 33, 18, 14, 12, 17, 30, 9, 15, 35, 11, 34, 21, 0, 6, 8, 31, 23], "mask": [true, false, true, false, true, true, true, false, true, true, false, true, true, false, true, true, true, true, true, true, false, true, false, true, true, false, true, false, true, true, true, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}, {"type": "custom", "message": "<p>\u4e0a\u306e3\u884c\u3092\u30b3\u30d4\u30fc\u3057\u3066\u3001<code>(insert_one_line_from_above)</code> \u3092\u524d\u306e\u30b9\u30c6\u30c3\u30d7\u306b\u3042\u3063\u305f\u9577\u3044\u5019\u88dc\u30ea\u30b9\u30c8\u306e\u4e2d\u306e\u3061\u3087\u3046\u30691\u884c\u306b\u7f6e\u304d\u63db\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u6b63\u3057\u3044\u884c\u3092\u9078\u3076\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6b63\u89e3\u306f1\u3064\u3060\u3051\u3067\u3059\u3002\u305d\u306e\u884c\u3092\u305d\u306e\u307e\u307e\u6b63\u78ba\u306b\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"}]}, {"index": 7, "text": "<p>\u7d20\u6674\u3089\u3057\u3044\uff01</p>\n<p><code>x[len(x) - 1]</code> \u3092\u4f7f\u3063\u3066\u6700\u5f8c\u306e\u8981\u7d20\u3092\u6271\u3046\u306e\u306f\u3001\u3061\u3087\u3063\u3068\u9762\u5012\u3060\u3068\u611f\u3058\u305f\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u306d\u3002\n\u5b9f\u306f\u540c\u3058\u3053\u3068\u304c <code>x[-1]</code> \u3067\u3067\u304d\u3061\u3083\u3044\u307e\u3059\u3002\n\u540c\u69d8\u306b\u3001\u5f8c\u308d\u304b\u30892\u756a\u76ee\u306e\u8981\u7d20 <code>x[len(x) - 2]</code> \u306f <code>x[-2]</code> \u3068\u66f8\u304f\u3053\u3068\u304c\u3067\u304d\u3001\u305d\u308c\u4ee5\u964d\u3082\u540c\u3058\u3088\u3046\u306b\u7d9a\u3051\u3089\u308c\u307e\u3059\u3002\nPython\u3067\u306f\u3001\u6700\u5f8c\u306e\u8981\u7d20\u3092 <code>-1</code> \u3068\u3057\u3066\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u3092\u5f8c\u308d\u304b\u3089\u9006\u5411\u304d\u306b\u6570\u3048\u308b\u3053\u3068\u3082\u3067\u304d\u308b\u306e\u3067\u3059\uff1a</p>\n<table>\n<thead>\n<tr>\n<th>\u30a4\u30f3\u30c7\u30c3\u30af\u30b9</th>\n<th>1\u756a\u76ee\u306e\u8981\u7d20</th>\n<th>2\u756a\u76ee\u306e\u8981\u7d20</th>\n<th>3\u756a\u76ee\u306e\u8981\u7d20</th>\n<th>...</th>\n<th>\u5f8c\u308d\u304b\u30892\u756a\u76ee\u306e\u8981\u7d20</th>\n<th>\u6700\u5f8c\u306e\u8981\u7d20</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>\u524d\u304b\u3089</td>\n<td><code>0</code></td>\n<td><code>1</code></td>\n<td><code>2</code></td>\n<td>...</td>\n<td><code>len(x) - 2</code></td>\n<td><code>len(x) - 1</code></td>\n</tr>\n<tr>\n<td>\u5f8c\u308d\u304b\u3089</td>\n<td><code>-len(x)</code></td>\n<td><code>-len(x) + 1</code></td>\n<td><code>-len(x) + 2</code></td>\n<td>...</td>\n<td><code>-2</code></td>\n<td><code>-1</code></td>\n</tr>\n</tbody>\n</table>\n<p>\u6b21\u306e\u7df4\u7fd2\u554f\u984c\u3067\u3059\uff1a</p>\n<p>\u4eca\u56de\u306f\u3001\u30ea\u30b9\u30c8 <code>x</code> \u3092\u5909\u66f4\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u65b0\u3057\u3044\u30ea\u30b9\u30c8 <code>y</code> \u3092\u4f5c\u3063\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"n\">x</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"s1\">'a'</span><span class=\"p\">,</span> <span class=\"s1\">'b'</span><span class=\"p\">,</span> <span class=\"s1\">'c'</span><span class=\"p\">]</span>\n<span class=\"n\">y</span> <span class=\"o\">=</span> <span class=\"p\">(</span><span class=\"n\">insert_one_line_from_above</span><span class=\"p\">)</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">y</span><span class=\"p\">)</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p><code>y</code> \u306f <code>x</code> \u3068\u540c\u3058\u5185\u5bb9\u3067\u3001\u3055\u3089\u306b\u672b\u5c3e\u306b\u6700\u521d\u306e\u8981\u7d20\u304c\u7e70\u308a\u8fd4\u3055\u308c\u305f\u3082\u306e\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\n\u3064\u307e\u308a\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u5b9f\u884c\u3059\u308b\u3068 <code>['a', 'b', 'c', 'a']</code> \u304c\u51fa\u529b\u3055\u308c\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002</p>", "name": "negative_index_concatenation_exercise", "hints": ["<p>\u89e3\u7b54\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u306f\u3001<code>x = ['a', 'b', 'c']</code>\u3001\u30ea\u30b9\u30c8\u304b\u3089\u305d\u306e\u307e\u307e\u30b3\u30d4\u30fc\u3057\u305f1\u884c\u304c\u7d9a\u304f <code>y =</code>\u3001\u305d\u3057\u3066 <code>print(y)</co