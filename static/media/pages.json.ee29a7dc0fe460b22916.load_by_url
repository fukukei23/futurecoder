n class=\"s2\">\"hello world\"</span><span class=\"p\">,</span>\n    <span class=\"p\">]</span>\n<span class=\"p\">]</span>\n<span class=\"n\">word</span> <span class=\"o\">=</span> <span class=\"s2\">\"Python\"</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p>\u3060\u3063\u305f\u5834\u5408\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u306f <code>False</code> \u3092\u51fa\u529b\u3059\u308b\u306f\u305a\u3067\u3059\u3002</p>", "name": "list_contains_word_exercise", "hints": ["<p>\u3053\u308c\u306f\u524d\u306e\u7df4\u7fd2\u554f\u984c\u3068\u3068\u3066\u3082\u3088\u304f\u4f3c\u3066\u3044\u307e\u3059\u3002</p>", "<p>\u771f\u507d\u5024\uff08boolean\uff09\u306f\u3044\u3064\u51fa\u529b\uff08print\uff09\u3059\u308b\u3079\u304d\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u51fa\u529b\u3059\u308b\u306e\u306f1\u56de\u3060\u3051\u3060\u3068\u3044\u3046\u3053\u3068\u3092\u601d\u3044\u51fa\u3057\u3066\u304f\u3060\u3055\u3044\u306d\u3002</p>", "<p>\u5404sublist\u3054\u3068\u306b\u771f\u507d\u5024\u3092\u7528\u610f\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u30ea\u30b9\u30c8\u5168\u4f53\u306b\u5bfe\u3057\u3066\u771f\u507d\u5024\u30921\u3064\u3060\u3051\u5b9a\u7fa9\u3057\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u3044\u3064\u3001\u3069\u306e\u3088\u3046\u306b\u305d\u306e\u771f\u507d\u5024\u3092\u5909\u66f4\u3059\u308b\u3079\u304d\u3067\u3057\u3087\u3046\u304b\uff1f</p>"], "solution": {"tokens": ["present", " ", "=", " ", "False", "\n", "for", " ", "sublist", " ", "in", " ", "strings", ":", "\n", "    ", "for", " ", "string", " ", "in", " ", "sublist", ":", "\n", "        ", "if", " ", "word", " ", "in", " ", "string", ":", "\n", "            ", "present", " ", "=", " ", "True", "\n", "print", "(", "present", ")"], "maskedIndices": [28, 38, 26, 43, 4, 22, 30, 18, 12, 20, 0, 2, 6, 45, 33, 16, 44, 42, 36, 13, 40, 32, 8, 10, 23], "mask": [true, false, true, false, true, false, true, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, true, true], "lines": [{"id": "5", "content": "<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">present</span><span class=\"p\">)</span>"}, {"id": "1", "content": "<span class=\"k\">for</span> <span class=\"n\">sublist</span> <span class=\"ow\">in</span> <span class=\"n\">strings</span><span class=\"p\">:</span>"}, {"id": "4", "content": "            <span class=\"n\">present</span> <span class=\"o\">=</span> <span class=\"kc\">True</span>"}, {"id": "2", "content": "    <span class=\"k\">for</span> <span class=\"n\">string</span> <span class=\"ow\">in</span> <span class=\"n\">sublist</span><span class=\"p\">:</span>"}, {"id": "3", "content": "        <span class=\"k\">if</span> <span class=\"n\">word</span> <span class=\"ow\">in</span> <span class=\"n\">string</span><span class=\"p\">:</span>"}, {"id": "0", "content": "<span class=\"n\">present</span> <span class=\"o\">=</span> <span class=\"kc\">False</span>"}]}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "exercise"}, {"type": "non_function_exercise", "inputs": "<pre><code class=\"codehilite\"><span><span class=\"n\">strings</span> <span class=\"o\">=</span> <span class=\"p\">[[</span><span class=\"s1\">'hello there'</span><span class=\"p\">,</span> <span class=\"s1\">'how are you'</span><span class=\"p\">],</span> <span class=\"p\">[</span><span class=\"s1\">'goodbye world'</span><span class=\"p\">,</span> <span class=\"s1\">'hello world'</span><span class=\"p\">]]</span>\n<span class=\"n\">word</span> <span class=\"o\">=</span> <span class=\"s1\">'are'</span>\n</span></code></pre>"}]}, {"index": 5, "text": "<p>\u3059\u3070\u3089\u3057\u3044\uff01</p>\n<p><a href=\"#GettingElementsAtPositionExercises\">\u30b3\u30fc\u30b9\u306e\u524d\u534a</a>\u3067\u3001\u6b21\u306e\u3088\u3046\u306b2\u3064\u306e\u6587\u5b57\u5217\u3092\u7e26\u306b\u4e26\u3079\u3066\u51fa\u529b\u3059\u308b\u7df4\u7fd2\u554f\u984c\u304c\u3042\u308a\u307e\u3057\u305f\u306d\uff1a</p>\n<pre><code>H W\ne o\nl r\nl l\no d\n</code></pre>\n<p>\u4eca\u56de\u306f\u3053\u308c\u3092\u4e00\u822c\u5316\u3057\u3066\u30012\u3064\u3060\u3051\u3067\u306a\u304f\u6587\u5b57\u5217\u306e\u30ea\u30b9\u30c8\u306b\u5bfe\u5fdc\u3055\u305b\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>\n<p>\u3053\u306e\u7df4\u7fd2\u554f\u984c\u3067\u306f\u3001<strong>\u540c\u3058\u9577\u3055</strong>\u306e\u6587\u5b57\u5217\u306e\u30ea\u30b9\u30c8\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\n\u5404\u6587\u5b57\u5217\u306e1\u6587\u5b57\u76ee\u30921\u884c\u306b\u51fa\u529b\u3057\u3001\n\u6b21\u306e\u884c\u306b\u5404\u6587\u5b57\u5217\u306e2\u6587\u5b57\u76ee\u3092\u51fa\u529b\u3057\u2026\u2026\u3068\u3044\u3046\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u66f8\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u3082\u3057</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">strings</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"s2\">\"abc\"</span><span class=\"p\">,</span> <span class=\"s2\">\"def\"</span><span class=\"p\">,</span> <span class=\"s2\">\"ghi\"</span><span class=\"p\">]</span>\n</span></code></pre>\n<p>\u306a\u3089\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u306f\u6b21\u306e\u3088\u3046\u306b\u51fa\u529b\u3059\u308b\u306f\u305a\u3067\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">adg</span>\n<span class=\"n\">beh</span>\n<span class=\"n\">cfi</span>\n</span></code></pre>\n<p>\u3042\u306a\u305f\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u306f\u3001\u305d\u306e\u3088\u3046\u306a\u30ea\u30b9\u30c8\u306a\u3089\u3069\u308c\u3067\u3082\u52d5\u304f\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u7279\u306b\u3001\u6b21\u306e\u30ea\u30b9\u30c8\u3092\u4f7f\u3046\u3068\u3001\nThe Zen of Python \u304b\u3089\u306e\u96a0\u3055\u308c\u305f\u30e1\u30c3\u30bb\u30fc\u30b8\u304c\u898b\u3064\u304b\u308a\u307e\u3059\u3088\uff01</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"n\">strings</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"s2\">\"  b n\"</span><span class=\"p\">,</span> <span class=\"s2\">\"f ete\"</span><span class=\"p\">,</span> <span class=\"s2\">\"liths\"</span><span class=\"p\">,</span> <span class=\"s2\">\"astat\"</span><span class=\"p\">,</span> <span class=\"s2\">\"t ene\"</span><span class=\"p\">,</span> <span class=\"s2\">\"  r d\"</span><span class=\"p\">]</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p>\u4eca\u56de\u306f\u51fa\u529b\u306e\u6587\u5b57\u3068\u6587\u5b57\u306e\u9593\u306b\u30b9\u30da\u30fc\u30b9\u3092\u5165\u308c\u306a\u3044\u3088\u3046\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u306d\u3002</p>", "name": "zip_strings_list_exercise", "hints": ["<p>\u3053\u308c\u306f\u3053\u306e\u30da\u30fc\u30b8\u306e\u3053\u308c\u307e\u3067\u306e\u7df4\u7fd2\u554f\u984c\u3068\u306f\u4f3c\u3066\u3044\u307e\u305b\u3093\u3002</p>", "<p>\u6587\u5b57\u5217\u304c2\u3064\u3060\u3051\u3060\u3063\u305f\u3068\u304d\u306e\u89e3\u304d\u65b9\u3092\u601d\u3044\u51fa\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u305d\u308c\u3092\u6587\u5b57\u5217\u306e\u30ea\u30b9\u30c8\u3078\u3068\u4e00\u822c\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>1\u6587\u5b57\u76ee\u30012\u6587\u5b57\u76ee\u3001\u3068\u3044\u3063\u305f\u9806\u306b\u51e6\u7406\u3057\u3066\u3044\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u30eb\u30fc\u30d7\u3092\u4f7f\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u305d\u306e\u30eb\u30fc\u30d7\u306f\u4f55\u56de\u7e70\u308a\u8fd4\u305b\u3070\u3044\u3044\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u30ea\u30b9\u30c8\u5185\u306e\u6587\u5b57\u5217\u306f\u3059\u3079\u3066\u540c\u3058\u9577\u3055\u3067\u3042\u308b\u3053\u3068\u306b\u7740\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u5404\u4f4d\u7f6e\uff081\u6587\u5b57\u76ee\u30012\u6587\u5b57\u76ee\u306a\u3069\uff09\u3054\u3068\u306b\u3001\u65b0\u3057\u3044\u6587\u5b57\u5217\u3092\u5b9a\u7fa9\u3057\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u305d\u306e\u6587\u5b57\u5217\u306e\u521d\u671f\u5024\u306f\u4f55\u306b\u3059\u3079\u304d\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u5404\u4f4d\u7f6e\uff081\u6587\u5b57\u76ee\u30012\u6587\u5b57\u76ee\u306a\u3069\uff09\u306b\u3064\u3044\u3066\u3001\u30ea\u30b9\u30c8\u5185\u306e\u5404\u6587\u5b57\u5217\u3092\u9806\u756a\u306b\u898b\u3066\u3044\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u3059\u3067\u306b\u3042\u308b\u30eb\u30fc\u30d7\u306e\u5185\u5074\u306b\u3001\u3082\u30461\u3064\u30eb\u30fc\u30d7\u304c\u5fc5\u8981\u306b\u306a\u308a\u307e\u3059\u3002</p>"], "solution": {"tokens": ["for", " ", "i", " ", "in", " ", "range", "(", "len", "(", "strings", "[", "0", "]", ")", ")", ":", "\n", "    ", "line", " ", "=", " ", "\"\"", "\n", "    ", "for", " ", "string", " ", "in", " ", "strings", ":", "\n", "        ", "line", " ", "+=", " ", "string", "[", "i", "]", "\n", "    ", "print", "(", "line", ")"], "maskedIndices": [47, 26, 43, 40, 30, 9, 32, 2, 14, 33, 15, 41, 48, 38, 8, 12, 11, 7, 21, 6, 49, 46, 4, 0, 42, 19, 13, 28, 10, 16, 23, 36], "mask": [true, false, true, false, true, false, true, true, true, true, true, true, true, true, true, true, true, false, false, true, false, true, false, true, false, false, true, false, true, false, true, false, true, true, false, false, true, false, true, false, true, true, true, true, false, false, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "exercise"}, {"type": "non_function_exercise", "inputs": "<pre><code class=\"codehilite\"><span><span class=\"n\">strings</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"s1\">'abc'</span><span class=\"p\">,</span> <span class=\"s1\">'def'</span><span class=\"p\">,</span> <span class=\"s1\">'ghi'</span><span class=\"p\">]</span>\n</span></code></pre>"}]}, {"index": 6, "text": "<p>\u7d20\u6674\u3089\u3057\u3044\uff01\u3082\u3057\u3088\u3051\u308c\u3070\u3001\u3053\u306e\u307e\u307e<a href=\"#DefiningFunctions\">\u6b21\u306e\u30da\u30fc\u30b8</a>\u306b\u9032\u3093\u3067\u3082\u5927\u4e08\u592b\u3067\u3059\u3002\n\u305d\u308c\u3068\u3082\u3001\u30dc\u30fc\u30ca\u30b9\u30c1\u30e3\u30ec\u30f3\u30b8\u306b\u6311\u6226\u3057\u3066\u307f\u307e\u3059\u304b\uff1f</p>\n<p>\u4eca\u5ea6\u306f\u3001\u524d\u306e\u7df4\u7fd2\u554f\u984c\u3092\u9577\u3055\u304c\u7570\u306a\u308b\u6587\u5b57\u5217\u306b\u3082\u5bfe\u5fdc\u3067\u304d\u308b\u3088\u3046\u306b\u4e00\u822c\u5316\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u4eca\u56de\u3082\u6587\u5b57\u5217\u306e\u30ea\u30b9\u30c8\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\n\u524d\u56de\u3068\u540c\u3058\u3088\u3046\u306b\u3001\u5404\u6587\u5b57\u5217\u306e1\u6587\u5b57\u76ee\u3092\u307e\u3068\u3081\u30661\u884c\u306b\u51fa\u529b\u3057\u3001\n\u6b21\u306e\u884c\u306b2\u6587\u5b57\u76ee\u3092\u307e\u3068\u3081\u3066\u51fa\u529b\u3057\u2026\u2026\u3068\u3044\u3046\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u66f8\u3044\u3066\u304f\u3060\u3055\u3044\u3002\n\u305f\u3060\u3057\u4eca\u56de\u306f\u3001\u6587\u5b57\u5217\u306b\u5341\u5206\u306a\u6587\u5b57\u6570\u304c\u306a\u3044\u5834\u5408\u306f\u3001\u30b9\u30da\u30fc\u30b9\u3092\u51fa\u529b\u3059\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002</p>\n<p>\u4f8b\u3048\u3070\u3001\u3082\u3057</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">strings</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"s2\">\"abcqwe\"</span><span class=\"p\">,</span> <span class=\"s2\">\"def\"</span><span class=\"p\">,</span> <span class=\"s2\">\"ghiq\"</span><span class=\"p\">]</span>\n</span></code></pre>\n<p>\u306a\u3089\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u306f\u6b21\u306e\u3088\u3046\u306b\u51fa\u529b\u3059\u308b\u306f\u305a\u3067\u3059\uff1a</p>\n<pre><code>adg\nbeh\ncfi\nq q\nw\ne\n</code></pre>", "name": "zip_longest_strings_exercise", "hints": ["<p>\u6587\u5b57\u5217\u306e\u9577\u3055\u304c\u7570\u306a\u308b\u5834\u5408\u304c\u3042\u308b\u305f\u3081\u3001\u3053\u308c\u306f\u5c11\u3057\u30c8\u30ea\u30c3\u30ad\u30fc\u3067\u3059\u3002</p>", "<p>\u4eca\u56de\u306f\u3001\u5916\u5074\u306e\u30eb\u30fc\u30d7\u3092\u4f55\u56de\u7e70\u308a\u8fd4\u305b\u3070\u3044\u3044\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u6587\u5b57\u5217\u3092\u51e6\u7406\u3057\u59cb\u3081\u308b\u524d\u306b\u3001\u307e\u305a\u6700\u3082\u9577\u3044\u6587\u5b57\u5217\u306e\u9577\u3055\u3092\u6c42\u3081\u3066\u304a\u304f\u3068\u3044\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002</p>", "<p>\u6b8b\u308a\u306f\u524d\u306e\u7df4\u7fd2\u554f\u984c\u3068\u3068\u3066\u3082\u3088\u304f\u4f3c\u3066\u3044\u307e\u3059\u3002</p>", "<p>\u552f\u4e00\u306e\u9055\u3044\u306f\u3001\u6587\u5b57\u5217\u304b\u3089\u6587\u5b57\u3092\u8ffd\u52a0\u3059\u308b\u306e\u304b\u3001\u305d\u308c\u3068\u3082\u30b9\u30da\u30fc\u30b9\u3092\u8ffd\u52a0\u3059\u308b\u306e\u304b\u3092\u5224\u5b9a\u3057\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u70b9\u3067\u3059\u3002</p>"], "solution": {"tokens": ["lengths", " ", "=", " ", "[", "]", "\n", "for", " ", "string", " ", "in", " ", "strings", ":", "\n", "    ", "lengths", ".", "append", "(", "len", "(", "string", ")", ")", "\n", "length", " ", "=", " ", "max", "(", "lengths", ")", "\n", "\n", "for", " ", "i", " ", "in", " ", "range", "(", "length", ")", ":", "\n", "    ", "line", " ", "=", " ", "\"\"", "\n", "    ", "for", " ", "string", " ", "in", " ", "strings", ":", "\n", "        ", "if", " ", "i", " ", ">=", " ", "len", "(", "string", ")", ":", "\n", "            ", "line", " ", "+=", " ", "\" \"", "\n", "        ", "else", ":", "\n", "            ", "line", " ", "+=", " ", "string", "[", "i", "]", "\n", "    ", "print", "(", "line", ")"], "maskedIndices": [64, 52, 50, 2, 82, 97, 37, 76, 54, 91, 17, 0, 25, 69, 41, 93, 87, 61, 23, 5, 34, 102, 96, 95, 21, 44, 46, 11, 45, 74, 67, 63, 27, 31, 88, 32, 4, 39, 57, 59, 77, 104, 33, 103, 22, 9, 13, 29, 18, 47, 75, 98, 14, 43, 20, 73, 84, 7, 80, 101, 19, 71, 24], "mask": [true, false, true, false, true, true, false, true, false, true, false, true, false, true, true, false, false, true, true, true, true, true, true, true, true, true, false, true, false, true, false, true, true, true, true, false, false, true, false, true, false, true, false, true, true, true, true, true, false, false, true, false, true, false, true, false, false, true, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, true, true, true, false, false, true, false, true, false, true, false, false, true, true, false, false, true, false, true, false, true, true, true, true, false, false, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "exercise"}, {"type": "non_function_exercise", "inputs": "<pre><code class=\"codehilite\"><span><span class=\"n\">strings</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"s1\">'abcqwe'</span><span class=\"p\">,</span> <span class=\"s1\">'def'</span><span class=\"p\">,</span> <span class=\"s1\">'ghiq'</span><span class=\"p\">]</span>\n</span></code></pre>"}]}, {"index": 7, "text": "<p>\u30cd\u30b9\u30c8\u3055\u308c\u305f\u30ea\u30b9\u30c8\u3068\u3001\u305d\u308c\u3092\u30cd\u30b9\u30c8\u3055\u308c\u305f\u30eb\u30fc\u30d7\u3068\u7d44\u307f\u5408\u308f\u305b\u308b\u65b9\u6cd5\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3057\u305f\u306d\uff01\n\u7d20\u6674\u3089\u3057\u3044\u3067\u3059\uff01\u3053\u308c\u3067\u3001\u3068\u3066\u3082\u5f37\u529b\u306a\u30d7\u30ed\u30b0\u30e9\u30df\u30f3\u30b0\u306e\u9053\u5177\u3092\u8eab\u306b\u3064\u3051\u307e\u3057\u305f\u3088\u3002</p>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}, "DefiningFunctions": {"slug": "DefiningFunctions", "title": "\u95a2\u6570\u306e\u5b9a\u7fa9", "index": 40, "step_names": ["define_greet", "how_are_you", "change_function_name", "change_parameter_name", "print_twice_exercise", "print_many", "swap_parameters", "final_text"], "steps": [{"index": 0, "text": "<p>\u3053\u308c\u307e\u3067 <code>print()</code> \u3084 <code>len()</code> \u3068\u3044\u3063\u305f\u95a2\u6570\u3092\u547c\u3073\u51fa\u3059\u65b9\u6cd5\u3092\u898b\u3066\u304d\u307e\u3057\u305f\u306d\u3002\u4eca\u5ea6\u306f\u3001\u81ea\u5206\u3084\u4ed6\u306e\u4eba\u304c\u4f7f\u3048\u308b\u72ec\u81ea\u306e\u95a2\u6570\u3092\u4f5c\u308b\uff08\u5b9a\u7fa9\u3059\u308b\uff09\u65b9\u6cd5\u3092\u5b66\u3073\u307e\u3059\u3002\u30d7\u30ed\u30b0\u30e9\u30e0\u304c\u5927\u304d\u304f\u8907\u96d1\u306b\u306a\u308b\u306b\u3064\u308c\u3066\u3001\u3053\u308c\u306f\u3068\u3066\u3082\u91cd\u8981\u306b\u306a\u3063\u3066\u304d\u307e\u3059\u3002</p>\n<p>\u3053\u3061\u3089\u306f\u7c21\u5358\u306a\u4f8b\u3067\u3059:</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">greet</span><span class=\"p\">(</span><span class=\"n\">name</span><span class=\"p\">):</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"Hello </span><span class=\"si\">{</span><span class=\"n\">name</span><span class=\"si\">}</span><span class=\"s2\">!\"</span><span class=\"p\">)</span>\n\n<span class=\"n\">greet</span><span class=\"p\">(</span><span class=\"s2\">\"Alice\"</span><span class=\"p\">)</span>\n<span class=\"n\">greet</span><span class=\"p\">(</span><span class=\"s2\">\"Bob\"</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\u3053\u308c\u306f\u30011\u3064\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\u3092\u53d7\u3051\u53d6\u308b <code>greet</code> \u3068\u3044\u3046\u540d\u524d\u306e\u95a2\u6570\u3092\u5b9a\u7fa9\u3057\u3066\u3044\u307e\u3059\u3002\u5b9a\u7fa9\u306e\u4e0b\u3067\u306f\u3001\u305d\u306e\u95a2\u6570\u30922\u56de\u547c\u3073\u51fa\u3057\u3066\u3044\u307e\u3059\u3002\n\u30b3\u30fc\u30c9\u3092\u5b9f\u884c\u3057\u3066\u3001\u3069\u3046\u306a\u308b\u304b\u898b\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "name": "define_greet", "hints": [], "solution": {"tokens": ["def", " ", "greet", "(", "name", ")", ":", "\n", "    ", "print", "(", "f\"", "Hello ", "{", "name", "}", "!", "\"", ")", "\n", "\n", "greet", "(", "\"Alice\"", ")", "\n", "greet", "(", "\"Bob\"", ")"], "maskedIndices": [12, 29, 15, 27, 3, 21, 13, 14, 2, 24, 17, 0, 16, 11, 28, 9, 22, 4, 10, 23, 6, 26, 5, 18], "mask": [true, false, true, true, true, true, true, false, false, true, true, true, true, true, true, true, true, true, true, false, false, true, true, true, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 1, "text": "<p>\u95a2\u6570\u306e\u5b9a\u7fa9\u306f\u8907\u5408\u6587\uff08compound statement\uff09\u3067\u3059\u3002<code>if</code> \u3084 <code>for</code> \u306e\u3088\u3046\u306b\u3001\u30d8\u30c3\u30c0\u30fc\u884c\u306e\u5f8c\u306b\u30a4\u30f3\u30c7\u30f3\u30c8\u3055\u308c\u305f\u672c\u4f53\uff08body\uff09\u304c\u7d9a\u304d\u3001\n\u305d\u3053\u306b\u306f1\u3064\u4ee5\u4e0a\u306e\u6587\u3092\u5165\u308c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002</p>\n<p>\u95a2\u6570\u306b\u5225\u306e\u6587\u3092\u8ffd\u52a0\u3057\u3066\u3001\u6b21\u306e\u3088\u3046\u306b\u306a\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044:</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">greet</span><span class=\"p\">(</span><span class=\"n\">name</span><span class=\"p\">):</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"Hello </span><span class=\"si\">{</span><span class=\"n\">name</span><span class=\"si\">}</span><span class=\"s2\">!\"</span><span class=\"p\">)</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s2\">\"How are you?\"</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\u305d\u306e\u5f8c\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u3082\u3046\u4e00\u5ea6\u5b9f\u884c\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "name": "how_are_you", "hints": [], "solution": {"tokens": ["def", " ", "greet", "(", "name", ")", ":", "\n", "    ", "print", "(", "f\"", "Hello ", "{", "name", "}", "!", "\"", ")", "\n", "    ", "print", "(", "\"How are you?\"", ")", "\n", "\n", "greet", "(", "\"Alice\"", ")", "\n", "greet", "(", "\"Bob\"", ")"], "maskedIndices": [28, 3, 6, 10, 24, 16, 23, 33, 21, 9, 0, 12, 22, 15, 18, 34, 4, 29, 2, 35, 13, 5, 14, 30, 32, 27, 17, 11], "mask": [true, false, true, true, true, true, true, false, false, true, true, true, true, true, true, true, true, true, true, false, false, true, true, true, true, false, false, true, true, true, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": ["Hello Alice!\nHow are you?\nHello Bob!\nHow are you?", "Hello Alice!\nHello Bob!\nHow are you?", "Hello Alice!\nHow are you?\nHello Bob!", "\u30a8\u30e9\u30fc"], "answer": "Hello Alice!\nHow are you?\nHello Bob!\nHow are you?"}, "requirements": [{"type": "verbatim"}, {"type": "custom", "message": "<p><code>print(f\"Hello {name}!\")</code> \u306e\u5f8c\u306b\u3001\u540c\u3058\u30a4\u30f3\u30c7\u30f3\u30c8\u3067 <code>print(\"How are you?\")</code> \u3092\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u5b9a\u7fa9\u306e\u5f8c\u306b\u3042\u308b <code>greet</code> \u306e2\u56de\u306e\u547c\u3073\u51fa\u3057\u306f\u305d\u306e\u307e\u307e\u306b\u3057\u3066\u304a\u3044\u3066\u304f\u3060\u3055\u3044\u3002</p>"}]}, {"index": 2, "text": "<p>\u30d7\u30ed\u30b0\u30e9\u30e0\u306e\u51fa\u529b\u304c\u3069\u3046\u5909\u308f\u3063\u305f\u304b\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002<code>How are you?</code> \u304c2\u56de\u8868\u793a\u3055\u308c\u3066\u3044\u307e\u3059\u306d\u3002\u3053\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u5168\u4f53\u306f\u3001\u6b21\u3068\u540c\u3058\u3053\u3068\u3092\u3057\u3066\u3044\u308b\u3068\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059:</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">name</span> <span class=\"o\">=</span> <span class=\"s2\">\"Alice\"</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"Hello </span><span class=\"si\">{</span><span class=\"n\">name</span><span class=\"si\">}</span><span class=\"s2\">!\"</span><span class=\"p\">)</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s2\">\"How are you?\"</span><span class=\"p\">)</span>\n\n<span class=\"n\">name</span> <span class=\"o\">=</span> <span class=\"s2\">\"Bob\"</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"Hello </span><span class=\"si\">{</span><span class=\"n\">name</span><span class=\"si\">}</span><span class=\"s2\">!\"</span><span class=\"p\">)</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s2\">\"How are you?\"</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\u3053\u3053\u306b\u95a2\u6570\u306e\u6700\u3082\u4fbf\u5229\u306a\u70b9\u306e\u4e00\u3064\u304c\u8868\u308c\u3066\u3044\u307e\u3059\u3002\u95a2\u6570\u3092\u4f7f\u3046\u3068\u540c\u3058\u30b3\u30fc\u30c9\u3092\u4f55\u5ea6\u3082\u7e70\u308a\u8fd4\u3057\u66f8\u304f\u3053\u3068\u306a\u304f\u3001\u518d\u5229\u7528\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u307e\u308b\u3067\u300c\u30d7\u30ed\u30b0\u30e9\u30e0\u306e\u4e2d\u306b\u5c0f\u3055\u306a\u30d7\u30ed\u30b0\u30e9\u30e0\u300d\u3092\u66f8\u3044\u3066\u3044\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002</p>\n<p>\u95a2\u6570\u5b9a\u7fa9\u306e\u30d8\u30c3\u30c0\u30fc\u884c\u306b\u306f\u3001\u5e38\u306b\u6b21\u306e\u30d1\u30fc\u30c4\u304c\u542b\u307e\u308c\u307e\u3059:</p>\n<ol>\n<li>\u7279\u5225\u306a\u30ad\u30fc\u30ef\u30fc\u30c9 <code>def</code> \u3068\u3001\u305d\u308c\u306b\u7d9a\u304f\u30b9\u30da\u30fc\u30b9\u3002</li>\n<li>\u95a2\u6570\u540d\u3002\u3053\u308c\u306f\u5909\u6570\u540d\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3001\u597d\u304d\u306a\u540d\u524d\u3092\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304c\u3001\u3044\u304f\u3064\u304b\u306e\u5236\u7d04\u304c\u3042\u308a\u307e\u3059\uff08\u4f8b\u3048\u3070\u3001\u30b9\u30da\u30fc\u30b9\u3092\u542b\u3081\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\uff09\u3002</li>\n<li>\u4e38\u62ec\u5f27\u306e\u30da\u30a2 <code>(</code> \u3068 <code>)</code></li>\n<li>\u62ec\u5f27\u306e\u9593\u306b\u5165\u308b0\u500b\u4ee5\u4e0a\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\uff08\u5f15\u6570\uff09\u540d\u3002\u8907\u6570\u3042\u308b\u5834\u5408\u306f\u30ab\u30f3\u30de\u3067\u533a\u5207\u308a\u307e\u3059\u3002\u3053\u3053\u3067\u306f <code>name</code> \u3068\u3044\u3046\u540d\u524d\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\u304c1\u3064\u3042\u308a\u307e\u3059\u3002</li>\n<li>\u30b3\u30ed\u30f3 <code>:</code></li>\n</ol>\n<p>\u7c21\u5358\u306a\u7df4\u7fd2\u3092\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u95a2\u6570\u540d\u3092 <code>greet</code> \u304b\u3089 <code>say_hello</code> \u306b\u5909\u66f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u30d7\u30ed\u30b0\u30e9\u30e0\u5168\u4f53\u304c\u524d\u3068\u540c\u3058\u3088\u3046\u306b\u52d5\u4f5c\u3059\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3001\u305d\u308c\u4ee5\u5916\u306e\u90e8\u5206\u306f\u5909\u66f4\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002</p>", "name": "change_function_name", "hints": ["<p>\u95a2\u6570\u5b9a\u7fa9\u306e\u30d8\u30c3\u30c0\u30fc\u306b\u3042\u308b\u540d\u524d\u3092\u5909\u66f4\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u305d\u308c\u3060\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002</p>", "<p>\u95a2\u6570\u5b9a\u7fa9\u306e\u30d8\u30c3\u30c0\u30fc\u306b\u3042\u308b\u540d\u524d\u3060\u3051\u3092\u5909\u66f4\u3059\u308b\u3068\u3001\u3069\u3046\u306a\u308b\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u30a8\u30e9\u30fc\u304c\u767a\u751f\u3057\u307e\u3059\u306d\u3002\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u898b\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u4f55\u3068\u66f8\u304b\u308c\u3066\u3044\u307e\u3059\u304b\uff1f\u30a8\u30e9\u30fc\u306f\u3069\u3053\u304b\u3089\u767a\u751f\u3057\u3066\u3044\u307e\u3059\u304b\uff1f</p>", "<p>\u95a2\u6570\u540d\u304c <code>say_hello</code> \u3060\u3068\u3057\u305f\u3089\u3001<code>greet(\"Alice\")</code> \u306f\u4f55\u3092\u610f\u5473\u3059\u308b\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u30d7\u30ed\u30b0\u30e9\u30e0\u306e\u4e2d\u3067\u5909\u66f4\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u306e\u306f\u3001\u3061\u3087\u3046\u30693\u884c\u3067\u3059\u3002</p>", "<p>\u5909\u66f4\u3059\u308b\u5404\u884c\u3067\u3001\u3061\u3087\u3046\u30691\u5358\u8a9e\u3060\u3051\u5909\u66f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u95a2\u6570\u306e\u672c\u4f53\uff08body\uff09\u306b\u306f\u624b\u3092\u52a0\u3048\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002<code>print(\"How are you?\")</code> \u306f\u305d\u306e\u307e\u307e\u6b8b\u3057\u3066\u304a\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>\u95a2\u6570\u3092\u5b9a\u7fa9\u3057\u305f\u5f8c\u3082\u3001\u5f15\u6570 <code>\"Alice\"</code> \u3068 <code>\"Bob\"</code> \u3092\u6e21\u3057\u3066\u95a2\u6570\u30922\u56de\u547c\u3073\u51fa\u3059\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"], "solution": {"tokens": ["def", " ", "say_hello", "(", "name", ")", ":", "\n", "    ", "print", "(", "f\"", "Hello ", "{", "name", "}", "!", "\"", ")", "\n", "    ", "print", "(", "\"How are you?\"", ")", "\n", "\n", "say_hello", "(", "\"Alice\"", ")", "\n", "say_hello", "(", "\"Bob\"", ")"], "maskedIndices": [11, 10, 13, 27, 2, 17, 32, 18, 30, 6, 23, 22, 16, 33, 29, 15, 3, 0, 9, 14, 5, 4, 24, 35, 34, 28, 12, 21], "mask": [true, false, true, true, true, true, true, false, false, true, true, true, true, true, true, true, true, true, true, false, false, true, true, true, true, false, false, true, true, true, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}]}, {"index": 3, "text": "<p>\u3044\u3044\u3067\u3059\u306d\uff01\u305d\u308c\u3067\u306f\u4f3c\u305f\u3088\u3046\u306a\u7df4\u7fd2\u3092\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u30d1\u30e9\u30e1\u30fc\u30bf\u540d\u3092 <code>name</code> \u304b\u3089 <code>person_name</code> \u306b\u5909\u66f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "name": "change_parameter_name", "hints": ["<p>\u95a2\u6570\u5b9a\u7fa9\u306e\u30d8\u30c3\u30c0\u30fc\u306b\u3042\u308b\u30d1\u30e9\u30e1\u30fc\u30bf\u540d\u3092\u5909\u66f4\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u305d\u308c\u3060\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002</p>", "<p>\u95a2\u6570\u5b9a\u7fa9\u306e\u30d8\u30c3\u30c0\u30fc\u306b\u3042\u308b\u30d1\u30e9\u30e1\u30fc\u30bf\u540d\u3060\u3051\u3092\u5909\u66f4\u3059\u308b\u3068\u3001\u3069\u3046\u306a\u308b\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u30a8\u30e9\u30fc\u304c\u767a\u751f\u3057\u307e\u3059\u306d\u3002\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u898b\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u4f55\u3068\u66f8\u304b\u308c\u3066\u3044\u307e\u3059\u304b\uff1f\u30a8\u30e9\u30fc\u306f\u3069\u3053\u304b\u3089\u767a\u751f\u3057\u3066\u3044\u307e\u3059\u304b\uff1f</p>", "<p>\u30d1\u30e9\u30e1\u30fc\u30bf\u540d\u304c <code>person_name</code> \u306e\u5834\u5408\u3001<code>print(f\"Hello {name}!\")</code> \u306f\u4f55\u3092\u610f\u5473\u3059\u308b\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u30d7\u30ed\u30b0\u30e9\u30e0\u306e\u4e2d\u3067\u5909\u66f4\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u306e\u306f\u3001\u3061\u3087\u3046\u30692\u884c\u3067\u3059\u3002</p>", "<p>\u5909\u66f4\u3059\u308b\u5404\u884c\u3067\u3001\u3061\u3087\u3046\u30691\u5358\u8a9e\u3060\u3051\u5909\u66f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u95a2\u6570\u5b9a\u7fa9\u3088\u308a\u5f8c\u306e\u90e8\u5206\u3001\u3064\u307e\u308a <code>say_hello(\"Alice\")</code> \u3068 <code>say_hello(\"Bob\")</code> \u306b\u306f\u624b\u3092\u52a0\u3048\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002</p>", "<p><code>print(\"How are you?\")</code> \u3092\u542b\u3081\u3001\u95a2\u6570\u306e\u672c\u4f53\u306b\u306f\u5f15\u304d\u7d9a\u304d2\u3064\u306e\u6587\u304c\u3042\u308b\u72b6\u614b\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>"], "solution": {"tokens": ["def", " ", "say_hello", "(", "person_name", ")", ":", "\n", "    ", "print", "(", "f\"", "Hello ", "{", "person_name", "}", "!", "\"", ")", "\n", "    ", "print", "(", "\"How are you?\"", ")", "\n", "\n", "say_hello", "(", "\"Alice\"", ")", "\n", "say_hello", "(", "\"Bob\"", ")"], "maskedIndices": [21, 33, 11, 30, 32, 15, 3, 34, 12, 9, 5, 24, 35, 22, 18, 17, 13, 28, 6, 4, 0, 2, 29, 10, 23, 16, 27, 14], "mask": [true, false, true, true, true, true, true, false, false, true, true, true, true, true, true, true, true, true, true, false, false, true, true, true, true, false, false, true, true, true, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}]}, {"index": 4, "text": "<p>\u3088\u304f\u3067\u304d\u307e\u3057\u305f\uff01</p>\n<p>\u4eca\u5ea6\u306f\u30011\u3064\u306e\u5f15\u6570 <code>x</code> \u3092\u53d7\u3051\u53d6\u308a\u3001\u305d\u306e\u5f15\u6570\u30922\u884c\u306b\u308f\u305f\u3063\u30662\u56de\u51fa\u529b\u3059\u308b\n<code>print_twice</code> \u3068\u3044\u3046\u540d\u524d\u306e\u72ec\u81ea\u306e\u95a2\u6570\u3092\u66f8\u3044\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>\n<p>\u4f8b\u3048\u3070\u3001<code>print_twice(\"Hello\")</code> \u306f\u6b21\u306e\u3088\u3046\u306b\u51fa\u529b\u3055\u308c\u308b\u306f\u305a\u3067\u3059:</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">Hello</span>\n<span class=\"n\">Hello</span>\n</span></code></pre>\n<p>\u95a2\u6570\u3092\u5b9a\u7fa9\u3057\u305f\u5f8c\u306b\u547c\u3073\u51fa\u3057\u3066\u30c6\u30b9\u30c8\u3057\u3066\u307f\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u304c\u3001\u5fc5\u9808\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002</p>", "name": "print_twice_exercise", "hints": ["<p>\u3053\u3053\u3067\u306f\u96e3\u3057\u3044\u554f\u984c\u89e3\u6c7a\u306f\u5fc5\u8981\u3042\u308a\u307e\u305b\u3093\u3002\u95a2\u6570\u3092\u5b9a\u7fa9\u3059\u308b\u624b\u9806\uff08\u30ec\u30b7\u30d4\uff09\u306b\u305d\u306e\u307e\u307e\u5f93\u3046\u3060\u3051\u3067\u3059\u3002</p>", "<p>\u4e0a\u3067\u6319\u3052\u305f\u95a2\u6570\u306e\u30d1\u30fc\u30c4\u304c\u3059\u3079\u3066\u63c3\u3063\u3066\u3044\u308b\u304b\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u305d\u308c\u306b\u306f <code>def</code>\u3001<code>()</code>\u3001\u305d\u3057\u3066 <code>:</code> \u304c\u542b\u307e\u308c\u307e\u3059\u3002</p>", "<p>\u95a2\u6570\u540d\u304c <code>print_twice</code> \u306b\u306a\u3063\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u62ec\u5f27 <code>()</code> \u306e\u9593\u3067 <code>x</code> \u3068\u3044\u3046\u540d\u524d\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\u30921\u3064\u53d7\u3051\u53d6\u3063\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u56f0\u3063\u305f\u3089\u3001\u4e0a\u3067\u5b9a\u7fa9\u3057\u305f\u4ed6\u306e\u95a2\u6570\u3092\u53c2\u8003\u306b\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u95a2\u6570\u672c\u4f53\u306e\u4e2d\u3067\u305d\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\u3092\u4f7f\u3044\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u672c\u4f53\u306e\u90e8\u5206\u304c\u30a4\u30f3\u30c7\u30f3\u30c8\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "<p>\u672c\u4f53\u306b\u306f2\u3064\u306e\u6587\u3001\u307e\u305f\u306f\u3054\u304f\u30b7\u30f3\u30d7\u30eb\u306a\u30eb\u30fc\u30d7\u304c\u5fc5\u8981\u3067\u3059\u3002</p>", "<p><code>print_twice</code> \u306e\u95a2\u6570\u672c\u4f53\u306e\u4e2d\u3067 <code>print_twice</code> \u3092\u547c\u3073\u51fa\u3057\u3066\u3057\u307e\u3063\u3066\u3044\u306a\u3044\u304b\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30a4\u30f3\u30c7\u30f3\u30c8\u3092\u30c1\u30a7\u30c3\u30af\u3057\u307e\u3057\u3087\u3046\u3002</p>"], "solution": {"tokens": ["def", " ", "print_twice", "(", "x", ")", ":", "\n", "    ", "print", "(", "x", ")", "\n", "    ", "print", "(", "x", ")"], "maskedIndices": [17, 18, 11, 16, 2, 5, 9, 6, 4, 0, 10, 15, 3, 12], "mask": [true, false, true, true, true, true, true, false, false, true, true, true, true, false, false, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "custom", "message": "<p>\u4e0a\u306e\u8aac\u660e\u306b\u5f93\u3063\u3066\u3001<code>print_twice</code> \u3068\u3044\u3046\u540d\u524d\u306e\u95a2\u6570\u3092\u5b9a\u7fa9\u3059\u308b\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u66f8\u3044\u3066\u304f\u3060\u3055\u3044\u3002</p>"}]}, {"index": 5, "text": "<p>\u95a2\u6570\u306b\u306f\u8907\u6570\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\u3092\u6301\u305f\u305b\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u4e0b\u306e\u4f8b\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044:</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">print_many</span><span class=\"p\">(</span><span class=\"n\">thing</span><span class=\"p\">,</span> <span class=\"n\">n</span><span class=\"p\">):</span>\n    <span class=\"k\">for</span> <span class=\"n\">_</span> <span class=\"ow\">in</span> <span class=\"nb\">range</span><span class=\"p\">(</span><span class=\"n\">n</span><span class=\"p\">):</span>\n        <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">thing</span><span class=\"p\">)</span>\n\n<span class=\"n\">print_many</span><span class=\"p\">(</span><span class=\"s2\">\"Hello\"</span><span class=\"p\">,</span> <span class=\"mi\">3</span><span class=\"p\">)</span>\n</span></code></pre>", "name": "print_many", "hints": [], "solution": {"tokens": ["def", " ", "print_many", "(", "thing", ",", " ", "n", ")", ":", "\n", "    ", "for", " ", "_", " ", "in", " ", "range", "(", "n", ")", ":", "\n", "        ", "print", "(", "thing", ")", "\n", "\n", "print_many", "(", "\"Hello\"", ",", " ", "3", ")"], "maskedIndices": [9, 33, 0, 32, 4, 7, 21, 26, 3, 22, 27, 2, 28, 5, 31, 12, 25, 19, 34, 18, 14, 20, 36, 37, 16, 8], "mask": [true, false, true, true, true, true, false, true, true, true, false, false, true, false, true, false, true, false, true, true, true, true, true, false, false, true, true, true, true, false, false, true, true, true, true, false, true, true], "lines": null}, "prediction": {"choices": ["3\n3\n3", "3", "Hello\nHello\nHello", "Hello", "H\ne\nl\nl\no", "\u30a8\u30e9\u30fc"], "answer": "Hello\nHello\nHello"}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 6, "text": "<p>\u95a2\u6570\u5b9a\u7fa9\u3067\u30d1\u30e9\u30e1\u30fc\u30bf\u3092\u533a\u5207\u308b\u30ab\u30f3\u30de\u3084\u3001\u95a2\u6570\u547c\u3073\u51fa\u3057\u3067\u5f15\u6570\u3092\u533a\u5207\u308b\u30ab\u30f3\u30de\u3001\n\u305d\u3057\u3066\u5b9a\u7fa9\u3068\u547c\u3073\u51fa\u3057\u306e\u5bfe\u5fdc\u95a2\u4fc2\u306b\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044:</p>\n<pre><code>def print_many(thing, n):\n                 ^    ^\n                 |    |\n  print_many(\"Hello\", 3)\n</code></pre>\n<p>\u3064\u307e\u308a\u3001<code>print_many(\"Hello\", 3)</code> \u3092\u547c\u3073\u51fa\u3059\u306e\u306f\u3001\u6b21\u3092\u5b9f\u884c\u3057\u3066\u3044\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059:</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">thing</span> <span class=\"o\">=</span> <span class=\"s2\">\"Hello\"</span>\n<span class=\"n\">n</span> <span class=\"o\">=</span> <span class=\"mi\">3</span>\n<span class=\"k\">for</span> <span class=\"n\">_</span> <span class=\"ow\">in</span> <span class=\"nb\">range</span><span class=\"p\">(</span><span class=\"n\">n</span><span class=\"p\">):</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">thing</span><span class=\"p\">)</span>\n</span></code></pre>\n<p>\u305d\u308c\u3067\u306f\u3001\u3082\u3046\u4e00\u3064\u7c21\u5358\u306a\u7df4\u7fd2\u3092\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u95a2\u6570\u5b9a\u7fa9\u306e\u30d8\u30c3\u30c0\u30fc\u306b\u3042\u308b\u30d1\u30e9\u30e1\u30fc\u30bf\u3092\u5165\u308c\u66ff\u3048\u3066\u3001\u6b21\u306e\u3088\u3046\u306b\u306a\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044:</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">def</span> <span class=\"nf\">print_many</span><span class=\"p\">(</span><span class=\"n\">n</span><span class=\"p\">,</span> <span class=\"n\">thing</span><span class=\"p\">):</span>\n</span></code></pre>\n<p>\u3053\u308c\u3060\u3051\u3092\u884c\u3063\u3066\u4ed6\u3092\u305d\u306e\u307e\u307e\u306b\u3057\u3066\u304a\u304f\u3068\u3001\u30a8\u30e9\u30fc\u304c\u767a\u751f\u3057\u307e\u3059\u3002\u524d\u3068\u540c\u3058\u3088\u3046\u306b\u52d5\u4f5c\u3059\u308b\u3088\u3046\u306b\u30d7\u30ed\u30b0\u30e9\u30e0\u306e\u6b8b\u308a\u306e\u90e8\u5206\u3092\u4fee\u6b63\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n<em>\u95a2\u6570\u306e\u672c\u4f53\u306f\u5909\u66f4\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044</em>\u3002</p>", "name": "swap_parameters", "hints": ["<p>\u95a2\u6570\u5b9a\u7fa9\u3078\u306e\u5909\u66f4\u306f\u3001\u6307\u793a\u3069\u304a\u308a\u306b\u30d1\u30e9\u30e1\u30fc\u30bf\u3092\u5165\u308c\u66ff\u3048\u308b\u3053\u3068\u3060\u3051\u3067\u3001\u4ed6\u306b\u306f\u4f55\u3082\