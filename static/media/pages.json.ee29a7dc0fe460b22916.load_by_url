51\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\n\u30b7\u30a7\u30eb\u3067\u6b21\u306e\u3088\u3046\u306b\u8a66\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"s1\">'Alice'</span> <span class=\"o\">==</span> <span class=\"s2\">\"Alice\"</span>\n</span></code></pre>", "name": "single_double_quotes_equal", "hints": [], "solution": {"tokens": ["'Alice'", " ", "==", " ", "\"Alice\""], "maskedIndices": [2, 0, 4], "mask": [true, false, true, false, true], "lines": null}, "prediction": {"choices": ["True", "False", "\u30a8\u30e9\u30fc"], "answer": "True"}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}, {"type": "custom", "message": "<p>\u30b7\u30a7\u30eb\u306e <strong><code>&gt;&gt;&gt;</code> \u306e\u5f8c\u308d\u306b</strong>\u76f4\u63a5\u30b3\u30fc\u30c9\u3092\u5165\u529b\u3057\u3066\u3001Enter \u30ad\u30fc\u3092\u62bc\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b7\u30a7\u30eb\u306e\u4e0a\u306b\u3042\u308b\u30a8\u30c7\u30a3\u30bf\u306b\u306f\u5165\u529b\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u307e\u305f\u3001\u4e0a\u90e8\u306b\u3042\u308b\u300cRun\u300d\u306a\u3069\u306e\u30dc\u30bf\u30f3\u306f\u62bc\u3055\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u306d\u3002</p>"}]}, {"index": 3, "text": "<p>\u898b\u3066\u308f\u304b\u308b\u3068\u304a\u308a\u3001Python\u306f\u30b7\u30f3\u30b0\u30eb\u30af\u30a9\u30fc\u30c8\u3067\u5b9a\u7fa9\u3055\u308c\u305f\u6587\u5b57\u5217\u3082\u3001\u30c0\u30d6\u30eb\u30af\u30a9\u30fc\u30c8\u3067\u5b9a\u7fa9\u3055\u308c\u305f\u6587\u5b57\u5217\u3082\u3001\u307e\u3063\u305f\u304f\u540c\u3058\u3082\u306e\u3068\u3057\u3066\u6271\u3044\u307e\u3059\u3002</p>\n<p>\u305d\u308c\u3067\u306f\u3001\u300cZen of Python\uff08Python\u306e\u7985\uff09\u300d\u304b\u3089\u6b21\u306e\u30c6\u30ad\u30b9\u30c8\u3092\u51fa\u529b\u3059\u308b\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u66f8\u3044\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\" copyable\">Special cases aren't special enough to break the rules.\n<button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p>\u30d7\u30ed\u30b0\u30e9\u30e0\u306f\u5909\u6570\u3092\u4f7f\u308f\u305a\u3001<code>print()</code> \u3092\u4f7f\u3063\u305f1\u884c\u3060\u3051\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u306d\u3002</p>", "name": "double_quote_exercise", "hints": ["<p>\u6587\u5b57\u5217\u3092\u3069\u306e\u3088\u3046\u306b\u5b9a\u7fa9\u3059\u308c\u3070\u3088\u3044\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u30b7\u30f3\u30b0\u30eb\u30af\u30a9\u30fc\u30c8\u3092\u4f7f\u3044\u307e\u3059\u304b\uff1f \u305d\u308c\u3068\u3082\u30c0\u30d6\u30eb\u30af\u30a9\u30fc\u30c8\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "<p>\u6587\u5b57\u5217\u306f1\u3064\u3060\u3051\u3067\u5927\u4e08\u592b\u3067\u3059\u3088\u3002</p>", "<p>\u6587\u5b57\u5217\u540c\u58eb\u3092\u9023\u7d50\u3059\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u3002</p>"], "solution": {"tokens": ["print", "(", "\"Special cases aren't special enough to break the rules.\"", ")"], "maskedIndices": [0, 2, 1, 3], "mask": [true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}]}, {"index": 4, "text": "<p>\u3059\u3070\u3089\u3057\u3044\u3067\u3059\u306d\uff01</p>\n<p>\u4eca\u5ea6\u306f\u3001\u6b21\u306e\u540d\u8a00\u3092\uff08\u30c0\u30d6\u30eb\u30af\u30a9\u30fc\u30c8\u3082\u542b\u3081\u3066\uff09\u305d\u3063\u304f\u308a\u305d\u306e\u307e\u307e\u51fa\u529b\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\" copyable\">\"Talk is cheap. Show me the code.\" - Linus Torvalds\n<button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p>\u30d7\u30ed\u30b0\u30e9\u30e0\u306f\u5909\u6570\u3092\u4f7f\u308f\u305a\u3001<code>print()</code> \u3092\u4f7f\u3063\u305f1\u884c\u3060\u3051\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u306d\u3002</p>", "name": "single_quote_exercise", "hints": ["<p>\u30b7\