orld\n-----\n</code></pre>\n<p><code>name</code> \u306e1\u6587\u5b57\u306b\u3064\u304d1\u3064\u306e <code>-</code> \u304c\u4e26\u3076\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>", "name": "name_underlined", "hints": ["<p>\u30d2\u30f3\u30c8\u3068\u3057\u3066\u3001\u4e09\u89d2\u5f62\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u601d\u3044\u51fa\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "<p>1\u6587\u5b57\u3054\u3068\u306b <code>name</code> \u30921\u56de\u51fa\u529b\u3057\u305f\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u30d2\u30f3\u30c8\u306b\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>", "<p>\u30c0\u30c3\u30b7\u30e5\uff08<code>-</code>\uff09\u306e\u6587\u5b57\u5217\u30921\u6587\u5b57\u305a\u3064\u7d44\u307f\u7acb\u3066\u3066\u3044\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002</p>", "<p>for \u30eb\u30fc\u30d7\u306f <code>char</code> \u306e\u3088\u3046\u306a\u5909\u6570\u3092\u4f5c\u308a\u307e\u3059\u304c\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u5185\u3067\u306f\u305d\u306e\u5909\u6570\u3092\u4f7f\u3046\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u3002</p>"], "solution": {"tokens": ["line", " ", "=", " ", "''", "\n", "for", " ", "_", " ", "in", " ", "name", ":", "\n", "    ", "line", " ", "+=", " ", "'-'", "\n", "print", "(", "name", ")", "\n", "print", "(", "line", ")"], "maskedIndices": [10, 28, 24, 8, 16, 20, 30, 4, 2, 6, 23, 27, 0, 22, 18, 29, 25, 12, 13], "mask": [true, false, true, false, true, false, true, false, true, false, true, false, true, true, false, false, true, false, true, false, true, false, true, true, true, true, false, true, true, true, true], "lines": [{"id": "3", "content": "<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">name</span><span class=\"p\">)</span>"}, {"id": "0", "content": "<span class=\"n\">line</span> <span class=\"o\">=</span> <span class=\"s1\">&#39;&#39;</span>"}, {"id": "4", "content": "<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">line</