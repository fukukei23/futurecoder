e\u306e\u30b1\u30fc\u30b9\u3067\u306f\u30012\u3064\u306e\u5909\u6570\u304c\u3069\u3061\u3089\u30821\u3064\u306e\u30ea\u30b9\u30c8\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u77e2\u5370\u3067\u6307\u3057\u793a\u3057\u3066\u3044\u307e\u3059\u3002</p>\n<p><code>list2 = list1</code> \u306f\u5909\u6570\u540c\u58eb\u306e\u9593\u306b\u6c38\u9060\u306e\u3064\u306a\u304c\u308a\u3092\u4f5c\u308b\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u3082\u3057<em>\u3069\u3061\u3089\u304b</em>\u306e\u5909\u6570\u306b\n\u65b0\u3057\u3044\u5024\uff08\u4f8b\u3048\u3070 <code>list1 = [7, 8, 9]</code>\uff09\u3092\u4ee3\u5165\u3057\u305f\u5834\u5408\u3001\u3082\u3046\u4e00\u65b9\u306e\u5909\u6570\u306f\u5f71\u97ff\u3092\u53d7\u3051\u305a\u3001\n\u5143\u306e\u30ea\u30b9\u30c8\u3092\u6307\u3057\u305f\u307e\u307e\u306b\u306a\u308a\u307e\u3059\u3002</p>\n<p>\u57fa\u672c\u7684\u306b\u3001\u6b21\u306e\u3088\u3046\u306a\u4ee3\u5165\u306f\uff1a</p>\n<pre><code>list2 = &lt;expression&gt;\n</code></pre>\n<p>\u300c\u5909\u6570 <code>list2</code> \u306b\u3001<code>&lt;expression&gt;</code> \u3092\u8a55\u4fa1\u3057\u305f\u7d50\u679c\u306e\u5024\u3092\u53c2\u7167\u3055\u305b\u308b\u300d\u3068\u3044\u3046\u610f\u5473\u306b\u306a\u308a\u307e\u3059\u3002\n\u305d\u306e\u5024\u306e\u30b3\u30d4\u30fc\u3092\u4f5c\u308b\u308f\u3051\u3067\u306f\u306a\u3044\u305f\u3081\u3001\u7d50\u679c\u3068\u3057\u3066\u4e21\u65b9\u306e\u5909\u6570\u304c\u540c\u3058\u30ea\u30b9\u30c8\u3092\u6307\u3059\u3053\u3068\u306b\u306a\u308b\u308f\u3051\u3067\u3059\u3002\n\u305f\u3060\u3057\u524d\u306b\u5b66\u3093\u3060\u3088\u3046\u306b\u3001<code>list2</code> \u306f <code>&lt;expression&gt;</code> \u3068\u3044\u3046\u5f0f\u81ea\u4f53\u3092\u899a\u3048\u3066\u3044\u308b\u308f\u3051\u3067\u306f\u306a\u304f\u3001\u5024\u3060\u3051\u3092\u899a\u3048\u3066\u3044\u307e\u3059\u3002\n\u4ed6\u306e\u5909\u6570\u306e\u3053\u3068\u307e\u3067\u306f\u95a2\u77e5\u3057\u307e\u305b\u3093\u3002</p>\n<p><code>copy</code> \u30e1\u30bd\u30c3\u30c9\u3092\u4f7f\u3048\u3070\u30ea\u30b9\u30c8\u3092\u30b3\u30d4\u30fc\u3067\u304d\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">list2</span> <span class=\"o\">=</span> <span class=\"n\">list1</span><span class=\"o\">.</span><span class=\"n\">copy</span><span class=\"p\">()</span>\n</span></code></pre>\n<p>\u3053\u3046\u3059\u308b\u3068\u3001\u30d7\u30ed\u30b0\u30e9\u30e0\u306f\u518d\u3073\u6700\u521d\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3068\u540c\u3058\u3088\u3046\u306b\u52d5\u4f5c\u3057\u307e\u3059\u3002</p>\n<p>\u3082\u3057\u3053\u306e\u3088\u3046\u306a\u554f\u984c\u306b\u76f4\u9762\u3057\u3066\u307e\u3060\u7406\u89e3\u304c\u96e3\u3057\u3044\u3068\u611f\u3058\u305f\u3089\u3001\u30a8\u30c3\u30bb\u30a4 <a href=\"https://nedbatchelder.com/text/names.html\">Facts and myths about Python names and values</a> \u3092\u8aad\u3093\u3067\u307f\u3066\u304f\u3060\u3055\u3044\u306d\u3002</p>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}, "ModifyingWhileIterating": {"slug": "ModifyingWhileIterating", "title": "\u30eb\u30fc\u30d7\u51e6\u7406\u4e2d\u306e\u30ea\u30b9\u30c8\u306e\u5909\u66f4", "index": 33, "step_names": ["run_broken_with_python_tutor", "remove_instead_of_pop", "make_copy", "make_copy2", "make_new_list", "final_text"], "steps": [{"index": 0, "text": "<p>\u3053\u306e\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u898b\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u6570\u5b57\u306e\u30ea\u30b9\u30c8\u3092\u30eb\u30fc\u30d7\u51e6\u7406\u3057\u3066\u300110\u3088\u308a\u5c0f\u3055\u3044\u6570\u5b57\u3092\u524a\u9664\u3057\u3088\u3046\u3068\u3057\u3066\u3044\u307e\u3059\u3002\u5c11\u306a\u304f\u3068\u3082\u3001\u305d\u306e\u3064\u3082\u308a\u3067\u66f8\u304b\u308c\u3066\u3044\u307e\u3059\u3002\nPython Tutor \u3067\u5b9f\u884c\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"n\">numbers</span> <span class=\"o\">=</span> <span class=\"p\">[</span><span class=\"mi\">10</span><span class=\"p\">,</span> <span class=\"mi\">7</span><span class=\"p\">,</span> <span class=\"mi\">8</span><span class=\"p\">,</span> <span class=\"mi\">3</span><span class=\"p\">,</span> <span class=\"mi\">12</span><span class=\"p\">,</span> <span class=\"mi\">15</span><span class=\"p\">]</span>\n<span class=\"k\">for</span> <span class=\"n\">i</span> <span class=\"ow\">in</span> <span class=\"nb\">range</span><span class=\"p\">(</span><span class=\"nb\">len</span><span class=\"p\">(</span><span class=\"n\">numbers</span><span class=\"p\">)):</span>\n    <span class=\"n\">number</span> <span class=\"o\">=</span> <span class=\"n\">numbers</span><span class=\"p\">[</span><span class=\"n\">i</span><span class=\"p\">]</span>\n    <span class=\"k\">if</span> <span class=\"n\">number</span> <span class=\"o\">&lt;=</span> <span class=\"mi\">10</span><span class=\"p\">:</span>\n        <span class=\"n\">numbers</span><span class=\"o\">.</span><span class=\"n\">pop</span><span class=\"p\">(</span><span class=\"n\">i</span><span class=\"p\">)</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">numbers</span><span class=\"p\">)</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>\n<p>\uff08<code>numbers.pop(i)</code> \u306f\u3001<code>numbers</code> \u306e\u30a4\u30f3\u30c7\u30c3\u30af\u30b9 <code>i</code> \u306b\u3042\u308b\u8981\u7d20\u3092\u524a\u9664\u3059\u308b\u3053\u3068\u3092\u601d\u3044\u51fa\u3057\u3066\u304f\u3060\u3055\u3044\u306d\uff09</p>", "name": "run_broken_with_python_tutor", "hints": [], "solution": {"tokens": ["numbers", " ", "=", " ", "[", "10", ",", " ", "7", ",", " ", "8", ",", " ", "3", ",", " ", "12", ",", " ", "15", "]", "\n", "for", " ", "i", " ", "in", " ", "range", "(", "len", "(", "numbers", ")", ")", ":", "\n", "    ", "number", " ", "=", " ", "numbers", "[", "i", "]", "\n", "    ", "if", " ", "nu