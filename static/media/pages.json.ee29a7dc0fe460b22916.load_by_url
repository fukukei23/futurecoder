\u63a5\u5909\u66f4\u3059\u308b</em> \u30e1\u30bd\u30c3\u30c9\uff08<code>append</code>\u3001<code>insert</code>\u3001<code>remove</code> \u306a\u3069\uff09\u306e\u591a\u304f\u306f\u5358\u306b <code>None</code> \u3092\u8fd4\u3059\u306e\u306b\u5bfe\u3057\u3001\n\u305d\u308c\u4ee5\u5916\u306e\u95a2\u6570\u3084\u30e1\u30bd\u30c3\u30c9\u306f\u5143\u306e\u5f15\u6570\u3092\u5909\u66f4\u305b\u305a\u306b\u3001\u65b0\u3057\u3044\u4fbf\u5229\u306a\u5024\u3092\u8fd4\u3057\u3066\u304f\u308c\u308b\u3068\u3044\u3046\u3053\u3068\u3067\u3059\u3002\n\u552f\u4e00\u306e\u4f8b\u5916\u306f <code>pop</code> \u30e1\u30bd\u30c3\u30c9\u3067\u3059\u3002</p>\n<p>\u5024\u3092\u76f4\u63a5\u5909\u66f4\u3059\u308b\u3053\u3068\u3092 <em>\u30df\u30e5\u30fc\u30c6\u30fc\u30b7\u30e7\u30f3\uff08\u5909\u66f4\uff09</em> \u3068\u547c\u3073\u3001\u5909\u66f4\u3067\u304d\u308b\u5024\u306e\u578b\u3092 <em>\u30df\u30e5\u30fc\u30bf\u30d6\u30eb\uff08mutable: \u5909\u66f4\u53ef\u80fd\uff09</em>\u3001\n\u5909\u66f4\u3067\u304d\u306a\u3044\u3082\u306e\u3092 <em>\u30a4\u30df\u30e5\u30fc\u30bf\u30d6\u30eb\uff08immutable: \u5909\u66f4\u4e0d\u53ef\uff09</em> \u3068\u547c\u3073\u307e\u3059\u3002\u30ea\u30b9\u30c8\u306f\u30df\u30e5\u30fc\u30bf\u30d6\u30eb\u3067\u3059\u3002\n\u4e00\u65b9\u3001\u6587\u5b57\u5217\u306f\u30a4\u30df\u30e5\u30fc\u30bf\u30d6\u30eb\u306a\u306e\u3067\u3001<code>append</code> \u306e\u3088\u3046\u306a\u30e1\u30bd\u30c3\u30c9\u306f\u3042\u308a\u307e\u305b\u3093\u3057\u3001\u6dfb\u5b57\uff08\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\uff09\u3092\u4f7f\u3063\u3066\u4e2d\u8eab\u3092\u66f8\u304d\u63db\u3048\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u305b\u3093\u3002\n\u5b9f\u969b\u306b\u8a66\u3057\u3066\u78ba\u304b\u3081\u3066\u307f\u307e\u3057\u3087\u3046\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"s1\">'Python'</span><span class=\"o\">.</span><span class=\"n\">append</span><span class=\"p\">(</span><span class=\"s1\">' is cool!'</span><span class=\"p\">)</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>", "name": "mutation_string_append", "hints": [], "solution": {"tokens": ["'Python'", ".", "append", "(", "' is cool!'", ")"], "maskedIndices": [4, 2, 5, 0, 3, 1], "mask": [true, true, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 3, "text": "<p>\u6587\u5b57\u5217\u306f\u4e00\u5ea6\u4f5c\u3063\u305f\u3089\u4e2d\u8eab\u3092\u76f4\u63a5\u5909\u66f4\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002\u65b0\u3057\u3044\u6587\u5b57\u5217\u3092\u4f5c\u3063\u3066\u3001\u305d\u308c\u3092\u4ee3\u308f\u308a\u306b\u4f7f\u3046\u3053\u3068\u3057\u304b\u3067\u304d\u306a\u3044\u306e\u3067\u3059\u3002\n\u3064\u307e\u308a\u3001\u6b21\u306e\u3088\u3046\u306b\u5358\u72ec\u3067\u66f8\u3044\u3066\u3082\u610f\u5473\u304c\u3042\u308a\u307e\u305b\u3093\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">word</span><span class=\"o\">.</span><span class=\"n\">lower</span><span class=\"p\">()</span>\n</span></code></pre>\n<p><code>word</code> \u304c\u6307\u3057\u3066\u3044\u308b\u6587\u5b57\u5217\u81ea\u4f53\u306f\u5909\u66f4\u3055\u308c\u305a\u3001<code>word.lower()</code> \u304c\u8fd4\u3057\u305f\u65b0\u3057\u3044\u6587\u5b57\u5217\u306f\u3059\u3050\u306b\u6368\u3066\u3089\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002\n<code>word</code> \u304c\u6307\u3059\u5024\u3092\u5909\u66f4\u3057\u305f\u3044\u5834\u5408\u306f\u3001\u5909\u6570\u306b\u65b0\u3057\u3044\u5024\u3092\u4ee3\u5165\u3057\u76f4\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\uff1a</p>\n<pre><code class=\"codehilite copyable\"><span><span class=\"n\">sentence</span> <span class=\"o\">=</span> <span class=\"s2\">\"Python rocks!\"</span>\n<span class=\"n\">new_sentence</span> <span class=\"o\">=</span> <span class=\"n\">sentence</span><span class=\"o\">.</span><span class=\"n\">upper</span><span class=\"p\">()</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">sentence</span><span class=\"p\">)</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">new_sentence</span><span class=\"p\">)</span>\n</span><button class=\"btn btn-primary copy-button\">\u30b3\u30d4\u30fc</button></code></pre>", "name": "string_lower_upper", "hints": [], "solution": {"tokens": ["sentence", " ", "=", " ", "\"Python rocks!\"", "\n", "new_sentence", " ", "=", " ", "sentence", ".", "upper", "(", ")", "\n", "print", "(", "sentence", ")", "\n", "print", "(", "new_sentence", ")"], "maskedIndices": [17, 14, 4, 23, 12, 18, 0, 10, 22, 2, 21, 24, 13, 11, 6, 16, 8, 19], "mask": [true, false, true, false, true, false, true, false, true, false, true, true, true, true, true, false, true, true, true, true, false, true, true, true, true], "lines": null}, "prediction": {"choices": null, "answer": null}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 4, "text": "<p><code>sentence.upper()</code> \u3092\u5b9f\u884c\u3057\u3066\u3082\u3001\u5143\u306e <code>sentence</code> \u306e\u5185\u5bb9\u306f\u5909\u308f\u3063\u3066\u3044\u306a\u3044\u3053\u3068\u306b\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002</p>\n<p><code>word.lower()</code> \u306f\u3001\u4ee5\u4e0b\u306e\u3088\u3046\u306b\u5927\u304d\u306a\u5f0f\u306e\u4e2d\u3067\u76f4\u63a5\u4f7f\u3046\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3088\u3002</p>\n<pre><code class=\"codehilite\"><span><span class=\"k\">if</span> <span class=\"n\">word</span><span class=\"o\">.</span><span class=\"n\">lower</span><span class=\"p\">()</span> <span class=\"o\">==</span> <span class=\"s1\">'yes'</span><span class=\"p\">:</span>\n</span></code></pre>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}, "HowToFindInformationWithGoogleAndMore": {"slug": "HowToFindInformationWithGoogleAndMore", "title": "Google\u306a\u3069\u3092\u4f7f\u3063\u305f\u60c5\u5831\u306e\u8abf\u3079\u65b9", "index": 30, "step_names": ["sum_list", "list_insert", "dir_list", "final_text"], "steps": [{"index": 0, "text": "<p>\u3053\u308c\u307e\u3067\u7d39\u4ecb\u3057\u3066\u304d\u305f\u95a2\u6570\u3092\u77e5\u3063\u3066\u304a\u304f\u306e\u306f\u4fbf\u5229\u3067\u3059\u304c\u3001\u3059\u3079\u3066\u3092\u899a\u3048\u308b\u306e\u306f\u5927\u5909\u3067\u3059\u3057\u3001\u95a2\u6570\u306f\u307e\u3060\u307e\u3060\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u3082\u3063\u3068\u91cd\u8981\u306a\u30b9\u30ad\u30eb\u306f\u300c\u81ea\u5206\u3067\u8abf\u3079\u308b\u529b\u300d\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u4e0a\u306e\u95a2\u6570\u306e\u540d\u524d\u3092\u5fd8\u308c\u3066\u3057\u307e\u3063\u305f\u3068\u304d\u306b\u3001Google\u3067\u691c\u7d22\u3059\u308b\u5178\u578b\u7684\u306a\u691c\u7d22\u30d5\u30ec\u30fc\u30ba\u306e\u4f8b\u3092\u6319\u3052\u3066\u307f\u307e\u3059\uff1a</p>\n<ul>\n<li><code>append</code><ul>\n<li>python add element to list</li>\n<li>python add item at end of list</li>\n</ul>\n</li>\n<li><code>len</code><ul>\n<li>python size of list</li>\n<li>python number of elements in list</li>\n<li>python how many characters in string</li>\n</ul>\n</li>\n<li><code>sum</code><ul>\n<li>python add list of numbers</li>\n<li>python total of numbers</li>\n</ul>\n</li>\n<li><code>in</code><ul>\n<li>python check if list contains value</li>\n<li>python test if list has element</li>\n</ul>\n</li>\n<li><code>index</code><ul>\n<li>python get position of element</li>\n<li>python get index of value</li>\n</ul>\n</li>\n</ul>\n<p>\u3067\u306f\u3001\u3053\u306e\u300c\u8abf\u3079\u308b\u30b9\u30ad\u30eb\u300d\u3092\u7df4\u7fd2\u3057\u3066\u307f\u307e\u3057\u3087\u3046\uff01\u30ea\u30b9\u30c8\u306e\u4e2d\u3067\u4ed6\u306e\u3069\u306e\u5024\u3088\u308a\u3082\u5927\u304d\u3044\u5024\u3092\u8fd4\u3059\u95a2\u6570\uff0f\u30e1\u30bd\u30c3\u30c9\u3092\u63a2\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\