067\u3059\u304c\u3001\u30af\u30a9\u30fc\u30c8\u306e\u306a\u3044 <code>sunshine</code> \u306f\u3069\u3046\u306a\u308b\u3067\u3057\u3087\u3046\u304b\uff1f</p>", "name": "sunshine_undefined_check", "hints": [], "solution": {"tokens": ["sunshine"], "maskedIndices": [0], "mask": [true], "lines": null}, "prediction": {"choices": ["sunshine", "'sunshine'", "Hello", "'Hello'", "\u30a8\u30e9\u30fc"], "answer": "\u30a8\u30e9\u30fc"}, "requirements": [{"type": "verbatim"}, {"type": "program_in_text"}]}, {"index": 4, "text": "<p>\u6b63\u89e3\u306f\u3001<code>sunshine</code> \u306f\u5909\u6570\u306b\u898b\u3048\u308b\u305f\u3081\u3001Python\u306f\u305d\u306e\u5024\u3092\u63a2\u305d\u3046\u3068\u3057\u307e\u3059\u304c\u3001\u305d\u306e\u540d\u524d\u306e\u5909\u6570\u3092\u5b9a\u7fa9\u3057\u3066\u3044\u306a\u3044\u306e\u3067\u30a8\u30e9\u30fc\u306b\u306a\u3063\u3066\u3057\u307e\u3046\u3001\u3068\u3044\u3046\u3053\u3068\u3067\u3059\u3002</p>", "name": "final_text", "hints": [], "solution": null, "prediction": {"choices": null, "answer": null}, "requirements": null}]}, "UsingVariables": {"slug": "UsingVariables", "title": "\u5909\u6570\u3068 <code>print()</code> \u3092\u4f7f\u3063\u3066\u307f\u3088\u3046", "index": 5, "step_names": ["name_assign", "hello_plus_name", "word_plus_name", "word_plus_name_with_space", "word_assign_goodbye", "goodbye_plus_name", "first_print", "final_text"], "steps": [{"index": 0, "text": "<p>\u524d\u306e\u30ec\u30c3\u30b9\u30f3\u3067\u306f\u3001\u6b21\u306e\u30b3\u30fc\u30c9\u3067\u5024\u304c <code>'Hello'</code> \u306e <code>word</code> \u3068\u3044\u3046\u5909\u6570\u3092\u4f5c\u308a\u307e\u3057\u305f\uff1a</p>\n<pre><code class=\"codehilite\"><span><span class=\"n\">word</span> <span class=\"o\">=</span> <span class=\"s1\">'Hello'</span>\n</span></code></pre>\n<p>\u4eca\u5ea6\u306f\u3001\u5225\u306e\u6587\u5b57\u5217\u3092\u5024\u306b\u6301\u3064 <code>your_name</code> \u3068\u3044\u3046\u5909\u6570\u3092\u4f5c\u3063\u3066\u307f\u307e\u3057\u3087\u3046